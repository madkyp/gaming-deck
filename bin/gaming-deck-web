#!/usr/bin/env python3
# gaming-deck-web — a small tabbed browser drawn on the Wayland overlay layer,
# above the game, for guides (EliteGuías, Fextralife, Map Genie, Steam guides, a
# translated wiki page): the sites are shown as they are, like in any browser,
# nothing is copied. Like the in-game panel it never touches the game's process.
#
# One process holds every page opened while playing, each in its own tab, so
# they stay where they were. `gaming-deck web …` talks to it:
#   gaming-deck-web --lang es|en --request '<json>'      start it with a first request
#   requests (JSON, through <pidfile>.ctl + SIGUSR2):
#     {"cmd":"open","slot":"EliteGuías · guía","url":"https://…","fallback":"https://…","reuse":true}
#        reuse: an open tab for that slot is shown as it is instead of reloaded
#     {"cmd":"show","slot":"…"}   {"cmd":"hide"}   {"cmd":"close"}
#   SIGUSR1: hide / show as it was (the panel's key)
# Esc hides it and brings the panel back; ✕ closes the tab (the last one ends it).
# State for the deck: <pidfile>.state = {"visible", "current", "slots":[{slot,title,url}]}.
import json
import os
import signal
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, WebKit2  # noqa: E402

ES = {"Open in browser": "Abrir en el navegador", "Close this tab": "Cerrar esta pestaña",
      "Back": "Atrás", "Forward": "Adelante", "Reload": "Recargar", "Loading…": "Cargando…",
      "Back to the panel (Esc)": "Volver al panel (Esc)", "Start page of this tab": "Página inicial de esta pestaña", "Panel": "Panel"}

CSS = b"""
window { background-color: rgba(7, 8, 13, 0.98); border: 1px solid #1f2638; border-radius: 14px; }
#bar, #tabs { padding: 6px 10px 0 10px; background-color: transparent; }
#bar { padding-bottom: 8px; }
button { background: #11141f; color: #e2e8f0; border: 1px solid #1f2638; border-radius: 6px;
         padding: 2px 10px; min-height: 24px; box-shadow: none; text-shadow: none; background-image: none; }
button:hover { background: #172036; border-color: #5eead4; }
#tab { color: #7c8aa0; font-size: 11px; }
#tabon { color: #07080d; background: #5eead4; border-color: #5eead4; font-size: 11px; font-weight: bold; }
#title { color: #e2e8f0; font-weight: bold; }
#host { color: #7c8aa0; font-family: monospace; font-size: 10px; }
#close:hover { border-color: #fb7185; color: #fb7185; }
"""


def main():
    args = sys.argv[1:]
    lang, first = "en", None
    if "--lang" in args:
        i = args.index("--lang")
        lang = args[i + 1] if i + 1 < len(args) else "en"
    if "--request" in args:
        i = args.index("--request")
        try:
            first = json.loads(args[i + 1])
        except (IndexError, ValueError):
            first = None
    if not first or first.get("cmd") != "open" or not str(first.get("url", "")).startswith("https://"):
        print("use: gaming-deck-web --lang es|en --request '{\"cmd\":\"open\",\"slot\":…,\"url\":\"https://…\"}'", file=sys.stderr)
        return 2
    tr = (lambda s: ES.get(s, s)) if lang == "es" else (lambda s: s)
    deck = os.environ.get("CD_WEB_BIN") or os.path.expanduser("~/.local/bin/gaming-deck")
    env = {k: v for k, v in os.environ.items() if k not in ("LD_LIBRARY_PATH", "LD_PRELOAD")}

    run = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    pidf = os.environ.get("GAMING_DECK_WEB_PID") or os.path.join(run, "gaming-deck-web.pid")
    base = pidf[:-4] if pidf.endswith(".pid") else pidf
    statef, ctlf = base + ".state", base + ".ctl"
    try:                                  # an older one (shouldn't be): this one takes over
        old = int(open(pidf).read().strip())
        if old != os.getpid():
            os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    open(pidf, "w").write(str(os.getpid()))

    data = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "gaming-deck", "web")
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "gaming-deck", "web")
    os.makedirs(data, exist_ok=True)
    manager = WebKit2.WebsiteDataManager(base_data_directory=data, base_cache_directory=cache)
    ctx = WebKit2.WebContext.new_with_website_data_manager(manager)
    # cookies kept: a site's cookie/consent choice is asked only once
    ctx.get_cookie_manager().set_persistent_storage(os.path.join(data, "cookies.sqlite"),
                                                    WebKit2.CookiePersistentStorage.SQLITE)

    win = Gtk.Window()
    settings = Gtk.Settings.get_default()
    if settings:
        settings.set_property("gtk-application-prefer-dark-theme", True)
    prov = Gtk.CssProvider()
    prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_namespace(win, "gaming-deck-web")
    for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.RIGHT):
        GtkLayerShell.set_anchor(win, edge, True)
        GtkLayerShell.set_margin(win, edge, 28)
    GtkLayerShell.set_exclusive_zone(win, -1)

    # exclusive only to take the keyboard when it shows (Esc works at once, even if
    # the game holds the pointer), then on demand: a click on another window gives
    # it the keyboard (exclusive locked every other window out while this was open)
    def grab():
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        GLib.timeout_add(500, lambda: GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.ON_DEMAND) and False)

    mon = Gdk.Display.get_default().get_monitor(0)
    try:
        _, x, y = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()[0:3]
        mon = Gdk.Display.get_default().get_monitor_at_point(x, y) or mon
    except Exception:
        pass
    win.set_size_request(min(1180, int(mon.get_geometry().width * 0.6)) if mon else 1100, -1)

    tabs = {}            # slot → {"view", "home", "fallback", "button"}
    order = []
    cur = {"slot": None}
    stack = Gtk.Stack()
    tabbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
    tabbar.set_name("tabs")
    bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    bar.set_name("bar")

    def view():
        t = tabs.get(cur["slot"])
        return t["view"] if t else None

    def save_state():
        st = {"visible": win.get_visible(), "current": cur["slot"],
              "slots": [{"slot": s, "title": tabs[s]["view"].get_title() or "", "url": tabs[s]["view"].get_uri() or tabs[s]["home"]}
                        for s in order]}
        try:
            open(statef + ".tmp", "w").write(json.dumps(st, ensure_ascii=False))
            os.replace(statef + ".tmp", statef)
        except OSError:
            pass

    def button(box, label, tip, cb, name=None, end=False):
        b = Gtk.Button(label=label)
        b.set_tooltip_text(tip)
        b.set_can_focus(False)
        if name:
            b.set_name(name)
        b.connect("clicked", lambda *_: cb())
        (box.pack_end if end else box.pack_start)(b, False, False, 0)
        return b

    title = Gtk.Label(label=tr("Loading…"), xalign=0)
    title.set_name("title")
    title.set_ellipsize(3)
    host = Gtk.Label(label="", xalign=0)
    host.set_name("host")
    host.set_ellipsize(3)

    def refresh_bar(*_):
        v = view()
        title.set_text((v.get_title() if v else "") or "")
        u = (v.get_uri() if v else "") or ""
        host.set_text(GLib.Uri.parse(u, GLib.UriFlags.NONE).get_host() if u.startswith("http") else u)
        for s, t in tabs.items():
            t["button"].set_name("tabon" if s == cur["slot"] else "tab")
        save_state()

    def select(slot):
        if slot not in tabs:
            return
        cur["slot"] = slot
        stack.set_visible_child_name(slot)
        tabs[slot]["view"].grab_focus()
        refresh_bar()

    def new_tab(slot, url, fallback):
        v = WebKit2.WebView.new_with_context(ctx)
        s = v.get_settings()
        s.set_enable_developer_extras(False)
        s.set_enable_smooth_scrolling(True)
        t = {"view": v, "home": url, "fallback": fallback if str(fallback or "").startswith("https://") else ""}

        # a page that isn't there (a game without a guide or map on that site): its search instead
        def use_fallback(w):
            fb, t["fallback"] = t["fallback"], ""
            w.load_uri(fb)

        def on_load(w, event):
            if event == WebKit2.LoadEvent.FINISHED:
                if t["fallback"]:
                    res = w.get_main_resource()
                    resp = res.get_response() if res else None
                    if resp and resp.get_status_code() >= 400:
                        use_fallback(w)
                    else:
                        t["fallback"] = ""      # only the first page counts
                save_state()

        def on_failed(w, _event, _uri, _err):
            if t["fallback"]:
                use_fallback(w)
                return True
            return False

        def on_create(w, action):          # links that want a new window open here instead
            req = action.get_request()
            if req and req.get_uri():
                w.load_uri(req.get_uri())
            return None

        v.connect("load-changed", on_load)
        v.connect("load-failed", on_failed)
        v.connect("create", on_create)
        v.connect("notify::title", lambda *_: refresh_bar() if cur["slot"] == slot else save_state())
        v.connect("notify::uri", lambda *_: refresh_bar() if cur["slot"] == slot else None)
        t["button"] = button(tabbar, slot, slot, lambda: select(slot), name="tab")
        tabs[slot] = t
        order.append(slot)
        stack.add_named(v, slot)
        v.show()
        tabbar.show_all()
        v.load_uri(url)

    def close_tab():
        s = cur["slot"]
        if s not in tabs:
            return
        t = tabs.pop(s)
        order.remove(s)
        stack.remove(t["view"])
        t["button"].destroy()
        t["view"].destroy()
        if not order:
            Gtk.main_quit()
            return
        select(order[-1])

    def show(slot=None):
        if slot:
            select(slot)
        if not win.get_visible():
            win.show_all()
            grab()
        v = view()
        if v:
            v.grab_focus()
        save_state()

    def hide():
        win.hide()
        save_state()

    def to_panel():
        hide()
        subprocess.Popen([deck, "panel", "show"], env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def to_browser():
        v = view()
        if v:
            subprocess.Popen(["xdg-open", v.get_uri() or tabs[cur["slot"]]["home"]], env=env, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        hide()

    def handle(req):
        c = req.get("cmd")
        if c == "open" and str(req.get("url", "")).startswith("https://"):
            slot = str(req.get("slot") or "Web")[:60]
            if slot in tabs:
                if not req.get("reuse"):
                    tabs[slot]["fallback"] = req.get("fallback") or ""
                    tabs[slot]["home"] = req["url"]
                    tabs[slot]["view"].load_uri(req["url"])
            else:
                new_tab(slot, req["url"], req.get("fallback"))
            show(slot)
        elif c == "show":
            show(req.get("slot") if req.get("slot") in tabs else None)
        elif c == "hide":
            hide()
        elif c == "close":
            Gtk.main_quit()

    button(bar, "☰ " + tr("Panel"), tr("Back to the panel (Esc)"), to_panel)
    button(bar, "←", tr("Back"), lambda: view() and view().go_back())
    button(bar, "→", tr("Forward"), lambda: view() and view().go_forward())
    button(bar, "⟳", tr("Reload"), lambda: view() and view().reload())
    button(bar, "⌂", tr("Start page of this tab"), lambda: view() and view().load_uri(tabs[cur["slot"]]["home"]))
    titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    titles.pack_start(title, False, False, 0)
    titles.pack_start(host, False, False, 0)
    bar.pack_start(titles, True, True, 6)
    button(bar, "✕", tr("Close this tab"), close_tab, name="close", end=True)
    button(bar, tr("Open in browser") + " ↗", tr("Open in browser"), to_browser, end=True)

    def on_key(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            to_panel()
            return True
        if ev.state & Gdk.ModifierType.MOD1_MASK and ev.keyval == Gdk.KEY_Left:
            v = view()
            if v:
                v.go_back()
            return True
        return False
    win.connect("key-press-event", on_key)
    win.connect("delete-event", lambda *_: (hide(), True)[1])

    def on_term(*_):
        Gtk.main_quit()
        return False

    def on_toggle(*_):                    # the panel's key: hide, or show again as it was
        if win.get_visible():
            hide()
        else:
            show()
        return True

    def on_request(*_):
        try:
            lines = open(ctlf).read().splitlines()
            os.remove(ctlf)
        except OSError:
            lines = []
        for line in lines:
            try:
                handle(json.loads(line))
            except ValueError:
                pass
        return True
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        add = GLibUnix.signal_add
    except (ImportError, ValueError):
        add = GLib.unix_signal_add
    add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, on_term)
    add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_toggle)
    add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, on_request)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    box.pack_start(tabbar, False, False, 0)
    box.pack_start(bar, False, False, 0)
    box.pack_start(stack, True, True, 0)
    win.add(box)
    box.show_all()
    handle(first)
    on_request()                          # anything asked while it was starting
    Gtk.main()

    try:
        if int(open(pidf).read().strip()) == os.getpid():
            for f in (pidf, statef):
                os.remove(f)
    except (OSError, ValueError):
        pass
    return 0


if __name__ == "__main__":
    rc = main()
    sys.stdout.flush()
    # straight out: WebKit's teardown at interpreter exit can abort (free(): corrupted…)
    os._exit(rc or 0)
