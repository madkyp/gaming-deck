# which packages changed between a snapshot and now

# ===========================================================================
# System clean-up
# ===========================================================================
dir_bytes() { du -sb "$@" 2>/dev/null | awk '{s += $1} END {print s + 0}'; }

# launchers in the user dir whose program no longer exists

# --- unused Proton versions (SYSTEM → CLEAN) ---------------------------------
# internal name of a compatibility tool (first block inside "compat_tools";
# lines may carry // comments)
compat_tool_name() {
    sed 's|//.*||' "$1" | awk '/"compat_tools"/ { f = 1; next }
        f && /"[^"]+"/ { match($0, /"[^"]*"/); print substr($0, RSTART + 1, RLENGTH - 2); exit }'
}

# every tool name Steam has assigned (per game, and "0" = the default)
steam_compat_used() {
    local cfg; cfg="$(steam_root)/config/config.vdf"; [[ -f "$cfg" ]] || return 0
    awk -v P="$COMPAT_MAPPING" '
        BEGIN { n = split(tolower(P), want, "/") }
        function under(   i) { if (d != n + 1) return 0; for (i = 1; i <= n; i++) if (st[i] != want[i]) return 0; return 1 }
        /^[ \t]*"[^"]*"[ \t]*(\/\/.*)?$/ { match($0, /"[^"]*"/); pend = tolower(substr($0, RSTART + 1, RLENGTH - 2)); next }
        /^[ \t]*\{/ { st[++d] = pend; next }
        /^[ \t]*\}/ { d--; next }
        under() && match($0, /^[ \t]*"name"[ \t]+"/) {
            v = substr($0, RLENGTH + 1); sub(/"[ \t]*$/, "", v); if (v != "") print v }' "$cfg" | sort -u
}

# user-installed tools: dir <TAB> internal name <TAB> version (from its `version` file)
user_compat_tools() {
    local r d seen="" real
    for r in "$(steam_root)/compatibilitytools.d" "$HOME/.steam/root/compatibilitytools.d"; do
        for d in "$r"/*/; do
            d="${d%/}"; [[ -f "$d/compatibilitytool.vdf" ]] || continue
            real="$(readlink -f "$d")"; [[ "$seen" == *$'\n'"$real"$'\n'* ]] && continue
            seen+=$'\n'"$real"$'\n'
            printf '%s\t%s\t%s\n' "$real" "$(compat_tool_name "$d/compatibilitytool.vdf")" \
                "$(awk '{ print $2; exit }' "$d/version" 2>/dev/null)"
        done
    done
}

# tools nothing uses: not assigned in Steam, not a runner in Umbral's config
# ("GE-Proton" there = the newest GE it finds, which can be one of Steam's),
# no non-Steam prefix made by them (Umbral/umu keep using the prefix's Proton),
# and not running. Proton that comes with Steam or a package isn't listed.
unused_compat_tools() {
    local pfx="${1:-}" steam_used umbral_used pfx_vers ge d g name ver
    [[ -n "$pfx" ]] || pfx="$(cmd_prefixes)"
    steam_used="$(steam_compat_used)"
    umbral_used="$(umbral_json | jq -r '[.. | objects | .runner? | strings] | unique[]' 2>/dev/null)"
    if grep -qx GE-Proton <<<"$umbral_used"; then
        ge="$(for d in "$DATA_HOME/umbral/runners" "$(steam_root)/compatibilitytools.d" \
                       "$HOME/.steam/root/compatibilitytools.d" /usr/share/steam/compatibilitytools.d; do
                  for g in "$d"/GE-Proton*/; do [[ -f "$g/proton" ]] && basename "$g"; done
              done | sort -V | tail -1)"
        umbral_used+=$'\n'"$ge"
    fi
    pfx_vers="$(jq -r '.prefixes[] | select(.owner != "steam") | .version | strings' <<<"$pfx")"
    while IFS=$'\t' read -r d name ver; do
        [[ -n "$d" ]] || continue
        grep -qxF -- "$name" <<<"$steam_used" && continue
        grep -qxF -- "${d##*/}" <<<"$umbral_used" && continue
        [[ -n "$ver" ]] && grep -qxF -- "$ver" <<<"$pfx_vers" && continue
        grep -qsaF -- "$d/" "${PROC_ROOT:-/proc}"/[0-9]*/cmdline 2>/dev/null && continue
        printf '%s\t%s\n' "$d" "$name"
    done < <(user_compat_tools)
}

# clean items, one field per line: id title desc count bytes details
clean_items() {
    local list n bytes

    # the game caches and leftovers (the system ones are System Deck's)
    local sc pfx
    sc="$(cmd_shadercache 2>/dev/null)"; [[ -n "$sc" ]] || sc='{"games":[],"global":[],"staleBytes":0,"orphanBytes":0}'
    printf '%s\n' shaders "Shader caches" \
        "Driver caches older than the last driver update, and caches of uninstalled games (rebuilt when needed)." \
        "$(jq '[.games[] | select(.stale or (.installed | not))] + [.global[] | select(.stale)] | length' <<<"$sc")" \
        "$(jq '.staleBytes + .orphanBytes' <<<"$sc")" ""

    pfx="$(cmd_prefixes 2>/dev/null)"; [[ -n "$pfx" ]] || pfx='{"prefixes":[]}'
    printf '%s\n' prefixes "Orphan prefixes" "Wine prefixes of uninstalled Steam games (each one is backed up first)." \
        "$(jq '[.prefixes[] | select(.orphan and .owner == "steam" and (.running | not))] | length' <<<"$pfx")" \
        "$(jq '[.prefixes[] | select(.orphan and .owner == "steam" and (.running | not)) | .size] | add // 0' <<<"$pfx")" \
        "$(jq -r '[.prefixes[] | select(.orphan and .owner == "steam" and (.running | not)) | .name] | join(" · ")' <<<"$pfx")"

    list="$(unused_compat_tools "$pfx")"
    n=0; bytes=0
    if [[ -n "$list" ]]; then
        n="$(wc -l <<<"$list")"
        local dirs=(); mapfile -t dirs < <(cut -f1 <<<"$list")
        bytes="$(dir_bytes "${dirs[@]}")"
    fi
    printf '%s\n' protons "Unused Proton versions" \
        "Proton builds in compatibilitytools.d no Steam game, Umbral prefix or running game uses." \
        "$n" "$bytes" "$(cut -f2 <<<"$list" | paste -sd '|' | sed 's/|/ · /g')"
}

cmd_cleanscan() {
    clean_items | jq -Rn '[inputs] as $l | [range(0; $l|length; 6) as $i |
        {id:$l[$i], title:$l[$i+1], desc:$l[$i+2], count:($l[$i+3]|tonumber? // 0),
         bytes:($l[$i+4]|tonumber? // null), details:$l[$i+5]}]
        | map(. + {size:(if .bytes == null then "" else (.bytes |
            if . >= 1073741824 then "\((. / 1073741824 * 10 | floor) / 10) GiB"
            elif . >= 1048576 then "\((. / 1048576 * 10 | floor) / 10) MiB"
            elif . >= 1024 then "\(. / 1024 | floor) KiB" else "\(.) B" end) end)})'
}

clean_one() {
    local id="$1"
    case "$id" in
        shaders)
            local sc rc=0; sc="$(cmd_shadercache)"
            if [[ "$(jq '.orphanBytes' <<<"$sc")" != 0 ]]; then cmd_shaderclean orphans || rc=$?; fi
            if [[ "$(jq '.staleBytes' <<<"$sc")" != 0 ]]; then cmd_shaderclean stale || rc=$?; fi
            return $rc ;;
        prefixes)
            local p rc=0
            while IFS= read -r p; do
                [[ -n "$p" ]] || continue
                cmd_prefix delete "$p" || rc=$?
            done < <(cmd_prefixes | jq -r '.prefixes[] | select(.orphan and .owner == "steam" and (.running | not)) | .path')
            ((rc == 0)) && log "✔ Orphan prefixes removed (backups in ${PREFIX_BACKUPS/#$HOME/\~})."
            return $rc ;;
        protons)
            local d name
            while IFS=$'\t' read -r d name; do
                [[ -n "$d" && "$d" == */compatibilitytools.d/* && "$d" == "$HOME"/* ]] || continue
                rm -rf -- "$d" && log "→ removed $name (${d/#$HOME/\~})"
            done < <(unused_compat_tools)
            log "✔ Unused Proton versions removed. Steam lists its tools at startup: restart it if it's open." ;;
        *) err "unknown clean-up: $id"; return 2 ;;
    esac
}

cmd_clean() {
    clean_one "$1"; local rc=$?
    history_add clean "$1" "$1" $rc
    return $rc
}

# ===========================================================================
# Backup: export / restore the set of installed apps
# ===========================================================================
cmd_export() {
    local out="${1:-$HOME/gaming-deck-backup-$(date +%F).json}"
    # profiles, shader looks (small files), saved preset pages, keys, scheduler
    local gaming; gaming="$(jq -n --argjson prof "$(profiles_json)" \
        --argjson links "$(fx_links_json)" \
        --argjson fxs "$(cat "$FX_SETTINGS" 2>/dev/null || echo '{}')" \
        --argjson sched "$(cat "$SCHED_SETTINGS" 2>/dev/null || echo '{}')" \
        --argjson looks "$(for d in "$FX_PROFILES"/*/; do
                [[ -d "$d" ]] || continue
                jq -n --arg id "$(basename "$d")" \
                    --arg report "$(cat "$d/report.json" 2>/dev/null)" --arg preset "$(cat "$d/preset.ini" 2>/dev/null)" \
                    --arg rs "$(cat "$d/ReShadePreset.ini" 2>/dev/null)" --arg vkb "$(cat "$d/vkBasalt.conf" 2>/dev/null)" \
                    '{id:$id, report:$report, preset:$preset, reshadePreset:$rs, vkbasalt:$vkb}'
            done | jq -s .)" \
        '{profiles:$prof, links:$links, fx:$fxs, sched:$sched, looks:$looks}')"
    jq -n --arg date "$(date -Is)" --arg host "$(uname -n)" --argjson gaming "$gaming" \
        '{app:"gaming-deck", version:1, date:$date, host:$host, gaming:$gaming}' > "$out" \
        || { err "could not write $out"; return 4; }
    log "✔ Backup saved to $out"
    log "  $(jq -r '"\(.gaming.profiles | length) game profile(s) · \(.gaming.looks | length) look(s) · \(.gaming.links | length) game(s) with saved preset pages"' "$out")"
    history_add export backup "$(basename "$out")" 0
}

# the gaming part of a backup: only what this PC doesn't have yet is added
gaming_import() {
    local file="$1" n tmp d id
    jq -e '.gaming' "$file" >/dev/null 2>&1 || return 0
    mkdir -p "$GAMING_DIR" "$FX_PROFILES"; tmp="$(mktemp)"
    n="$(jq --argjson here "$(profiles_json)" '[.gaming.profiles | keys[] | select($here[.] == null)] | length' "$file")"
    # the backup's profiles, then this PC's on top: nothing here is overwritten
    jq -n --argjson a "$(profiles_json)" --slurpfile b "$file" '($b[0].gaming.profiles // {}) + $a' > "$tmp"
    mv "$tmp" "$PROFILES"
    jq -n --argjson a "$(fx_links_json)" --slurpfile b "$file" '($b[0].gaming.links // {}) + $a' > "$tmp" && mv "$tmp" "$FX_LINKS"
    [[ -f "$FX_SETTINGS" ]] || jq '.gaming.fx // {}' "$file" > "$FX_SETTINGS"
    [[ -f "$SCHED_SETTINGS" ]] || jq '.gaming.sched // {}' "$file" > "$SCHED_SETTINGS"
    while IFS= read -r id; do
        [[ "$id" =~ ^[A-Za-z0-9._:-]+$ ]] || continue
        d="$FX_PROFILES/$id"; [[ -e "$d" ]] && continue
        mkdir -p "$d"
        jq -r --arg i "$id" '.gaming.looks[] | select(.id == $i) | .report' "$file" | grep -q . \
            && jq -r --arg i "$id" '.gaming.looks[] | select(.id == $i) | .report' "$file" > "$d/report.json"
        local f k
        for k in preset:preset.ini reshadePreset:ReShadePreset.ini vkbasalt:vkBasalt.conf; do
            f="$(jq -r --arg i "$id" --arg k "${k%%:*}" '.gaming.looks[] | select(.id == $i) | .[$k] // ""' "$file")"
            [[ -n "$f" ]] && printf '%s\n' "$f" > "$d/${k#*:}"
        done
    done < <(jq -r '.gaming.looks[]?.id' "$file")
    log "→ Gaming: $n game profile(s) added (the ones already here were kept)"
    local issues; issues="$(cmd_gaudit | jq '.issues | length')"
    (( issues > 0 )) && log "  $issues thing(s) to adjust for this PC: GAMING → LIBRARY → CHECK FOR THIS PC"
    return 0
}

# gaming-import <backup.json> — only the gaming part (e.g. from your other PC)
cmd_gaming_import() {
    # a Gaming Deck backup, or the gaming part of an old Control Deck one
    [[ -f "$1" ]] && jq -e '(.app == "gaming-deck" or .app == "control-deck") and (.gaming | type == "object")' "$1" >/dev/null 2>&1 \
        || { err "not a Gaming Deck (or Control Deck) backup with game data: $1"; return 2; }
    gaming_import "$1"
    history_add "gaming import" backup "$(basename "$1")" 0
}

# --- history: JSON, newest first --------------------------------------------
cmd_history() {
    [[ -f "$HISTORY_FILE" ]] || { echo "[]"; return; }
    # game keys (steam:<id>, umbral:<id>, or a bare Steam id) get the game's name in .name
    local names
    names="$( { steam_games | awk 'NR % 5 == 1 { id = $0 } NR % 5 == 2 { print "steam:" id "\t" $0 }'
               umbral_json | jq -r '(.games // [])[] | "umbral:\(.id)\t\(.name)"' 2>/dev/null; } \
             | jq -Rn '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}')"; [[ -n "$names" ]] || names='{}'
    tail -n 300 "$HISTORY_FILE" | jq -Rn --argjson n "$names" '[inputs | split("\t") |
        {date:.[0], action:.[1], source:.[2], target:.[3], result:.[4]}
        | (.target | split(" ")) as $w
        | (if $n[$w[0]] then $w[0] elif .source == "steam" and ($w[0] | test("^[0-9]+$")) and $n["steam:" + $w[0]] then "steam:" + $w[0] else null end) as $k
        | .name = (if $k then ([$n[$k]] + $w[1:] | join(" ")) else .target end)] | reverse'
}

# ===========================================================================
# GAMING — game library, per-game profiles, Steam integration, ProtonDB
# ===========================================================================
# Profiles live in $GAMING_DIR/profiles.json as {"default": {...}, "steam:<appid>": {...}}.
# A profile is applied by the `run` wrapper, which Steam calls through the
# game's launch options (`…/gaming-deck run %command%`). Everything the
# wrapper changes either dies with the game (env, nice, ionice) or is handled
# by gamemode, whose daemon restores the CPU governor when the registered
# process exits — even if it is killed — so no revert step can be missed.

# --- Valve KeyValues (.vdf) --------------------------------------------------
# Steam rewrites localconfig.vdf / config.vdf on exit, so every write below
# refuses to run while Steam is open. Keys are matched case-insensitively,
# like Steam does. BLOCK paths are "/"-separated (Root/Software/Valve/…).
vdf_escape() { local v="${1//\\/\\\\}"; printf '%s' "${v//\"/\\\"}"; }

# vdf_get <file> <block path> <key>
vdf_get() {
    awk -v P="$2" -v K="$3" '
        BEGIN { n = split(tolower(P), want, "/") }
        function here(   i) { if (d != n) return 0; for (i = 1; i <= n; i++) if (st[i] != want[i]) return 0; return 1 }
        /^[ \t]*"[^"]*"[ \t]*(\/\/.*)?$/ { match($0, /"[^"]*"/); pend = tolower(substr($0, RSTART + 1, RLENGTH - 2)); next }
        /^[ \t]*\{/ { st[++d] = pend; next }
        /^[ \t]*\}/ { d--; next }
        here() && match($0, /^[ \t]*"[^"]*"/) {
            k = substr($0, RSTART, RLENGTH); gsub(/^[ \t]*"|"$/, "", k)
            if (tolower(k) == tolower(K)) {
                v = substr($0, RLENGTH + 1); sub(/^[ \t]*"/, "", v); sub(/"[ \t]*$/, "", v)
                gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v); print v; exit
            }
        }' "$1"
}

# vdf_set <file> <block path> KEY=VALUE…  — creates missing blocks; writes in place
vdf_set() {
    local file="$1" path="$2" kv sets tmp; shift 2
    sets="$(mktemp)"; tmp="$(mktemp)"
    for kv in "$@"; do printf '%s\t%s\n' "${kv%%=*}" "$(vdf_escape "${kv#*=}")"; done > "$sets"
    awk -v P="$path" -v SETS="$sets" '
        BEGIN {
            n = split(P, wantc, "/"); for (i = 1; i <= n; i++) want[i] = tolower(wantc[i])
            while ((getline l < SETS) > 0) { i = index(l, "\t"); key[++m] = substr(l, 1, i - 1); val[m] = substr(l, i + 1) }
        }
        function tabs(k,   s) { s = ""; while (k-- > 0) s = s "\t"; return s }
        function prefix(k,   i) { for (i = 1; i <= k; i++) if (st[i] != want[i]) return 0; return 1 }
        function emit_keys(ind,   j) { for (j = 1; j <= m; j++) if (!done[j]) { print tabs(ind) "\"" key[j] "\"\t\t\"" val[j] "\""; done[j] = 1 } }
        /^[ \t]*"[^"]*"[ \t]*(\/\/.*)?$/ { match($0, /"[^"]*"/); pend = tolower(substr($0, RSTART + 1, RLENGTH - 2)); print; next }
        /^[ \t]*\{/ { st[++d] = pend; print; next }
        /^[ \t]*\}/ {
            if (!finished && d == n && prefix(n)) { emit_keys(d); finished = 1 }
            else if (!finished && d < n && prefix(d)) {
                # the rest of the path doesn'"'"'t exist yet: create it here
                for (i = d + 1; i <= n; i++) { print tabs(i - 1) "\"" wantc[i] "\""; print tabs(i - 1) "{" }
                emit_keys(n)
                for (i = n; i > d; i--) print tabs(i - 1) "}"
                finished = 1
            }
            d--; print; next
        }
        d == n && prefix(n) && match($0, /^[ \t]*"[^"]*"/) {
            k = substr($0, RSTART, RLENGTH); gsub(/^[ \t]*"|"$/, "", k)
            for (j = 1; j <= m; j++) if (!done[j] && tolower(k) == tolower(key[j])) {
                print tabs(d) "\"" k "\"\t\t\"" val[j] "\""; done[j] = 1; next_line = 1
            }
            if (next_line) { next_line = 0; next }
        }
        { print }' "$file" > "$tmp" || { rm -f "$sets" "$tmp"; return 1; }
    rm -f "$sets"
    cat "$tmp" > "$file"; rm -f "$tmp"
}

# vdf_del <file> <block path> [key]  — remove a key, or the whole block
vdf_del() {
    local file="$1" tmp; tmp="$(mktemp)"
    awk -v P="$2" -v K="$3" '
        BEGIN { n = split(tolower(P), want, "/") }
        function here(k,   i) { if (d != k) return 0; for (i = 1; i <= k; i++) if (st[i] != want[i]) return 0; return 1 }
        skip { if ($0 ~ /^[ \t]*\{/) depth++; else if ($0 ~ /^[ \t]*\}/ && --depth == 0) skip = 0; next }
        /^[ \t]*"[^"]*"[ \t]*(\/\/.*)?$/ {
            match($0, /"[^"]*"/); nm = tolower(substr($0, RSTART + 1, RLENGTH - 2))
            if (K == "" && here(n - 1) && nm == want[n]) { skip = 1; depth = 0; next }
            pend = nm; print; next
        }
        /^[ \t]*\{/ { st[++d] = pend; print; next }
        /^[ \t]*\}/ { d--; print; next }
        K != "" && here(n) && match($0, /^[ \t]*"[^"]*"/) {
            k = substr($0, RSTART, RLENGTH); gsub(/^[ \t]*"|"$/, "", k)
            if (tolower(k) == tolower(K)) next
        }
        { print }' "$file" > "$tmp" && cat "$tmp" > "$file"
    rm -f "$tmp"
}

# --- Steam -------------------------------------------------------------------
steam_root() { echo "${GAMING_DECK_STEAM_ROOT:-$HOME/.local/share/Steam}"; }

steam_running() {
    if [[ -n "${GAMING_DECK_STEAM_RUNNING:-}" ]]; then [[ "$GAMING_DECK_STEAM_RUNNING" == 1 ]]; return; fi
    pgrep -x steam >/dev/null 2>&1
}

# library folders (the Steam root is always one)
steam_libs() {
    local r; r="$(steam_root)"
    { echo "$r"; grep -oP '"path"\s+"\K[^"]+' "$r/steamapps/libraryfolders.vdf" 2>/dev/null; } | awk '!seen[$0]++'
}

# the logged-in user's localconfig.vdf (most recently written one)
steam_localconfig() {
    ls -t "$(steam_root)"/userdata/*/config/localconfig.vdf 2>/dev/null | head -1
}

LOCALCONFIG_APPS="UserLocalConfigStore/Software/Valve/Steam/apps"
COMPAT_MAPPING="InstallConfigStore/Software/Valve/Steam/CompatToolMapping"

# tools, runtimes and redistributables are not games
steam_is_tool() {
    case "$2" in
        Proton*|"Steam Linux Runtime"*|"Steamworks Common Redistributables"|SteamVR*) return 0 ;;
    esac
    [[ "$1" == 228980 ]]
}

# appid<US>name<US>installdir<US>size<US>library for every installed game
steam_games() {
    local lib m id name dir size
    while IFS= read -r lib; do
        for m in "$lib"/steamapps/appmanifest_*.acf; do
            [[ -f "$m" ]] || continue
            id="$(vdf_get "$m" AppState appid)"; name="$(vdf_get "$m" AppState name)"
            dir="$(vdf_get "$m" AppState installdir)"; size="$(vdf_get "$m" AppState SizeOnDisk)"
            steam_is_tool "$id" "$name" && continue
            printf '%s\n' "$id" "$name" "$dir" "${size:-0}" "$lib"
        done
    done < <(steam_libs)
}

gaming_deck_bin() {
    if [[ -x "$HOME/.local/bin/gaming-deck" ]]; then echo "$HOME/.local/bin/gaming-deck"; else readlink -f "$0"; fi
}

# --- profiles ----------------------------------------------------------------
GAMING_DIR="$STATE_DIR/gaming"
PROFILES="$GAMING_DIR/profiles.json"
DEFAULT_PROFILE='{"gamemode":true,"mangohud":false,"overlay":false,"fx":false,"fxMode":"vkbasalt","ionice":false,"nice":0,"env":{},"prefix":"","args":""}'

profiles_json() { if [[ -s "$PROFILES" ]]; then cat "$PROFILES"; else echo '{}'; fi; }

# effective profile of a game: built-in default ← user "default" ← game
profile_get() {
    profiles_json | jq -c --arg k "$1" --argjson d "$DEFAULT_PROFILE" \
        '. as $all | $d + ($all.default // {}) + ($all[$k] // {}) + {custom: ($all | has($k))}' 2>/dev/null \
        || echo "$DEFAULT_PROFILE"
}

profile_write() {   # profile_write <key> <json object to merge>; "null" deletes it
    mkdir -p "$GAMING_DIR"
    local tmp; tmp="$(mktemp)"
    profiles_json | jq --arg k "$1" --argjson p "$2" \
        'if $p == null then del(.[$k]) else .[$k] = ((.[$k] // {}) + $p) end' > "$tmp" \
        && mv "$tmp" "$PROFILES"
}

valid_game_key() { [[ "$1" =~ ^(default|steam:[0-9]+|[a-z]+:[A-Za-z0-9._:-]+)$ ]]; }

# gprofile get <key> | set <key> FIELD=VALUE… | reset <key>
cmd_gprofile() {
    local sub="$1" key="$2"; shift 2 2>/dev/null
    valid_game_key "$key" || { err "not a game key: $key (e.g. steam:1422450 or default)"; return 2; }
    case "$sub" in
        get) profile_get "$key" ;;
        reset) profile_write "$key" null; log "✔ Profile of $(game_label "$key") reset to the default." ;;
        set)
            local patch='{}' kv f v e
            for kv in "$@"; do
                f="${kv%%=*}"; v="${kv#*=}"
                case "$f" in
                    gamemode|mangohud|overlay|ionice)
                        [[ "$v" == true || "$v" == false ]] || { err "$f must be true or false"; return 2; }
                        patch="$(jq -c --arg f "$f" --argjson v "$v" '.[$f] = $v' <<<"$patch")" ;;
                    nice)
                        [[ "$v" =~ ^-?[0-9]+$ ]] && (( v >= -10 && v <= 0 )) || { err "nice must be between -10 and 0"; return 2; }
                        patch="$(jq -c --argjson v "$v" '.nice = $v' <<<"$patch")" ;;
                    env)
                        # "VAR=value VAR2=value" — names checked, values without spaces
                        local obj='{}'
                        for e in $v; do
                            [[ "$e" =~ ^[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*$ ]] || { err "bad environment variable: $e"; return 2; }
                            obj="$(jq -c --arg k "${e%%=*}" --arg x "${e#*=}" '.[$k] = $x' <<<"$obj")"
                        done
                        patch="$(jq -c --argjson o "$obj" '.env = $o' <<<"$patch")" ;;
                    prefix|args|name)
                        [[ "$v" != *[\"\'\`\$\;\&\|\<\>]* ]] || { err "$f can't contain quotes or shell characters"; return 2; }
                        patch="$(jq -c --arg f "$f" --arg v "$v" '.[$f] = $v' <<<"$patch")" ;;
                    *) err "unknown profile field: $f"; return 2 ;;
                esac
            done
            profile_write "$key" "$patch"
            log "✔ Profile of $(game_label "$key") saved."
            history_add "game profile" "${key%%:*}" "$key" 0 ;;
        *) err "use: gprofile get|set|reset <key> …"; return 2 ;;
    esac
}

# --- run: the wrapper Steam (or Lutris/Heroic) calls around the game ---------
#   gaming-deck run [--profile <key>] [--] <command…>
cmd_run() {
    local key=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile) key="$2"; shift 2 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    [[ $# -gt 0 ]] || { err "use: gaming-deck run [--profile KEY] -- <command>"; return 2; }
    if [[ -z "$key" ]]; then
        if [[ -n "${SteamAppId:-}" && "$SteamAppId" != 0 ]]; then key="steam:$SteamAppId"; else key=default; fi
    fi
    valid_game_key "$key" || key=default

    local p pre=() extra=() name val
    p="$(profile_get "$key")"
    mkdir -p "$STATE_DIR/logs"
    local rlog="$STATE_DIR/logs/run.log"
    printf '%s  %s  %s\n' "$(date '+%F %T')" "$key" "$*" >> "$rlog"
    p="$(bench_overlay "$key" "$p")"
    # (runs in a subshell above, so the benchmark's MangoHud logging is exported here)
    local mhc; mhc="$(jq -r '.mangohudConfig // empty' <<<"$p")"
    [[ -n "$mhc" ]] && export MANGOHUD_CONFIG="$mhc"

    while IFS=$'\t' read -r name val; do
        [[ -n "$name" ]] && export "$name=$val"
    done < <(jq -r '.env | to_entries[] | [.key, .value] | @tsv' <<<"$p")

    local n; n="$(jq -r '.nice' <<<"$p")"
    if [[ "$n" != 0 ]]; then
        renice -n "$n" -p $$ >/dev/null 2>&1 || echo "  nice $n not allowed (join the gamemode group)" >> "$rlog"
    fi
    if [[ "$(jq -r '.ionice' <<<"$p")" == true ]]; then
        ionice -c2 -n0 -p $$ >/dev/null 2>&1 || echo "  ionice failed" >> "$rlog"
    fi
    [[ "$(jq -r '.gamemode' <<<"$p")" == true ]] && { have gamemoderun && pre+=(gamemoderun) || echo "  gamemode not installed" >> "$rlog"; }
    [[ "$(jq -r '.mangohud' <<<"$p")" == true ]] && { have mangohud && pre+=(mangohud) || echo "  mangohud not installed" >> "$rlog"; }
    read -ra extra <<<"$(jq -r '.prefix' <<<"$p")"; pre+=("${extra[@]}")
    read -ra extra <<<"$(jq -r '.args' <<<"$p")"
    # OptiScaler loads as dxgi.dll unless told otherwise: with ReShade on dxgi
    # it goes to winmm.dll; its menu (Insert) moves to Page Down if Insert is ours
    if [[ "${PROTON_USE_OPTISCALER:-0}" == 1 ]]; then
        local rst; rst="$(reshade_state "$key")"
        if [[ -z "${PROTON_OPTISCALER_NAME:-}" && "$(jq -r '.fx' <<<"$p")" == true && "$(jq -r '.fxMode' <<<"$p")" == reshade \
              && -n "$rst" && "$(jq -r .api <<<"$rst")" == dxgi ]]; then
            export PROTON_OPTISCALER_NAME=winmm.dll
        fi
        [[ "$(fx_key)" == Insert ]] && export PROTON_OPTISCALER_CONFIG="${PROTON_OPTISCALER_CONFIG:+$PROTON_OPTISCALER_CONFIG;}Menu.ShortcutKey=0x22"
    fi
    # visual shaders: vkBasalt layer with this game's config
    if [[ "$(jq -r '.fx' <<<"$p")" == true ]]; then
        if [[ "$(jq -r '.fxMode // "vkbasalt"' <<<"$p")" == reshade ]]; then
            local rst api; rst="$(reshade_state "$key")"
            if [[ -n "$rst" ]]; then
                api="$(jq -r .api <<<"$rst")"
                export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}d3dcompiler_47=n;$api=n,b"
            else echo "  ReShade on but not installed in the game folder" >> "$rlog"; fi
        else
            local fxc; fxc="$(fx_key_dir "$key")/vkBasalt.conf"
            # vkBasalt's own log (it writes to the game's stderr otherwise, which Steam keeps)
            if [[ -s "$fxc" ]]; then mkdir -p "$STATE_DIR/logs"
                export ENABLE_VKBASALT=1 VKBASALT_CONFIG_FILE="$fxc" VKBASALT_LOG_LEVEL=info VKBASALT_LOG_FILE="$STATE_DIR/logs/vkbasalt-${key//[:\/]/_}.log"
            else echo "  visual shaders on but no config at $fxc" >> "$rlog"; fi
        fi
    fi
    # the game runs as our child: we stay alive exactly as long as it (the
    # overlay follows our pid) and see how it ended
    [[ "$(jq -r '.overlay' <<<"$p")" == true ]] && { cmd_overlay $$ || echo "  overlay not started" >> "$rlog"; }
    session_begin "$key" $$
    panel_autostart
    local t0 child rc rec=""
    t0="$(date +%s)"
    "${pre[@]}" "$@" "${extra[@]}" &
    child=$!
    [[ "$key" != default ]] && rec="$(session_record_start "$key" "$child")"
    trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
    wait "$child"; rc=$?
    # a signal interrupts wait: wait again for the real exit code
    while kill -0 "$child" 2>/dev/null; do wait "$child"; rc=$?; done
    trap - TERM INT HUP
    session_end $$
    session_record_end "$key" "$rec" "$t0"
    printf '%s  %s  exit %s\n' "$(date '+%F %T')" "$key" "$rc" >> "$rlog"
    # 128+n = killed by a signal (Steam's STOP, Ctrl+C): not a crash
    if (( rc != 0 && rc < 128 )) && [[ "$key" == steam:* ]]; then game_crashed "$key" "$rc" "$t0"; fi
    return "$rc"
}

# --- Steam launch options ------------------------------------------------------
# turn an existing launch-options string into profile fields (JSON), so
# "VAR=1 mangohud gamemoderun %command% -novid" keeps working once wrapped
adopt_launch_options() {
    local s="$1" before after tok env='{}' gm=false mh=false prefix=() args=""
    if [[ "$s" == *%command%* ]]; then before="${s%%%command%*}"; after="${s#*%command%}"
    else before=""; after="$s"; fi
    for tok in $before; do
        case "$tok" in
            gamemoderun) gm=true ;;
            mangohud) mh=true ;;
            [A-Za-z_]*=*) [[ "$tok" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && env="$(jq -c --arg k "${tok%%=*}" --arg v "${tok#*=}" '.[$k] = $v' <<<"$env")" || prefix+=("$tok") ;;
            *) prefix+=("$tok") ;;
        esac
    done
    args="$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g' <<<"$after")"
    jq -cn --argjson env "$env" --argjson gm "$gm" --argjson mh "$mh" \
          --arg prefix "${prefix[*]}" --arg args "$args" \
          '{env:$env, gamemode:$gm, mangohud:$mh, prefix:$prefix, args:$args}'
}

wrapper_line() { printf '%s run %%command%%' "$(gaming_deck_bin)"; }

# steamwrap <appid> on|off — make Steam launch the game through the wrapper
cmd_steamwrap() {
    local id="$1" mode="$2" lc cur orig key
    [[ "$id" =~ ^[0-9]+$ ]] || { err "use: steamwrap <appid> on|off"; return 2; }
    steam_running && { err "close Steam first: it rewrites its config when it exits"; return 3; }
    lc="$(steam_localconfig)"; [[ -f "$lc" ]] || { err "Steam user config not found"; return 4; }
    key="steam:$id"
    cur="$(vdf_get "$lc" "$LOCALCONFIG_APPS/$id" LaunchOptions)"
    cp -f "$lc" "$lc.gaming-deck.bak"
    case "$mode" in
        on)
            if [[ "$cur" == *"gaming-deck run"* ]]; then log "✔ Already launched through Gaming Deck."; return 0; fi
            if [[ "$cur" == *[\"\'\`\;\&\|]* ]]; then
                err "these launch options use quoting/shell syntax the deck won't rewrite: $cur"
                err "set them in the profile by hand, then try again"; return 3
            fi
            # what the game used is merged into its profile (even one saved before):
            # env adds up (the profile wins), prefix/args only fill empty fields,
            # gamemode/mangohud turn on if the old line used them
            if [[ -n "$cur" ]]; then
                profile_write "$key" "$(jq -cn --argjson a "$(adopt_launch_options "$cur")" --argjson p "$(profiles_json | jq -c --arg k "$key" '.[$k] // {}')" '
                    {env: ($a.env + ($p.env // {})),
                     prefix: (if ($p.prefix // "") == "" then $a.prefix else $p.prefix end),
                     args: (if ($p.args // "") == "" then $a.args else $p.args end)}
                    + (if $a.gamemode then {gamemode:true} else {} end)
                    + (if $a.mangohud then {mangohud:true} else {} end)')"
                log "→ Existing options merged into the profile: $cur"
            fi
            profile_write "$key" "$(jq -cn --arg o "$cur" '{original_launch:$o}')"
            vdf_set "$lc" "$LOCALCONFIG_APPS/$id" "LaunchOptions=$(wrapper_line)" || { err "could not write $lc"; return 4; }
            log "✔ Steam now launches $id through Gaming Deck: $(wrapper_line)" ;;
        off)
            orig="$(profiles_json | jq -r --arg k "$key" '.[$k].original_launch // ""')"
            if [[ -n "$orig" ]]; then vdf_set "$lc" "$LOCALCONFIG_APPS/$id" "LaunchOptions=$orig"
            else vdf_del "$lc" "$LOCALCONFIG_APPS/$id" LaunchOptions; fi
            log "✔ Steam launch options of $id restored${orig:+: $orig}" ;;
        *) err "use: steamwrap <appid> on|off"; return 2 ;;
    esac
    log "  (backup of the previous file: $lc.gaming-deck.bak)"
    history_add "steam launch $mode" steam "$id" 0
}

# --- Proton version per game ------------------------------------------------------
# JSON [{name, display}] of the compatibility tools Steam can use
cmd_compattools() {
    local r d f n disp; r="$(steam_root)"
    {
        [[ -d "$r/steamapps/common/Proton - Experimental" ]] && printf '%s\n' proton_experimental "Proton Experimental"
        for f in "$r"/compatibilitytools.d/*/compatibilitytool.vdf; do
            [[ -f "$f" ]] || continue
            # internal name = first block inside "compat_tools" (lines may carry // comments)
            n="$(sed 's|//.*||' "$f" | awk '/"compat_tools"/ { f = 1; next }
                  f && /"[^"]+"/ { match($0, /"[^"]*"/); print substr($0, RSTART + 1, RLENGTH - 2); exit }')"
            disp="$(grep -oP '"display_name"\s+"\K[^"]+' "$f" | head -1)"
            [[ -n "$n" ]] && printf '%s\n' "$n" "${disp:-$n}"
        done
    } | jq -Rn '[inputs] as $l | [range(0; $l|length; 2) as $i | {name:$l[$i], display:$l[$i+1]}]'
}

# steamcompat <appid> <tool name|default>
cmd_steamcompat() {
    local id="$1" tool="$2" cfg
    [[ "$id" =~ ^[0-9]+$ && -n "$tool" ]] || { err "use: steamcompat <appid> <tool|default>"; return 2; }
    steam_running && { err "close Steam first: it rewrites its config when it exits"; return 3; }
    cfg="$(steam_root)/config/config.vdf"; [[ -f "$cfg" ]] || { err "Steam config.vdf not found"; return 4; }
    if [[ "$tool" != default ]] && ! cmd_compattools | jq -e --arg t "$tool" 'any(.[]; .name == $t)' >/dev/null; then
        err "unknown compatibility tool: $tool"; return 2
    fi
    cp -f "$cfg" "$cfg.gaming-deck.bak"
    if [[ "$tool" == default ]]; then
        vdf_del "$cfg" "$COMPAT_MAPPING/$id"
        log "✔ $id uses Steam's default Proton again."
    else
        vdf_set "$cfg" "$COMPAT_MAPPING/$id" "name=$tool" "config=" "priority=250" || { err "could not write config.vdf"; return 4; }
        log "✔ $id will run with $tool."
    fi
    history_add "proton $tool" steam "$id" 0
}

# --- Umbral (github.com/madkyp/umbral-project) ---------------------------------------
# Umbral is the user's launcher for Battle.net and games from no store. Its
# library lives in ~/.config/umbral/config.json ({prefixes:[…], games:[…]});
# games start with `umbral --launch <id>`. Read-only here: launch options of
# Umbral games are Umbral's business.
UMBRAL_CONFIG="${GAMING_DECK_UMBRAL_CONFIG:-$CONFIG_HOME/umbral/config.json}"

umbral_json() { if [[ -s "$UMBRAL_CONFIG" ]]; then cat "$UMBRAL_CONFIG"; else echo '{}'; fi; }

# JSON list of Umbral's (non-hidden) games, in the same shape as cmd_games entries
umbral_games() {
    [[ -s "$UMBRAL_CONFIG" ]] || { echo '[]'; return; }
    local g sizes="" exe kind pfx d
    # size of each game's folder (the .exe's directory); the Battle.net client: its
    # own folder in the prefix (the games it installs are listed on their own)
    # \x1f between fields: with tabs, read would merge the empty .exe of Battle.net
    while IFS=$'\x1f' read -r g exe kind pfx; do
        d=""
        if [[ -n "$exe" && -f "$exe" ]]; then d="$(dirname "$exe")"
        elif [[ -n "$exe" && -d "$exe" ]]; then d="$exe"          # ScummVM: Umbral keeps the game's folder
        elif [[ "$kind" == battlenet && -n "$pfx" ]]; then d="$pfx/drive_c/Program Files (x86)/Battle.net"; fi
        [[ -n "$d" && -d "$d" ]] && sizes+="$g"$'\t'"$(dir_bytes "$d")"$'\n'
    done < <(jq -r '(.prefixes // []) as $px | .games[]? | select(.hidden != true) | . as $g
                    | [.id, (.exe // ""), (.kind // ""), (($px | map(select(.id == $g.prefix_id)) | first // {}).path // "")] | join("\u001f")' "$UMBRAL_CONFIG")
    jq -c --arg sizes "$sizes" '
        ($sizes | split("\n") | map(select(. != "") | split("\t") | {key:.[0], value:(.[1]|tonumber)}) | from_entries) as $sz
        | (.prefixes // []) as $px
        | [.games[]? | select(.hidden != true) | . as $g
           | ($px | map(select(.id == $g.prefix_id)) | first // {}) as $p
           | {key:("umbral:" + .id), source:"umbral", id:.id, name:.name, umbralKind:.kind,
              installdir:(if .exe != "" then (.exe | sub("/[^/]*$"; "")) else "" end), exe:.exe,
              size:($sz[.id] // 0), library:"", launch:"", wrapped:false,
              compat:($p.runner // ""), prefix:(($p.path // "") != ""), prefixPath:($p.path // ""),
              prefixName:($p.name // ""), playtime:(.playtime // 0), lastPlayed:(.last_played // ""),
              cover:(.cover // "")}]' "$UMBRAL_CONFIG"
}

# Umbral ≥ 0.11 writes the games it runs to $XDG_RUNTIME_DIR/umbral/running.json,
# with their exact pids (from the process tree it launched) and each pid's start
# time (field 22 of /proc/<pid>/stat), so a reused pid isn't taken for the game.
UMBRAL_RUNNING="${GAMING_DECK_UMBRAL_RUNNING:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/umbral/running.json}"
pid_starttime() {   # pid → its start time in clock ticks since boot
    local s a
    s="$(cat "${PROC_ROOT:-/proc}/$1/stat" 2>/dev/null)" || return 1
    s="${s##*) }"; read -ra a <<<"$s"     # after "(comm) ": field 3 onwards
    echo "${a[19]}"
}
# the running games from that file, each with a live pid → [{key, pid, proton, started, launchedBy}]
umbral_running_file() {
    [[ -s "$UMBRAL_RUNNING" ]] && jq -e '.version == 1' "$UMBRAL_RUNNING" >/dev/null 2>&1 || return 1
    local id pid st proton started by live x pids rows=()
    while IFS=$'\x1f' read -r id proton started by pids; do
        live=""
        for x in $pids; do
            pid="${x%:*}"; st="${x#*:}"
            [[ "$pid" =~ ^[0-9]+$ && "$(pid_starttime "$pid")" == "$st" ]] && { live="$pid"; break; }
        done
        [[ -n "$live" ]] && rows+=("$(jq -nc --arg k "umbral:$id" --argjson p "$live" --arg pr "$proton" --arg s "$started" --arg b "$by" \
            '{key:$k, pid:$p, proton:($pr | select(. != "")), started:($s | tonumber? // null), launchedBy:$b}')")
    done < <(jq -r '.games[]? | [.id, (.proton // ""), (.started // "" | tostring), (.launched_by // ""),
                     ([(.game_pids // [])[] | "\(.pid):\(.starttime)"] + ["\(.pid):\(.pid_starttime)"] | join(" "))] | join("\u001f")' "$UMBRAL_RUNNING")
    printf '%s\n' "${rows[@]}" | jq -sc 'map(select(. != null))'
}

# Umbral games running now: from Umbral's running.json when there is one;
# older Umbral: a process with the game's .exe as an argument (read in bash —
# no grep/pgrep with the name in its own command line, which would find itself).
umbral_running() {
    local rf; rf="$(umbral_running_file)" && { jq -r '.[] | "\(.key)\t\(.pid)"' <<<"$rf"; return 0; }
    local list f pid a id exe
    list="$(jq -r '.games[]? | select((.exe // "") != "") | [.id, (.exe | split("/") | last)] | @tsv' "$UMBRAL_CONFIG" 2>/dev/null)"
    [[ -n "$list" ]] || return 0
    declare -A want=() found=()
    while IFS=$'\t' read -r id exe; do want["$exe"]="$id"; done <<<"$list"
    for f in "${PROC_ROOT:-/proc}"/[0-9]*/cmdline; do
        pid="${f%/cmdline}"; pid="${pid##*/}"
        while IFS= read -r -d '' a; do
            a="${a##*[/\\]}"
            if [[ -n "${want[$a]:-}" && -z "${found[$a]:-}" ]]; then
                found["$a"]=1; printf 'umbral:%s\t%s\n' "${want[$a]}" "$pid"
            fi
        done < "$f" 2>/dev/null
    done
}

# uopts umbral:<id> — the game's options in Umbral (≥ 0.12: `umbral --get`):
# {options (set on the game), env, effective (used at launch, prefix included), effective_env}
cmd_uopts() {
    local key="$1" out
    [[ "$key" == umbral:* ]] || { err "use: uopts umbral:<id>"; return 2; }
    have umbral || { err "Umbral is not installed"; return 4; }
    out="$(umbral --get "${key#umbral:}" 2>/dev/null)"
    jq -e '.effective' <<<"$out" >/dev/null 2>&1 || { err "this Umbral can't share a game's options (needs 0.12 or newer)"; return 4; }
    jq -c '{options, env, effective, effective_env, prefix}' <<<"$out"
}
# uset umbral:<id> key=value … — change them (all or nothing, checked by Umbral too)
cmd_uset() {
    local key="$1" a out rc; shift
    [[ "$key" == umbral:* && $# -gt 0 ]] || { err "use: uset umbral:<id> key=value …"; return 2; }
    for a in "$@"; do
        [[ "$a" =~ ^([a-z_]+|env\.[A-Za-z_][A-Za-z0-9_]*)=.*$ ]] || { err "not an Umbral option: $a"; return 2; }
    done
    have umbral || { err "Umbral is not installed"; return 4; }
    out="$(umbral --set "${key#umbral:}" "$@" 2>&1)"; rc=$?
    case $rc in
        0) log "✔ Umbral: $*"; history_add "umbral options" umbral "$key" 0 ;;
        *) err "${out:-Umbral refused the change}"; return "$(( rc == 1 ? 3 : 2 ))" ;;
    esac
}

CRISOL="${GAMING_DECK_CRISOL:-crisol}"   # the tests point it elsewhere: this PC may have the real one
# mods steam:<id>|umbral:<id> — the game's mods in Crisol (github.com/madkyp/crisol-app):
# {mods, enabled, profile, applied, pending_changes, updates, layout, loader}; {} without Crisol or that game
cmd_mods() {
    local key="$1"
    [[ "$key" == steam:* || "$key" == umbral:* ]] || { err "use: mods steam:<id>|umbral:<id>"; return 2; }
    have "$CRISOL" || { echo '{}'; return 0; }
    "$CRISOL" --list 2>/dev/null | jq -c --arg k "$key" \
        'first(.[] | select(.key == $k) | {mods, enabled, profile, applied, pending_changes, updates, layout, loader}) // {}' \
        2>/dev/null || echo '{}'
}
# mopen key — open the game's page in Crisol; mplay key — play it with its mods (crisol --play)
cmd_mopen() {
    local key="$1"
    [[ "$key" == steam:* || "$key" == umbral:* ]] || { err "use: mopen steam:<id>|umbral:<id>"; return 2; }
    have "$CRISOL" || { err "Crisol is not installed"; return 4; }
    setsid -f "$CRISOL" --game "$key" >/dev/null 2>&1
    log "▶ Crisol: $(game_label "$key")"
}
cmd_mplay() {
    local key="$1" out
    [[ "$key" == steam:* || "$key" == umbral:* ]] || { err "use: mplay steam:<id>|umbral:<id>"; return 2; }
    have "$CRISOL" || { err "Crisol is not installed"; return 4; }
    out="$("$CRISOL" --play "$key" 2>&1)" || { err "${out:-Crisol could not start the game}"; return 3; }
    log "▶ Playing with mods: $(game_label "$key")"; history_add "play with mods" crisol "$key" 0
}

# gstop umbral:<id> — close a game through Umbral (≥ 0.11), which also ends its wineserver
cmd_gstop() {
    local key="$1"
    [[ "$key" == umbral:* ]] || { err "only Umbral games can be stopped from here (use: gstop umbral:<id>)"; return 2; }
    have umbral || { err "Umbral is not installed"; return 4; }
    umbral --stop "${key#umbral:}" >/dev/null 2>&1
    case $? in
        0) log "■ Closing $(game_label "$key")"; history_add stop umbral "$key" 0 ;;
        1) log "$(game_label "$key") isn't running."; return 3 ;;
        *) err "this Umbral can't stop games (needs 0.11 or newer)"; return 4 ;;
    esac
}

# gplay <key> — start a game from its own launcher
cmd_gplay() {
    local key="$1"
    case "$key" in
        steam:*)
            [[ "${key#steam:}" =~ ^[0-9]+$ ]] || { err "bad Steam key"; return 2; }
            setsid -f steam "steam://rungameid/${key#steam:}" >/dev/null 2>&1 ;;
        umbral:*)
            have umbral || { err "Umbral is not installed"; return 4; }
            umbral_json | jq -e --arg i "${key#umbral:}" 'any(.games[]?; .id == $i)' >/dev/null || { err "Umbral has no game $key"; return 2; }
            setsid -f umbral --launch "${key#umbral:}" >/dev/null 2>&1 ;;
        *) err "use: gplay steam:<appid> | umbral:<id>"; return 2 ;;
    esac
    log "▶ Launching $(game_label "$key")"
    history_add play "${key%%:*}" "$key" 0
}

# --- library -------------------------------------------------------------------
# JSON list of installed games with their profile / launch / Proton state
# a Steam game's artwork from Steam's own cache: <file> → path ("" if none). The
# images sit in librarycache/<appid>/ or a hashed subfolder of it.
steam_art() {   # appid name…
    local d; d="$(steam_root)/appcache/librarycache/$1"; shift
    [[ -d "$d" ]] || return 0
    local n f
    for n in "$@"; do
        f="$(find "$d" -maxdepth 2 -type f -name "$n" 2>/dev/null | head -1)"
        [[ -n "$f" ]] && { echo "$f"; return 0; }
    done
}

cmd_games() {
    local lc cfg id name dir size lib launch compat
    lc="$(steam_localconfig)"; cfg="$(steam_root)/config/config.vdf"
    local profs; profs="$(profiles_json)"
    steam_games | while IFS= read -r id && IFS= read -r name && IFS= read -r dir && IFS= read -r size && IFS= read -r lib; do
        launch=""; [[ -f "$lc" ]] && launch="$(vdf_get "$lc" "$LOCALCONFIG_APPS/$id" LaunchOptions)"
        compat=""; [[ -f "$cfg" ]] && compat="$(vdf_get "$cfg" "$COMPAT_MAPPING/$id" name)"
        printf '%s\n' "$id" "$name" "$dir" "$size" "$lib" "$launch" "$compat" \
            "$([[ -d "$lib/steamapps/compatdata/$id" ]] && echo 1 || echo 0)" \
            "$(steam_art "$id" library_600x900.jpg library_capsule.jpg)" "$(steam_art "$id" library_hero.jpg header.jpg library_header.jpg)" \
            "$(steam_art "$id" logo.png)"
    done | jq -Rn --argjson profs "$profs" --argjson known "$(known_games_json)" '[inputs] as $l | [range(0; $l|length; 11) as $i |
        {key:("steam:" + $l[$i]), source:"steam", id:$l[$i], name:$l[$i+1], installdir:$l[$i+2],
         size:($l[$i+3]|tonumber? // 0), library:$l[$i+4], launch:$l[$i+5],
         wrapped:($l[$i+5] | contains("gaming-deck run")), compat:$l[$i+6], prefix:($l[$i+7] == "1"),
         profile:($profs | has("steam:" + $l[$i])),
         cover:$l[$i+8], hero:$l[$i+9], logo:$l[$i+10],
         new:(($known != null) and (($known | index("steam:" + $l[$i])) == null))}]' \
    | jq -c --argjson u "$(umbral_games)" --argjson known "$(known_games_json)" '
        . + ($u | map(. as $g | $g + {profile:false, new:(($known != null) and (($known | index($g.key)) == null))}))
        | sort_by(.name | ascii_downcase)' \
    | tee >(jq -r '.[].key' | known_games_init)
}

# games already seen by the user (null on the very first run: nothing is "new" then)
KNOWN_GAMES="$GAMING_DIR/known-games.txt"
known_games_json() { if [[ -f "$KNOWN_GAMES" ]]; then jq -Rsc 'split("\n") | map(select(. != ""))' "$KNOWN_GAMES"; else echo null; fi; }
known_games_init() { mkdir -p "$GAMING_DIR"; [[ -f "$KNOWN_GAMES" ]] && { cat >/dev/null; return; }; cat > "$KNOWN_GAMES"; }

# gseen <key> — the user opened this game: it's no longer "new"
cmd_gseen() {
    valid_game_key "$1" || { err "not a game key: $1"; return 2; }
    mkdir -p "$GAMING_DIR"; grep -qxF "$1" "$KNOWN_GAMES" 2>/dev/null || echo "$1" >> "$KNOWN_GAMES"
}

# gtips <appid…> → {"<appid>": number of options RECOMMENDED for this PC}
cmd_gtips() {
    local id
    for id in "$@"; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        printf '%s\n%s\n' "$id" "$(cmd_gsuggest "$id" | jq '[.suggestions[]? | select(.recommended)] | length')"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 2) as $i | {key:$l[$i], value:($l[$i+1]|tonumber)}] | from_entries'
}

# --- status: gamemode, governor, running games ---------------------------------------
# games running now, found through the SteamAppId variable Steam sets
# (one grep over every readable environ; other users' processes are skipped)
running_games() {
    grep -aoH 'SteamAppId=[0-9]\+' "${PROC_ROOT:-/proc}"/[0-9]*/environ 2>/dev/null \
        | sed -E 's|^.*/([0-9]+)/environ:SteamAppId=([0-9]+)$|\2\t\1|' \
        | awk -F'\t' '$1 != 0' | sort -t$'\t' -k1,1 -k2,2n | awk -F'\t' '!seen[$1]++'
}

cmd_gstatus() {
    local gm_inst=false gm_active=false ingroup=false added=false gov drv mmc run
    have gamemoded && gm_inst=true
    [[ $gm_inst == true ]] && gamemoded -s 2>/dev/null | grep -q 'is active' && gm_active=true
    id -nG | tr ' ' '\n' | grep -qx gamemode && ingroup=true
    # in the group database but not in this session yet (needs a new login)
    id -nG "$(id -un)" | tr ' ' '\n' | grep -qx gamemode && added=true
    gov="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)"
    drv="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver 2>/dev/null)"
    mmc="$(cat /proc/sys/vm/max_map_count 2>/dev/null || echo 0)"
    run="$( { running_games | sed 's/^/steam:/'; umbral_running; } | while IFS=$'\t' read -r key pid; do
            printf '%s\n%s\n' "$key" "$pid"; done | jq -Rn '[inputs] as $l | [range(0; $l|length; 2) as $i |
              {key:$l[$i], id:($l[$i] | sub("^[a-z]+:"; "")), pid:($l[$i+1]|tonumber)}]')"
    # details of each running game (uptime, Proton, shaders)
    local r det=() k pid
    while IFS=$'\t' read -r k pid; do
        [[ -n "$k" ]] && det+=("$(gs_running_detail "$k" "$pid" | jq -c --arg k "$k" '. + {key:$k}')")
    done < <(jq -r '.[] | [.key, (.pid | tostring)] | @tsv' <<<"$run")
    run="$(jq -c --argjson d "$(printf '%s\n' "${det[@]}" | jq -sc 'map({(.key): .}) | add // {}')" 'map(. + ($d[.key] // {}))' <<<"$run")"
    jq -n --argjson gi "$gm_inst" --argjson ga "$gm_active" --argjson grp "$ingroup" --argjson add "$added" \
          --arg gov "$gov" --arg drv "$drv" --argjson mmc "${mmc:-0}" --argjson run "$run" \
          --argjson sys "$(gs_system)" --argjson gpu "$(gs_gpu)" --argjson displays "$(gs_displays)" --argjson tools "$(gs_tools)" \
          --argjson library "$(gs_library)" \
          --argjson sched "$(if have scxctl; then cmd_sched_status; else echo null; fi)" \
          --argjson sessions "$(cmd_sessions 8)" --argjson summary "$(session_summary_on && echo true || echo false)" \
          --argjson playing "$(cmd_playing)" \
          --argjson mh "$(have mangohud && echo true || echo false)" \
          --argjson gs "$(have gamescope && echo true || echo false)" \
        '{gamemode:{installed:$gi, active:$ga, ingroup:$grp, pending:($add and ($grp | not))}, governor:$gov, cpufreq_driver:$drv,
          max_map_count:$mmc, max_map_count_ok:($mmc >= 1048576), mangohud:$mh, gamescope:$gs, running:$run,
          system:$sys, gpu:$gpu, displays:$displays, tools:$tools, library:$library, sched:$sched,
          sessions:$sessions, sessionSummary:$summary, playing:$playing}'
}

# join the gamemode group: lets gamemode switch the CPU governor without a
# password (its polkit rule) and allows nice down to -10 (limits.d). One-time.
cmd_gamejoin() {
    getent group gamemode >/dev/null || { err "the gamemode group doesn't exist (install gamemode)"; return 4; }
    id -nG | tr ' ' '\n' | grep -qx gamemode && { log "✔ You are already in the gamemode group."; return 0; }
    if id -nG "$(id -un)" | tr ' ' '\n' | grep -qx gamemode; then
        log "✔ You were already added: log out of your desktop session (or reboot) to activate it."; return 0
    fi
    log "→ pkexec usermod -aG gamemode $USER"
    pkexec usermod -aG gamemode "$USER" || { err "usermod failed"; return 4; }
    log "✔ Added to the gamemode group. Log out and back in for it to take effect."
    history_add "gamemode group" system "$USER" 0
}

# --- ProtonDB --------------------------------------------------------------------
# Only the public per-game summary (tier, score, report count) is used, one
# request per game, cached for a day. Launch-option advice is NOT available
# from it, so the deck never invents any: it links to the game's page.
PROTONDB_API="${GAMING_DECK_PROTONDB_API:-https://www.protondb.com/api/v1/reports/summaries}"
PROTONDB_CACHE="$CACHE_HOME/gaming-deck/protondb"

protondb_one() {
    local id="$1" f="$PROTONDB_CACHE/$1.json" data
    mkdir -p "$PROTONDB_CACHE"
    if [[ -f "$f" ]] && (( $(date +%s) - $(stat -c %Y "$f") < 86400 )); then cat "$f"; return; fi
    if data="$(curl -fsS --max-time 8 -A "gaming-deck (+https://github.com/madkyp/gaming-deck)" "$PROTONDB_API/$id.json" 2>/dev/null)" \
       && jq -e '.tier' <<<"$data" >/dev/null 2>&1; then
        printf '%s' "$data" > "$f"; printf '%s' "$data"
    elif [[ -f "$f" ]]; then cat "$f"                   # stale beats nothing
    else echo '{"tier":"unknown"}'; fi
}

# protondb <appid…> → {"<appid>": {tier, trendingTier, score, total, confidence}}
cmd_protondb() {
    local id
    for id in "$@"; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        printf '%s\n%s\n' "$id" "$(protondb_one "$id" | jq -c .)"
    done | jq -Rn '[inputs] as $l | [range(0; $l|length; 2) as $i | {key:$l[$i], value:($l[$i+1]|fromjson)}] | from_entries'
}

# --- launch-option suggestions from ProtonDB's open data -------------------------
# ProtonDB publishes monthly dumps of every report (github.com/bdefore/protondb-data,
# ODbL). `pdbindex update` streams the newest one — never unpacked to disk, a few
# MB of RAM — into a small local index of the reports that list launch options,
# for EVERY game, so a game installed later gets suggestions without another
# download. `gsuggest` turns that into per-game statistics; nothing is applied
# automatically.
PDB_REPO_API="${GAMING_DECK_PDB_REPO_API:-https://api.github.com/repos/bdefore/protondb-data/contents/reports}"
PDB_RAW="${GAMING_DECK_PDB_RAW:-https://raw.githubusercontent.com/bdefore/protondb-data/master/reports}"
PDB_INDEX="$PROTONDB_CACHE/launch-index.jsonl"
PDB_META="$PROTONDB_CACHE/launch-index.meta"

# jq: GPU model string → "vendor:generation" (an ordinal, so "±1 generation" is
# a simple difference). GTX 16 = Turing like RTX 20; Steam Deck = RDNA2 like RX 6000.
JQ_GPU_GEN='def gpu_gen: ascii_downcase
    | if test("(rtx|gtx|gt|mx)\\s*-?\\s*[0-9]{3,4}") then
        (capture("(?:rtx|gtx|gt|mx)\\s*-?\\s*(?<n>[0-9]{3,4})").n | tonumber) as $n
        | ({"7":0,"9":1,"10":2,"16":3,"20":3,"30":4,"40":5,"50":6}[($n / 100 | floor | tostring)]) as $o
        | if $o == null then "" else "nvidia:\($o)" end
      elif test("rx\\s*[0-9]{4}") then
        ({"5":2,"6":3,"7":4,"9":5}[capture("rx\\s*(?<n>[0-9])[0-9]{3}").n]) as $o
        | if $o == null then "" else "amd:\($o)" end
      elif test("rx\\s*[0-9]{3}") then "amd:0"
      elif test("vega") then "amd:1"
      elif test("steam deck|vangogh|van gogh") then "amd:3"
      elif test("arc") then "intel:1"
      else "" end;'

# "reports_sep1_2026.tar.gz" → epoch of that date
pdb_dump_epoch() {
    local n="${1#reports_}"; n="${n%.tar.gz}"
    [[ "$n" =~ ^([a-z]+)([0-9]+)_([0-9]{4})$ ]] || { echo 0; return; }
    date -d "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}" +%s 2>/dev/null || echo 0
}

pdb_latest_dump() {
    local n best="" bestt=0 t
    while IFS= read -r n; do
        t="$(pdb_dump_epoch "$n")"; (( t > bestt )) && { best="$n"; bestt=$t; }
    done < <(curl -fsS --max-time 15 -H 'Accept: application/vnd.github+json' "$PDB_REPO_API" | jq -r '.[].name' 2>/dev/null)
    [[ -n "$best" ]] && echo "$best"
}

# the GPU vendor games will run on (a discrete NVIDIA/AMD card wins over Intel)
gpu_vendor() {
    [[ -n "${GAMING_DECK_GPU_VENDOR:-}" ]] && { echo "$GAMING_DECK_GPU_VENDOR"; return; }
    local v all=""
    for v in /sys/class/drm/card[0-9]*/device/vendor; do [[ -f "$v" ]] && all+=" $(cat "$v")"; done
    case "$all" in
        *0x10de*) echo nvidia ;; *0x1002*) echo amd ;; *0x8086*) echo intel ;; *) echo "" ;;
    esac
}

# name of the GPU games run on (nvidia-smi, else lspci)
gpu_name() {
    [[ -n "${GAMING_DECK_GPU_NAME:-}" ]] && { echo "$GAMING_DECK_GPU_NAME"; return; }
    have nvidia-smi && nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 && return
    lspci -mm 2>/dev/null | grep -E '"(VGA|3D|Display)' | sed -E 's/^[^"]*"[^"]*" "([^"]*)" "([^"]*)".*/\1 \2/' \
        | sort -r | head -1
}
# focused monitor resolution "WxH" (Hyprland), empty if unknown
screen_res() {
    [[ -n "${GAMING_DECK_SCREEN+set}" ]] && { echo "$GAMING_DECK_SCREEN"; return; }   # set, even empty = override
    have hyprctl && hyprctl monitors -j 2>/dev/null | jq -r 'map(select(.focused)) | first // empty | "\(.width)x\(.height)"'
}

# focused monitor refresh rate (rounded Hz), empty if unknown
screen_hz() {
    [[ -n "${GAMING_DECK_SCREEN_HZ+set}" ]] && { echo "$GAMING_DECK_SCREEN_HZ"; return; }
    have hyprctl && hyprctl monitors -j 2>/dev/null | jq -r 'map(select(.focused)) | first // empty | .refreshRate | round'
}

cmd_pdbindex() {
    case "${1:-status}" in
        update)
            local dump url tmp n
            dump="${GAMING_DECK_PDB_DUMP:-$(pdb_latest_dump)}"
            [[ -n "$dump" ]] || { err "could not list ProtonDB's data dumps on GitHub"; return 4; }
            if [[ -f "$PDB_META" && "$(sed -n 's/^DUMP=//p' "$PDB_META")" == "$dump" && "$2" != --force ]]; then
                log "✔ The index is already built from $dump."; return 0
            fi
            mkdir -p "$PROTONDB_CACHE"; tmp="$PDB_INDEX.tmp"
            url="$PDB_RAW/$dump"
            log "→ Downloading and indexing $dump (about 70 MB, ~1 min)…"
            # stream: download → gunzip/untar → one report at a time
            if ! curl -fsSL --max-time 900 "$url" | tar xzO | jq -cn --stream "$JQ_GPU_GEN"'
                    fromstream(1 | truncate_stream(inputs))
                    | select((.responses.launchOptions? // "") | length > 0)
                    | [(.app.steam.appId // ""), (.timestamp // 0), (.responses.verdict // ""),
                       ((.systemInfo.gpu // "") | ascii_downcase
                        | if test("nvidia|geforce|rtx|gtx|quadro") then "nvidia"
                          elif test("amd|radeon|\\brx ") then "amd" elif test("intel") then "intel" else "" end),
                       .responses.launchOptions, ((.systemInfo.gpu // "") | gpu_gen)]' > "$tmp"; then
                rm -f "$tmp"; err "download or indexing failed"; return 4
            fi
            n="$(wc -l < "$tmp")"
            (( n > 0 )) || { rm -f "$tmp"; err "the dump had no usable reports"; return 4; }
            mv -f "$tmp" "$PDB_INDEX"
            printf 'DUMP=%s\nDATE=%s\nBUILT=%s\nREPORTS=%s\nGAMES=%s\n' "$dump" "$(pdb_dump_epoch "$dump")" \
                "$(date +%s)" "$n" "$(cut -d'"' -f2 "$PDB_INDEX" | sort -u | wc -l)" > "$PDB_META"
            log "✔ Indexed $n reports with launch options ($(sed -n 's/^GAMES=//p' "$PDB_META") games). Data: ProtonDB, ODbL."
            history_add "protondb data" steam "$dump" 0 ;;
        status)
            if [[ -f "$PDB_META" && -s "$PDB_INDEX" ]]; then
                jq -n --arg d "$(sed -n 's/^DUMP=//p' "$PDB_META")" --argjson t "$(sed -n 's/^DATE=//p' "$PDB_META")" \
                      --argjson r "$(sed -n 's/^REPORTS=//p' "$PDB_META")" --argjson g "$(sed -n 's/^GAMES=//p' "$PDB_META")" \
                      --argjson now "$(date +%s)" \
                    '{present:true, dump:$d, date:($t | strftime("%Y-%m-%d")), reports:$r, games:$g,
                      stale:(($now - $t) > 35 * 86400)}'
            else echo '{"present":false}'; fi ;;
        *) err "use: pdbindex update [--force] | status"; return 2 ;;
    esac
}

# gsuggest <appid> — what players who say the game works put in their launch options
# what each suggested option does, for the hover text (the name before "="; _kind = fallback)
SUG_WHAT="$(cat <<'EOF'
{
  "PROTON_FSR4_UPGRADE": "Replaces the game's FSR 3.1 with FSR 4 (much sharper upscaling). Needs a Radeon RX 9000 (RDNA 4) and a Proton that supports it (GE, CachyOS).",
  "PROTON_FSR4_RDNA3_UPGRADE": "FSR 4 on a Radeon RX 7000 (RDNA 3) through a slower emulated path. Not needed on an RX 9000.",
  "PROTON_ENABLE_WAYLAND": "Runs the game as a native Wayland window instead of through XWayland: can lower latency and fix scaling; some games, overlays or launchers don't like it.",
  "PROTON_ENABLE_HDR": "Lets the game output HDR. Needs an HDR monitor and Wayland (PROTON_ENABLE_WAYLAND) or gamescope.",
  "DXVK_HDR": "Lets DirectX games running through DXVK see HDR. Needs an HDR monitor and Wayland or gamescope.",
  "ENABLE_HDR_WSI": "Turns on the Vulkan HDR layer (vk-hdr-layer) so HDR works on a Wayland desktop without gamescope.",
  "SteamDeck": "Makes the game believe it runs on a Steam Deck: some games then pick Deck settings, a controller layout or skip their launcher.",
  "MANGOHUD": "Shows the MangoHud overlay (FPS, frame time, temperatures) in the game.",
  "PROTON_USE_NTSYNC": "Uses the kernel's NTSYNC driver for Windows-style synchronisation: smoother frame times in some games. Needs a kernel with /dev/ntsync.",
  "PROTON_NO_ESYNC": "Turns esync off: a fallback for games that hang or crash with it.",
  "PROTON_NO_FSYNC": "Turns fsync off: a fallback for games that hang or crash with it.",
  "PROTON_USE_SDL": "Proton reads controllers through SDL instead of its own code: fixes some controllers that aren't detected or are mapped wrong.",
  "PROTON_USE_WINED3D": "Draws DirectX through OpenGL (WineD3D) instead of Vulkan: a fallback for old games with graphics glitches; usually slower.",
  "STAGING_SHARED_MEMORY": "A Wine-staging memory option that lowers CPU overhead in some games.",
  "STAGING_WRITE_COPY": "A Wine-staging memory option some games or anti-cheats need to start.",
  "VKD3D_CONFIG": "Options for VKD3D-Proton (DirectX 12 → Vulkan), e.g. dxr to turn ray tracing on.",
  "VKD3D_FEATURE_LEVEL": "Which DirectX 12 feature level is reported to the game: for games that refuse to start without a newer one.",
  "VKD3D_SHADER_MODEL": "Which DirectX 12 shader model is reported to the game: for games that check for a newer one.",
  "WINE_CPU_TOPOLOGY": "How many CPU cores the game sees: fixes games that stutter or crash with many cores.",
  "RADV_PERFTEST": "Experimental options of the AMD Vulkan driver (RADV): can help a game or make it worse.",
  "__GL_SHADER_DISK_CACHE_SIZE": "Size of the NVIDIA shader cache: a bigger one means less stutter from recompiling shaders.",
  "DXVK_ASYNC": "Compiles shaders in the background (older DXVK forks only): less stutter, possible brief glitches.",
  "gamemoderun": "GameMode: raises CPU priority and switches to the performance governor while you play.",
  "mangohud": "Shows the MangoHud overlay (FPS, frame time, temperatures) in the game.",
  "game-performance": "CachyOS script: switches the power profile to performance while the game runs.",
  "gamescope": "Valve's compositor around the game: fixed resolution, upscaling, FPS limit or HDR; adds a little latency.",
  "taskset": "Pins the game to some CPU cores only: for games that run badly on many cores.",
  "env": "Only sets variables before the game starts (the variables are the useful part).",
  "er-patcher": "Elden Ring tool (installed separately) that removes the 60 FPS cap and adds ultrawide and camera options.",
  "python": "Starts a Python script before the game (e.g. a game patcher): only useful if you have that script.",
  "-dx12": "Makes the game use DirectX 12.",
  "-dx11": "Makes the game use DirectX 11: sometimes more stable or faster under Proton.",
  "-devmode": "The game's developer mode (in Kingdom Come: the developer console).",
  "-skipintro": "Skips the intro videos.",
  "_env": "An environment variable for Proton, the driver or the game.",
  "_arg": "A launch option passed to the game itself: what it does depends on the game.",
  "_wrapper": "A program that starts the game (a launcher, tool or script)."
}
EOF
)"
cmd_gsuggest() {
    local id="$1" vendor since
    [[ "$id" =~ ^[0-9]+$ ]] || { err "use: gsuggest <appid>"; return 2; }
    [[ -s "$PDB_INDEX" ]] || { echo '{"index":false}'; return 0; }
    local gen cores res
    vendor="$(gpu_vendor)"; since=$(( $(date +%s) - 3 * 365 * 86400 ))
    local gname; gname="$(gpu_name)"
    gen="$(jq -Rr "$JQ_GPU_GEN"' gpu_gen' <<<"$gname")"
    cores="$(nproc 2>/dev/null || echo 0)"; res="$(screen_res)"; local hz; hz="$(screen_hz)"
    grep -F "[\"$id\"," "$PDB_INDEX" | jq -sc --arg v "$vendor" --argjson since "$since" --argjson what "$SUG_WHAT" \
        --arg gen "$gen" --arg gname "$gname" --argjson cores "${cores:-0}" --arg res "$res" --arg hz "$hz" '
        # hardware-dependent values are grouped and rewritten for this PC
        def adapt:
            ($res | split("x")) as $wh |
            if test("^-(threads|numthreads) [0-9]+$") then
                (if $cores > 0 then {key:"-threads #", token:("-" + (capture("^-(?<f>[a-z]+)").f) + " \($cores)"), adapted:true} else null end)
            elif test("^-(w|width|screen-width) [0-9]+$") then
                (if ($wh | length) == 2 then {key:"-w #", token:((split(" ")[0]) + " " + $wh[0]), adapted:true} else null end)
            elif test("^-(h|height|screen-height) [0-9]+$") then
                (if ($wh | length) == 2 then {key:"-h #", token:((split(" ")[0]) + " " + $wh[1]), adapted:true} else null end)
            elif test("^[-+](fps_max|fpsmax|maxfps|fps-max) [0-9]+$") then
                (if $hz != "" then {key:((split(" ")[0]) + " #"), token:((split(" ")[0]) + " " + $hz), adapted:true}
                 else {key:((split(" ")[0]) + " #"), token:., adapted:false} end)
            elif test("^[-+][A-Za-z0-9_]+ [0-9.]+$") then
                # same option, different numbers: grouped, the most common value is shown
                {key:((split(" ")[0]) + " #"), token:., adapted:false}
            else {key:., token:., adapted:false} end;
        # "RTX 20 / GTX 16 ±1" style label of the generations counted as similar
        def gen_label:
            if . == "" then "" else
            (split(":")[0]) as $vd | (split(":")[1] | tonumber) as $o
            | ({nvidia:["GTX 700","GTX 900","GTX 10","RTX 20 / GTX 16","RTX 30","RTX 40","RTX 50"],
                amd:["RX 400/500","Vega","RX 5000","RX 6000","RX 7000","RX 9000"], intel:["","Arc"]}[$vd] // []) as $names
            | [range([$o - 1, 0] | max; [$o + 2, ($names | length)] | min) | $names[.]] | map(select(. != "")) | join(", ")
            end;
        def similar($g): ($gen != "" and $g != null and $g != "")
            and (($g | split(":")[0]) == ($gen | split(":")[0]))
            and ((($g | split(":")[1] | tonumber) - ($gen | split(":")[1] | tonumber)) | fabs <= 1);
        def vendor_of: if test("^(RADV_|AMD_|ACO_|RADEONSI|ENABLE_LAYER_MESA|MESA_)") then "amd"
                       elif test("^(__GL_|__NV|PROTON_ENABLE_NVAPI|DXVK_ENABLE_NVAPI|PROTON_ENABLE_NGX|DXVK_NVAPI)") then "nvidia"
                       else null end;
        # one report → unique suggestion tokens: env VAR=value, wrapper, argument (+cvar value / -flag value)
        def tokens:
            [scan("(?:[^\\s\"]+|\"[^\"]*\")+")] as $t
            | ($t | index("%command%")) as $c
            | (if $c == null then [] else $t[:$c] end) as $pre
            | (if $c == null then $t else $t[$c+1:] end) as $post
            | ([$pre[] | select(test("^[A-Za-z_][A-Za-z0-9_]*="))
                 | gsub("\""; "") | {token:., kind:"env", vendor:(vendor_of)}]
               + [$pre[] | select(test("^[a-z][a-z0-9_.-]*$") and (test("^[0-9.]+$") | not))
                 | {token:., kind:"wrapper", vendor:null}]
               + [foreach range(0; $post | length) as $i ({skip:false, out:null};
                     if .skip then {skip:false, out:null}
                     else ($post[$i]) as $a | ($post[$i+1] // null) as $b
                        | if ($a | test("^[-+]")) then
                            (if $b != null and ($b | test("^[-+]") | not) then {skip:true, out:($a + " " + $b)}
                             else {skip:false, out:$a} end)
                          else {skip:false, out:null} end
                     end; .out) | select(. != null) | {token:., kind:"arg", vendor:null}])
            | map(select(.token | test("[/~$`;|&<>]") | not))
            | map(. as $x | ($x.token | adapt) as $a | select($a != null) | $x + $a)
            | unique_by(.key);
        map(select(.[2] == "yes")) as $works
        | ($works | map(select(.[1] >= $since))) as $recent
        | (if ($recent | length) >= 8 then {r:$recent, window:"3y"} else {r:$works, window:"all"} end) as $w
        | ($w.r | length) as $n
        | ($w.r | map(select(.[3] == $v)) | length) as $nv
        | ($w.r | map(select(similar(.[5]))) | length) as $ns
        | [$w.r[] | .[3] as $gpu | .[5] as $g | (.[4] | tokens[]) | . + {gpu:$gpu, sim:similar($g)}]
        | group_by(.key)
        | map({token:(group_by(.token) | max_by(length) | .[0].token), key:.[0].key, adapted:.[0].adapted,
               kind:.[0].kind, vendor:.[0].vendor, count:length,
               share:((length * 100 / ([$n,1]|max)) | floor),
               vcount:(map(select(.gpu == $v)) | length), scount:(map(select(.sim)) | length)}
              | .vshare = (if $nv > 0 then (.vcount * 100 / $nv | floor) else null end)
              | .sshare = (if $ns >= 5 then (.scount * 100 / $ns | floor) else null end))
        # judged within the players whose hardware is closest to this PC:
        # same GPU generation (±1) when there are enough of them, else same vendor
        | map(. + (if .sshare != null then {basis:"similar", pct:.sshare, n:.scount}
                   elif .vshare != null then {basis:"vendor", pct:.vshare, n:.vcount}
                   else {basis:"all", pct:.share, n:.count} end))
        | map(select(.count >= 2 and .pct >= 5))
        | map(. + {foryou:(.vendor == null or .vendor == $v)})
        # env vars: share of those players who do not set the variable at all
        # (i.e. keep the default) — "not setting it" is a choice too
        | map(if .kind == "env" then
                (.token | split("=")[0]) as $var
                | ((if .basis == "similar" then [$w.r[] | select(similar(.[5]))]
                    elif .basis == "vendor" then [$w.r[] | select(.[3] == $v)] else $w.r end)) as $c
                | . + {var:$var, unset:(([$c[] | select(.[4] | test("(^|\\s)" + $var + "=") | not)] | length) * 100 / ([$c | length, 1] | max) | floor)}
              else . end)
        # RECOMMENDED: ≥ 20 % of those players use it (at least 5 reports); an env var
        # must also be set by more players than leave it at its default
        | map(. + {recommended:(.foryou and .pct >= 20 and .n >= 5 and (.kind != "env" or .pct > .unset))})
        | sort_by(-(if .foryou then 1 else 0 end), -(if .recommended then 1 else 0 end), -.pct, -.count)
        | {index:true, vendor:$v, gpuGen:$gen, gpuName:$gname, similarLabel:($gen | gen_label),
           cores:$cores, screen:$res, window:$w.window,
           reports:$n, vendorReports:$nv, similarReports:(if $ns >= 5 then $ns else 0 end),
           suggestions:(.[:16] | map(. + {what:($what[.token | split("=")[0]] // $what["_" + .kind] // "")}))}'
}

# --- shader caches -----------------------------------------------------------------
# Per game, Steam keeps steamapps/shadercache/<appid>/ with:
#   fozpipelinesv6/   Fossilize recordings of the game's pipelines — driver-independent,
#                     Steam compiles them ahead of time ("shader pre-caching")
#   nvidiav1/, mesa_shader_cache*/  the driver's compiled cache — tied to the driver
#                     version, useless after a driver update until rebuilt
#   DXVK_state_cache/  (DXVK < 2.0), transcoded_video.foz / fozmediav1/ (videos, not shaders)
# Globally the drivers keep ~/.cache/nvidia/GLCache and ~/.cache/mesa_shader_cache*.
DRIVER_PKG_RE='^(lib32-)?(nvidia(-[0-9]+xx)?-utils|nvidia-open-dkms|mesa|vulkan-(radeon|intel|nouveau)|amdvlk)$'

driver_pkgs() { pacman -Q 2>/dev/null | awk -v re="$DRIVER_PKG_RE" '$1 ~ re'; }

# last time pacman installed/upgraded a driver package (epoch, 0 if never logged)
last_driver_update() {
    local l
    l="$(grep -E '\[ALPM\] (upgraded|installed|downgraded|reinstalled) ' "$PACMAN_LOG" 2>/dev/null \
         | awk -v re="$DRIVER_PKG_RE" '{ if ($4 ~ re) last = $0 } END { print last }')"
    l="${l#\[}"; l="${l%%\]*}"
    [[ -n "$l" ]] && date -d "$l" +%s 2>/dev/null || echo 0
}

# which part of a shadercache entry is what
shader_part() {
    case "$1" in
        fozpipelines*) echo pipelines ;;
        nvidiav1|mesa_shader_cache*|radv*) echo driver ;;
        DXVK_state_cache*|*.dxvk-cache) echo dxvk ;;
        fozmedia*|transcoded_video*) echo video ;;
        *) echo other ;;
    esac
}

# a driver cache is stale when nothing in it was written after the last driver update
cache_stale() {   # dir since
    [[ -d "$1" && "$2" -gt 0 ]] || return 1
    [[ -z "$(find "$1" -type f -newermt "@$2" -print -quit 2>/dev/null)" ]] \
        && [[ -n "$(find "$1" -type f -print -quit 2>/dev/null)" ]]
}

# Steam compiling shaders in the background (the process name is truncated to 15 chars)
steam_processing_shaders() { pgrep -x fossilize_repla >/dev/null 2>&1; }

global_shader_caches() {   # id<TAB>label<TAB>path
    printf '%s\t%s\t%s\n' nvidia "NVIDIA driver (OpenGL/Vulkan)" "$CACHE_HOME/nvidia/GLCache" \
        nvidia-legacy "NVIDIA driver (old location)" "$HOME/.nv/GLCache" \
        mesa "Mesa (AMD/Intel)" "$CACHE_HOME/mesa_shader_cache" \
        mesa-db "Mesa single-file cache" "$CACHE_HOME/mesa_shader_cache_db"
}

cmd_shadercache() {
    local since lib d id name part f bytes installed running
    since="$(last_driver_update)"
    running="$(running_games | cut -f1)"
    local games; games="$(steam_games | awk 'NR % 5 == 1 { id = $0 } NR % 5 == 2 { print id "\t" $0 }')"
    {
        while IFS= read -r lib; do
            for d in "$lib"/steamapps/shadercache/*/; do
                d="${d%/}"; id="${d##*/}"; [[ "$id" =~ ^[0-9]+$ ]] || continue
                name="$(awk -F'\t' -v i="$id" '$1 == i { print $2; exit }' <<<"$games")"
                installed=0; [[ -n "$name" ]] && installed=1
                [[ -z "$name" ]] && name="$(vdf_get "$lib/steamapps/appmanifest_$id.acf" AppState name 2>/dev/null)"
                local p_pipe=0 p_drv=0 p_dxvk=0 p_vid=0 p_oth=0 st=0
                for f in "$d"/* "$d"/.[!.]*; do
                    [[ -e "$f" ]] || continue
                    bytes="$(dir_bytes "$f")"; part="$(shader_part "${f##*/}")"
                    case "$part" in
                        pipelines) p_pipe=$(( p_pipe + bytes )) ;;
                        driver) p_drv=$(( p_drv + bytes )); cache_stale "$f" "$since" && st=1 ;;
                        dxvk) p_dxvk=$(( p_dxvk + bytes )) ;;
                        video) p_vid=$(( p_vid + bytes )) ;;
                        *) p_oth=$(( p_oth + bytes )) ;;
                    esac
                done
                printf 'game\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "${name:-}" "$installed" "$d" \
                    "$p_pipe" "$p_drv" "$p_dxvk" "$p_vid" "$p_oth" "$st" \
                    "$(grep -qx "$id" <<<"$running" && echo 1 || echo 0)"
            done
        done < <(steam_libs)
        local gid label path
        while IFS=$'\t' read -r gid label path; do
            [[ -d "$path" ]] || continue
            st=0; cache_stale "$path" "$since" && st=1
            printf 'global\t%s\t%s\t%s\t%s\t%s\n' "$gid" "$label" "$path" "$(dir_bytes "$path")" "$st"
        done < <(global_shader_caches)
    } | jq -Rn --argjson since "$since" --arg drivers "$(driver_pkgs)" \
          --argjson busy "$(steam_processing_shaders && echo true || echo false)" '
        [inputs | split("\t")] as $rows
        | {lastDriverUpdate:$since, drivers:($drivers | split("\n") | map(select(. != "") | split(" ") | {name:.[0], version:.[1]})),
           steamProcessing:$busy,
           games:[$rows[] | select(.[0] == "game") |
                  {id:.[1], name:.[2], installed:(.[3] == "1"), path:.[4],
                   pipelines:(.[5]|tonumber), driver:(.[6]|tonumber), dxvk:(.[7]|tonumber), video:(.[8]|tonumber),
                   other:(.[9]|tonumber), stale:(.[10] == "1"), running:(.[11] == "1")}
                  | .total = (.pipelines + .driver + .dxvk + .video + .other)] | sort_by(-.total),
           global:[$rows[] | select(.[0] == "global") | {id:.[1], label:.[2], path:.[3], size:(.[4]|tonumber), stale:(.[5] == "1")}]}
        | .staleBytes = ([.games[] | select(.stale) | .driver] + [.global[] | select(.stale) | .size] | add // 0)
        | .orphanBytes = ([.games[] | select(.installed | not) | .total] | add // 0)'
}

# empty a directory (keep it: Steam/driver expect it) and report
empty_dir() {
    local d="$1" b; [[ -d "$d" ]] || return 0
    b="$(dir_bytes "$d")"
    find "$d" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && echo "$b"
}

# shaderclean steam:<appid> [driver|all] | orphans | stale | global:<id>
cmd_shaderclean() {
    local target="$1" part="${2:-driver}" info freed=0 b d id gid f
    info="$(cmd_shadercache)"
    if [[ "$target" != global:* ]] && steam_processing_shaders; then
        err "Steam is processing shaders right now (fossilize_replay): try again when it finishes"; return 3
    fi
    case "$target" in
        steam:*)
            id="${target#steam:}"; [[ "$id" =~ ^[0-9]+$ ]] || { err "bad app id"; return 2; }
            d="$(jq -r --arg i "$id" '.games[] | select(.id == $i) | .path' <<<"$info")"
            [[ -n "$d" ]] || { err "no shader cache for $id"; return 4; }
            [[ "$(jq -r --arg i "$id" '.games[] | select(.id == $i) | .running' <<<"$info")" == true ]] \
                && { err "the game is running: close it first"; return 3; }
            case "$part" in
                driver) for f in "$d"/*; do
                            [[ "$(shader_part "${f##*/}")" == driver ]] || continue
                            b="$(empty_dir "$f")"; freed=$(( freed + ${b:-0} ))
                        done ;;
                all)    b="$(dir_bytes "$d")"; find "$d" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; freed=${b:-0} ;;
                *) err "part must be driver or all"; return 2 ;;
            esac ;;
        orphans)
            while IFS= read -r d; do
                [[ -n "$d" ]] || continue
                b="$(dir_bytes "$d")"; rm -rf -- "$d" && freed=$(( freed + b )) && log "→ removed ${d##*/}"
            done < <(jq -r '.games[] | select(.installed | not) | .path' <<<"$info") ;;
        stale)
            [[ -n "$(running_games)" ]] && { err "a game is running: close it first"; return 3; }
            while IFS= read -r d; do
                for f in "$d"/*; do
                    [[ "$(shader_part "${f##*/}")" == driver ]] || continue
                    b="$(empty_dir "$f")"; freed=$(( freed + ${b:-0} ))
                done
            done < <(jq -r '.games[] | select(.stale) | .path' <<<"$info")
            while IFS= read -r d; do
                b="$(empty_dir "$d")"; freed=$(( freed + ${b:-0} ))
            done < <(jq -r '.global[] | select(.stale) | .path' <<<"$info") ;;
        global:*)
            gid="${target#global:}"
            d="$(jq -r --arg g "$gid" '.global[] | select(.id == $g) | .path' <<<"$info")"
            [[ -n "$d" ]] || { err "no such cache: $gid"; return 2; }
            [[ -n "$(running_games)" ]] && { err "a game is running: close it first"; return 3; }
            b="$(empty_dir "$d")"; freed=${b:-0} ;;
        *) err "use: shaderclean steam:<appid> [driver|all] | orphans | stale | global:<id>"; return 2 ;;
    esac
    log "✔ Freed $(human "$freed"). The first launches rebuild what's needed (some stutter is expected)."
    history_add "shader cache clean" gaming "$target${2:+ $2}" 0
}

# --- A/B benchmark ----------------------------------------------------------------
# Two launch variants of the same game, each run once through the wrapper with
# MangoHud logging every frame; the per-frame CSV (verified format, MangoHud
# 0.8.x: 2 system-info lines, a column header, one row per frame with
# frametime in ms) is turned into avg FPS, 1 % / 0.1 % lows and frametimes.
# MangoHud's own *_summary.csv is ignored: its values are unreliable.
BENCH_DIR="$GAMING_DIR/bench"
BENCH_ARMED="$BENCH_DIR/armed"            # key<TAB>variant<TAB>epoch — one launch only

bench_path() { echo "$BENCH_DIR/${1//:/_}"; }
bench_cfg() {
    local f; f="$(bench_path "$1")/config.json"
    if [[ -s "$f" ]]; then cat "$f"
    else echo '{"duration":60,"delay":15,"A":{"label":"A"},"B":{"label":"B"}}'; fi
}

# frame stats of one MangoHud per-frame CSV → JSON
bench_stats() {
    local f="$1"
    [[ -s "$f" ]] || { echo null; return; }
    awk -F, 'NR == 3 { for (i = 1; i <= NF; i++) col[$i] = i; next }
             NR > 3 && col["frametime"] { print $(col["frametime"]) "\t" $(col["cpu_load"]) "\t" $(col["gpu_load"]) "\t" $(col["gpu_temp"]) "\t" $(col["cpu_temp"]) }' "$f" |
    # frames over 5 s are pauses/loading (or MangoHud glitches), not performance
    jq -Rsc 'split("\n") | map(select(. != "") | split("\t") | map(tonumber? // 0)) | map(select(.[0] > 0 and .[0] < 5000)) as $r
        | if ($r | length) < 10 then null else
          ($r | map(.[0])) as $ft | ($ft | length) as $n | ($ft | add / $n) as $avg
          | ($ft | sort) as $asc | ($asc | reverse) as $desc
          | def lowavg($p): ([($n * $p | ceil), 1] | max) as $k | 1000 / ($desc[:$k] | add / $k);
          {frames:$n, seconds:(($ft | add) / 1000 | floor),
           avgFps:(1000 / $avg * 10 | round / 10), low1:(lowavg(0.01) * 10 | round / 10), low01:(lowavg(0.001) * 10 | round / 10),
           p99ms:($asc[(($n - 1) * 0.99 | floor)] * 100 | round / 100), maxms:($desc[0] * 100 | round / 100),
           spikes:([$ft[] | select(. > $avg * 2.5)] | length),
           cpuLoad:(($r | map(.[1]) | add / $n) | round), gpuLoad:(($r | map(.[2]) | add / $n) | round),
           gpuTempMax:($r | map(.[3]) | max), cpuTempMax:($r | map(.[4]) | max),
           # frametime curve for the chart: ≤ 240 buckets, worst frame of each (keeps stutter visible)
           series:(([($n / 240 | ceil), 1] | max) as $b | [range(0; $n; $b) as $i | $ft[$i:$i+$b] | max * 100 | round / 100])}
          end'
}

# newest per-frame log of a variant (MangoHud names it <exe>_<date>.csv)
bench_log() {
    local f best="" bt=0 t
    for f in "$(bench_path "$1")/$2"/*.csv; do
        [[ -f "$f" && "$f" != *_summary.csv ]] || continue
        t="$(stat -c %Y "$f")"; (( t >= bt )) && { best="$f"; bt=$t; }
    done
    [[ -n "$best" ]] && echo "$best"
}

bench_get() {
    local key="$1" a b
    a="$(bench_stats "$(bench_log "$key" A)")"; b="$(bench_stats "$(bench_log "$key" B)")"
    bench_cfg "$key" | jq -c --argjson a "$a" --argjson b "$b" '. + {results:{A:$a, B:$b}}
        | if $a != null and $b != null then .compare = {
            avgFps:((($b.avgFps - $a.avgFps) / $a.avgFps * 1000 | round) / 10),
            low1:((($b.low1 - $a.low1) / $a.low1 * 1000 | round) / 10),
            p99ms:((($b.p99ms - $a.p99ms) / $a.p99ms * 1000 | round) / 10)} else . end'
}

# cmd_run hook: if a benchmark launch is armed for this game, overlay the
# variant on the profile, force MangoHud logging into the variant's folder,
# and disarm (a normal launch afterwards is untouched)
bench_overlay() {   # key profile-json → profile-json (+ .mangohudConfig for the wrapper to export)
    local key="$1" p="$2" akey variant when cfg dir
    [[ -f "$BENCH_ARMED" ]] || { echo "$p"; return; }
    IFS=$'\t' read -r akey variant when < "$BENCH_ARMED"
    if [[ "$akey" != "$key" ]] || (( $(date +%s) - ${when:-0} > 1800 )); then echo "$p"; return; fi
    rm -f "$BENCH_ARMED"
    cfg="$(bench_cfg "$key")"; dir="$(bench_path "$key")/$variant"
    mkdir -p "$dir"; find "$dir" -name '*.csv' -delete
    local mhc
    mhc="output_folder=$dir,autostart_log=$(jq -r '.delay' <<<"$cfg"),log_duration=$(jq -r '.duration' <<<"$cfg"),log_interval=0"
    echo "  benchmark $variant armed → $dir" >> "$STATE_DIR/logs/run.log"
    jq -c --arg mhc "$mhc" --argjson v "$(jq -c --arg x "$variant" '.[$x] // {}' <<<"$cfg")" '
        . + {mangohud:true, mangohudConfig:$mhc}
        + (if ($v.gamemode // "") != "" then {gamemode:($v.gamemode == "true")} else {} end)
        + (if ($v.args // "") != "" then {args:$v.args} else {} end)
        + (if ($v.prefix // "") != "" then {prefix:$v.prefix} else {} end)
        + {env:(.env + ($v.env // "" | split(" ") | map(select(test("^[A-Za-z_][A-Za-z0-9_]*=")) | {key:split("=")[0], value:(split("=")[1:] | join("="))}) | from_entries))}' <<<"$p"
}

# bench get|set|run|restore|clear <key> …
cmd_bench() {
    local sub="$1" key="$2"; shift 2 2>/dev/null
    [[ "$key" =~ ^steam:[0-9]+$ ]] || { err "use: bench get|set|run|restore|clear steam:<appid> …"; return 2; }
    local id="${key#steam:}" dir cfg; dir="$(bench_path "$key")"
    case "$sub" in
        get) bench_get "$key" ;;
        set)
            local kv f v var="" patch
            cfg="$(bench_cfg "$key")"
            for kv in "$@"; do
                f="${kv%%=*}"; v="${kv#*=}"
                case "$f" in
                    A|B) var="$f"; continue ;;
                    duration|delay)
                        [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 5 && v <= 900 )) || { err "$f must be 5–900 seconds"; return 2; }
                        cfg="$(jq -c --arg f "$f" --argjson v "$v" '.[$f] = $v' <<<"$cfg")"; continue ;;
                    label|env|args|prefix|gamemode|proton)
                        [[ -n "$var" ]] || { err "say which variant first: A or B"; return 2; }
                        [[ "$v" != *[\"\'\`\$\;\&\|\<\>]* ]] || { err "$f can't contain quotes or shell characters"; return 2; }
                        [[ "$f" == gamemode && -n "$v" && "$v" != true && "$v" != false ]] && { err "gamemode: true, false or empty"; return 2; }
                        if [[ "$f" == proton && -n "$v" ]] && ! cmd_compattools | jq -e --arg t "$v" 'any(.[]; .name == $t)' >/dev/null; then
                            err "unknown Proton: $v"; return 2; fi
                        patch="$(jq -cn --arg f "$f" --arg v "$v" '{($f): $v}')"
                        cfg="$(jq -c --arg x "$var" --argjson p "$patch" '.[$x] = ((.[$x] // {}) + $p)' <<<"$cfg")" ;;
                    *) err "unknown benchmark field: $f"; return 2 ;;
                esac
            done
            mkdir -p "$dir"; printf '%s\n' "$cfg" > "$dir/config.json"
            log "✔ Benchmark of $(game_label "$key") saved." ;;
        run)
            local variant="$1" lc proton cur cfgv
            [[ "$variant" == A || "$variant" == B ]] || { err "use: bench run $key A|B"; return 2; }
            have mangohud || { err "MangoHud is needed to measure frames (pacman -S mangohud lib32-mangohud)"; return 4; }
            lc="$(steam_localconfig)"
            [[ -f "$lc" && "$(vdf_get "$lc" "$LOCALCONFIG_APPS/$id" LaunchOptions)" == *"gaming-deck run"* ]] \
                || { err "the game must be launched through Gaming Deck: USE IN STEAM first"; return 3; }
            cfg="$(bench_cfg "$key")"; proton="$(jq -r --arg x "$variant" '.[$x].proton // ""' <<<"$cfg")"
            if [[ -n "$proton" ]]; then
                steam_running && { err "this variant changes Proton: close Steam first"; return 3; }
                cur="$(vdf_get "$(steam_root)/config/config.vdf" "$COMPAT_MAPPING/$id" name)"
                if [[ "$(jq -r 'has("originalProton")' <<<"$cfg")" != true ]]; then
                    cfg="$(jq -c --arg o "${cur:-default}" '.originalProton = $o' <<<"$cfg")"
                    mkdir -p "$dir"; printf '%s\n' "$cfg" > "$dir/config.json"
                fi
                [[ "$cur" != "$proton" ]] && { cmd_steamcompat "$id" "$proton" || return 4; }
            fi
            mkdir -p "$BENCH_DIR"
            printf '%s\t%s\t%s\n' "$key" "$variant" "$(date +%s)" > "$BENCH_ARMED"
            cfgv="$(jq -r '"logging starts after \(.delay) s and lasts \(.duration) s"' <<<"$cfg")"
            log "→ Launching $(game_label "$key") for run $variant ($cfgv). Play the same scene for both runs, then quit the game."
            setsid -f steam "steam://rungameid/$id" >/dev/null 2>&1 || true
            history_add "benchmark $variant" steam "$key" 0 ;;
        restore)
            local orig; orig="$(bench_cfg "$key" | jq -r '.originalProton // ""')"
            [[ -z "$orig" ]] && { log "✔ Nothing to restore: no variant changed Proton."; return 0; }
            cmd_steamcompat "$id" "$orig" || return $?
            bench_cfg "$key" | jq -c 'del(.originalProton)' > "$dir/config.json"
            log "✔ Proton restored to $orig." ;;
        clear) rm -rf "$dir/A" "$dir/B" "$BENCH_ARMED"; log "✔ Benchmark results of $(game_label "$key") cleared." ;;
        *) err "use: bench get|set|run|restore|clear <key> …"; return 2 ;;
    esac
}

# --- Wine/Proton prefixes (2.6) ------------------------------------------------------
# A prefix is any folder with system.reg + drive_c. Found in Steam's
# compatdata (every library), Heroic, Faugus, Bottles, ~/.wine, winetricks'
# ~/.local/share/wineprefixes and ~/Games (Lutris' and umu's usual home).
PREFIX_BACKUPS="${GAMING_DECK_PREFIX_BACKUPS:-$HOME/gaming-deck-backups/prefixes}"

faugus_prefix_dir() {
    local c
    for c in "$HOME/.var/app/io.github.Faugus.faugus-launcher/config/faugus-launcher/config.json" "$CONFIG_HOME/faugus-launcher/config.json"; do
        [[ -f "$c" ]] && { jq -r '."default-prefix" // empty' "$c" 2>/dev/null; return; }
    done
}

# every prefix root (one per line, deduplicated)
prefix_roots() {
    local lib r
    {
        while IFS= read -r lib; do
            for r in "$lib"/steamapps/compatdata/*/pfx; do [[ -f "$r/system.reg" ]] && echo "$r"; done
        done < <(steam_libs)
        for r in "$HOME/.wine" "$DATA_HOME/wineprefixes" "$HOME/Games" "$(faugus_prefix_dir)" \
                 "$DATA_HOME/bottles/bottles" "$HOME/.var/app/com.usebottles.bottles/data/bottles/bottles"; do
            [[ -n "$r" && -d "$r" ]] || continue
            find "$r" -maxdepth 4 -name system.reg -printf '%h\n' 2>/dev/null
        done
    } | while IFS= read -r r; do [[ -d "$r/drive_c" ]] && readlink -f "$r"; done | awk '!seen[$0]++'
}

# processes using a prefix (WINEPREFIX / STEAM_COMPAT_DATA_PATH in their environment)
prefix_in_use() {
    local p="$1" c
    c="${p%/pfx}"
    grep -azlxE "(WINEPREFIX=$p/?|STEAM_COMPAT_DATA_PATH=$c/?)" "${PROC_ROOT:-/proc}"/[0-9]*/environ 2>/dev/null | head -1 | grep -q .
}

cmd_prefixes() {
    local games p owner id name kind root size used arch ver fdir
    games="$(steam_games | awk 'NR % 5 == 1 { id = $0 } NR % 5 == 2 { print id "\t" $0 }')"
    fdir="$(faugus_prefix_dir)"
    # Umbral: path → the games using that prefix (its own name can be the .exe's, e.g. "Game")
    local uprefixes
    uprefixes="$(umbral_json | jq -c '(.games // []) as $g | [(.prefixes // [])[] | . as $p
        | {path:(.path | rtrimstr("/")), name, games:[$g[] | select(.prefix_id == $p.id and (.hidden | not)) | .name]}]' 2>/dev/null)"
    while IFS= read -r p; do
        owner=wine; id=""; name="${p##*/}"; kind=game; root="$p"
        if [[ "$p" =~ /steamapps/compatdata/([0-9]+)/pfx$ ]]; then
            owner=steam; id="${BASH_REMATCH[1]}"; root="${p%/pfx}"
            name="$(awk -F'\t' -v i="$id" '$1 == i { print $2; exit }' <<<"$games")"
            if [[ -z "$name" ]]; then
                local lib="${p%/steamapps/compatdata/*}" m
                m="$lib/steamapps/appmanifest_$id.acf"
                if [[ -f "$m" ]]; then name="$(vdf_get "$m" AppState name)"; kind=tool
                elif [[ "$id" == 0 ]]; then name="Steam (shared, non-Steam shortcuts)"; kind=shared
                else name="uninstalled app $id"; kind=orphan; fi
            fi
            ver="$(cat "$root/version" 2>/dev/null)"
        else
            local un; un="$(jq -c --arg p "$p" 'first(.[] | select(.path == $p)) // empty' <<<"${uprefixes:-[]}" 2>/dev/null)"
            if [[ -n "$un" ]]; then
                owner=umbral
                name="$(jq -r 'if (.games | length) > 0 then .games | join(" · ") else .name end' <<<"$un")"
                [[ "$(jq '.games | length' <<<"$un")" == 0 ]] && kind=orphan
            fi
            [[ -z "$un" ]] && case "$p" in
                */Heroic/Prefixes/*) owner=heroic ;;
                */bottles/bottles/*) owner=bottles ;;
                "$fdir"/*) [[ -n "$fdir" ]] && owner=faugus ;;
            esac
            ver="$(cat "$p/version" 2>/dev/null)"
        fi
        size="$(dir_bytes "$root")"
        used="$(stat -c %Y "$p/system.reg" 2>/dev/null || echo 0)"
        arch="$(grep -m1 -oE '^#arch=win(32|64)' "$p/system.reg" 2>/dev/null | cut -d= -f2)"
        printf '%s\n' "$p" "$root" "$owner" "$id" "$name" "$kind" "$size" "$used" "${arch:-?}" "$ver" \
            "$(prefix_in_use "$p" && echo 1 || echo 0)"
    done < <(prefix_roots) | jq -Rn '[inputs] as $l | [range(0; $l|length; 11) as $i |
        {path:$l[$i], root:$l[$i+1], owner:$l[$i+2], id:$l[$i+3], name:$l[$i+4], kind:$l[$i+5],
         size:($l[$i+6]|tonumber), lastUsed:($l[$i+7]|tonumber), arch:$l[$i+8], version:$l[$i+9],
         running:($l[$i+10] == "1"), orphan:($l[$i+5] == "orphan")}] | sort_by(-.size)
        | {prefixes:., total:(map(.size) | add // 0), orphanBytes:(map(select(.orphan) | .size) | add // 0)}'
}

# only prefixes the deck found can be acted on (never an arbitrary path)
prefix_lookup() {   # path → its JSON entry
    local p; p="$(readlink -f "$1" 2>/dev/null)"
    [[ -n "$p" ]] || return 1
    cmd_prefixes | jq -ce --arg p "$p" '.prefixes[] | select(.path == $p or .root == $p)'
}

prefix_backup() {   # entry-json → prints archive path
    local e="$1" root name out
    root="$(jq -r .root <<<"$e")"; name="$(jq -r '.owner + "-" + (.name | gsub("[^A-Za-z0-9._-]+"; "_"))' <<<"$e")"
    mkdir -p "$PREFIX_BACKUPS"
    out="$PREFIX_BACKUPS/$name-$(date +%Y%m%d-%H%M%S).tar.zst"
    log "→ Backing up $(human "$(jq -r .size <<<"$e")") to ${out/#$HOME/\~}…" >&2
    if have zstd; then tar -C "${root%/*}" -I 'zstd -T0 -3' -cf "$out" "${root##*/}"
    else out="${out%.zst}.gz"; tar -C "${root%/*}" -czf "$out" "${root##*/}"; fi || { err "backup failed"; rm -f "$out"; return 4; }
    echo "$out"
}

# prefix backup|clone|delete|restore …
cmd_prefix() {
    local sub="$1" e root out dest
    case "$sub" in
        backup|clone|delete)
            e="$(prefix_lookup "$2")" || { err "not a prefix Gaming Deck knows: $2"; return 2; }
            [[ "$(jq -r .running <<<"$e")" == true ]] && { err "the prefix is in use: close the game/app first"; return 3; }
            root="$(jq -r .root <<<"$e")" ;;
    esac
    case "$sub" in
        backup)
            out="$(prefix_backup "$e")" || return 4
            log "✔ Backup: ${out/#$HOME/\~} ($(human "$(stat -c %s "$out")"))"
            history_add "prefix backup" "$(jq -r .owner <<<"$e")" "$(jq -r .name <<<"$e")" 0 ;;
        clone)
            dest="${3:-$HOME/Games/prefixes/$(jq -r '.name | gsub("[^A-Za-z0-9._-]+"; "_")' <<<"$e")-clone}"
            [[ "$dest" == "$HOME"/* ]] || { err "clones go inside your home folder"; return 2; }
            [[ -e "$dest" ]] && { err "$dest already exists"; return 2; }
            mkdir -p "${dest%/*}"
            # a Steam prefix's Wine prefix is its pfx/ folder
            log "→ Cloning to ${dest/#$HOME/\~} (reflink: instant on Btrfs)…"
            cp -a --reflink=auto "$(jq -r .path <<<"$e")" "$dest" || { err "clone failed"; rm -rf "$dest"; return 4; }
            log "✔ Clone ready: WINEPREFIX=$dest"
            history_add "prefix clone" "$(jq -r .owner <<<"$e")" "$(jq -r .name <<<"$e")" 0 ;;
        delete)
            if [[ "$3" != --no-backup ]]; then out="$(prefix_backup "$e")" || return 4; log "→ Backup kept: ${out/#$HOME/\~}"; fi
            # Steam libraries may live on other drives: there only …/steamapps/compatdata/<appid>
            if [[ "$(jq -r .owner <<<"$e")" == steam ]]; then
                [[ "$root" =~ /steamapps/compatdata/[0-9]+$ ]] || { err "refusing to delete $root"; return 3; }
            else
                [[ "$root" == "$HOME"/* && "$root" != "$HOME" ]] || { err "refusing to delete outside your home"; return 3; }
            fi
            rm -rf -- "$root" || { err "delete failed"; return 4; }
            log "✔ Deleted ${root/#$HOME/\~} ($(human "$(jq -r .size <<<"$e")")).$([[ "$(jq -r .owner <<<"$e")" == steam ]] && echo " Steam recreates it the next time the game starts.")"
            history_add "prefix delete" "$(jq -r .owner <<<"$e")" "$(jq -r .name <<<"$e")" 0 ;;
        restore)
            local arch="$2"; dest="$3"
            [[ -f "$arch" && "$arch" == "$PREFIX_BACKUPS"/* ]] || { err "not a Gaming Deck prefix backup: $arch"; return 2; }
            [[ -n "$dest" && "$dest" == "$HOME"/* ]] || { err "use: prefix restore <backup> <new folder in your home>"; return 2; }
            [[ -e "$dest" ]] && { err "$dest already exists"; return 2; }
            mkdir -p "$dest"
            tar -xf "$arch" -C "$dest" --strip-components=1 || { err "restore failed"; rm -rf "$dest"; return 4; }
            log "✔ Restored into ${dest/#$HOME/\~}"
            history_add "prefix restore" wine "${arch##*/}" 0 ;;
        backups)
            find "$PREFIX_BACKUPS" -maxdepth 1 -type f -name '*.tar.*' -printf '%T@\t%s\t%p\n' 2>/dev/null | sort -rn \
                | jq -Rn '[inputs | split("\t") | {date:(.[0]|tonumber|floor), size:(.[1]|tonumber), path:.[2]}]' ;;
        *) err "use: prefix backup|clone|delete <path> · prefix restore <backup> <dest> · prefix backups"; return 2 ;;
    esac
}

# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
gaming-deck — game profiles, visual shaders and gaming status for Steam and Umbral (Arch/CachyOS)
Usage: gaming-deck <command> [args]

Maintain
  proton status | install [tag] GE-Proton here and the latest release · install it (checksum-verified)
  cleanscan / clean <id>        Game clean-up: shaders prefixes protons
  export [file]                 Backup of the game profiles, looks and settings
  history                       Operation history (JSON)
  pickfile <title> [filter]     File chooser (zenity)
  version / selfcheck / selfupdate   Installed version · newer one on GitHub? · update Gaming Deck itself
  migrate                       Bring the game data over from Control Deck and fix what pointed at it

Gaming
  games                         Installed games (Steam) with profile/launch/Proton state (JSON)
  gstatus                       gamemode, CPU governor, vm.max_map_count, running games (JSON)
  gprofile get|set|reset <key>  Per-game profile: gamemode mangohud overlay ionice nice env prefix args
  run [--profile <key>] -- cmd  Launch a game with its profile (Steam: "gaming-deck run %command%")
  steamwrap <appid> on|off      Launch a Steam game through Gaming Deck (Steam must be closed)
  compattools                   Proton versions Steam can use (JSON)
  steamcompat <appid> <tool|default>   Proton version for a game (Steam must be closed)
  protondb <appid…>             ProtonDB summary per game, cached 24 h (JSON)
  gamejoin                      Join the gamemode group (one-time, pkexec)
  pdbindex update [--force]|status   Index ProtonDB's open data (all games' launch options)
  gsuggest <appid>              Launch options players use for a game, with shares (JSON)
  gtips <appid…> / gseen <key>  Suggestion counts per game · mark a new game as seen
  gplay <key>                   Start a game (steam:<appid> via Steam, umbral:<id> via Umbral)
  shadercache                   Shader caches per game + driver caches, stale/orphan detection (JSON)
  shaderclean <target> [part]   steam:<appid> [driver|all] · orphans · stale · global:<id>
  bench get|set|run|restore|clear steam:<appid> …   A/B benchmark with MangoHud frame logs
  prefixes                      Wine/Proton prefixes (Steam, Heroic, Faugus, Bottles, standalone) (JSON)
  prefix backup|clone|delete <path> [dest|--no-backup] · prefix restore <backup> <dest> · prefix backups
  fx status [key] | install | packages | package <idx> | search <name> | presets <sfx id> | key <Home|Insert|F10|F11|F12>
  fx link add|note|rm|get steam:<appid> <url> [label|notes]   Save a preset page (Nexus…) for a game, even before installing it
  fx scan [--cached] / fx autoinstall [key…]   Every game: best preset + ReShade compatibility; set up ReShade for the eligible ones
     fx set <key> builtin:<sharpen|sharpen-aa|fxaa|clarity> | sfx:<preset id> | off   Visual shaders (vkBasalt)
  uilang [en|es]                The GUI's language (default: the system's)
  playing [quiet|lite on|off]   While playing: hold notifications · Hyprland without animations/blur/shadows
  iosched <key>                 The game's disk and I/O scheduler (does IO PRIORITY do anything there?)
  gstop umbral:<id>             Close an Umbral game (Umbral 0.11+)
  mods <game>                   The game's mods in Crisol (count, profile, applied, updates, loader)
  mopen <game> / mplay <game>   Open the game in Crisol / play it with its mods
  uopts umbral:<id>             An Umbral game's options (Umbral 0.12+)
  uset umbral:<id> k=v …        Change them: gamemode=on fps_limit=120 env.NAME=value (env.NAME= removes)
  sessions [N|on|off]           Last game sessions (temps, load, power) · turn the end-of-game summary on/off
  upscale <steam:id>            FSR 4 / DLSS / XeSS upgrades this game, GPU and Proton allow (JSON)
  sched status|start|stop|playing|boot|nopassword …   CPU scheduler (sched-ext via scxctl): now, while playing, at boot
  gaming-import <backup.json>   Add the game profiles, looks and settings of a backup (only what's missing here)
  gaudit [fix <key|all>]        Check game profiles for this PC (other GPU vendor's variables, shaders not set up here)
  session <pid> <key>           For launchers like Umbral: TEMPS + scheduler while <pid> runs
  hook <umbral:id>              For Umbral: env (ReShade/vkBasalt) + TEMPS for a game it launches (JSON)
  temps [pid] / overlay [pid]   CPU/GPU °C · on-screen temperature line until <pid> exits (no pid: 10 s preview)
  panel [toggle|key <KEY|off>|toast on|off|status]   In-game panel (F6): achievements, guides, notes over the game
  ovgames                       Installed Steam games with achievements progress and wiki (JSON, for OVERLAY)
  ingame / ach <appid>          The Steam game being played · its achievements from Steam's own cache (JSON)
  wiki <appid> [search <text>|page <title>|set <url>|clear]   The game's Fandom wiki (MediaWiki API, CC BY-SA)
  guides <appid> / gopen <url>  Guide links (EliteGuías, Fextralife, Steam guides, wiki) · open one in the browser
  web <https://…> [--back] [--fallback <https://…>] | web close   A guide in a small browser over the game (GTK + WebKit, overlay layer)
  notes <appid> [set <text>]    Your notes for a game
  health                        Gaming health: multilib, GPU driver, Vulkan, 32-bit libraries, with fix commands (JSON)
EOF
}

# run a subcommand and notify its outcome
with_notify() {
    local ok_title="$1" fail_title="$2" label="$3"; shift 3
    "$@"; local rc=$?
    if [[ $rc -eq 0 ]]; then notify "$ok_title" "$label"
    else notify "$fail_title" "$label"; fi
    return $rc
}

need() { [[ -n "$1" ]] || { err "$2"; exit 2; }; }

# ------------------------------------------------------------- 2.9 health ----
# health — read-only checks of what games need from the system: multilib, the
# GPU driver (userspace/kernel versions in sync, 32-bit libraries), Vulkan and a
# few kernel settings. Every failed check carries the exact command that fixes
# it; nothing is ever run from here.
SYSFS="${GAMING_DECK_SYSFS:-/sys}"
PROCFS="${GAMING_DECK_PROCFS:-/proc}"
PACMAN_CONF="${GAMING_DECK_PACMAN_CONF:-/etc/pacman.conf}"
NTSYNC_DEV="${GAMING_DECK_NTSYNC_DEV:-/dev/ntsync}"

# installed version of a package ("" when not installed), from the local db
pkg_ver() {
    local d
    for d in "$PACMAN_DB/$1"-*; do
        [[ -d "$d" ]] || continue
        d="${d##*/}"; d="${d#"$1"-}"
        [[ "$d" =~ ^[^-]+-[^-]+$ ]] && { echo "$d"; return; }
    done
}

# every GPU vendor present (a laptop can have two) and the kernel driver in use
gpu_devices() {
    local c v drv
    for c in "$SYSFS"/class/drm/card[0-9]*; do
        [[ -f "$c/device/vendor" && ! "${c##*/}" =~ - ]] || continue
        v="$(cat "$c/device/vendor")"
        drv="$(readlink "$c/device/driver" 2>/dev/null)"; drv="${drv##*/}"
        case "$v" in 0x10de) v=nvidia ;; 0x1002) v=amd ;; 0x8086) v=intel ;; *) continue ;; esac
        echo "$v $drv"
    done | sort -u
}

cmd_health() {
    local checks=() missing=() vendors drv p v kmod u32 icd

    # $1 id · $2 group · $3 status (ok|warn|fail|info) · $4 label · $5 detail · $6 fix
    chk() { checks+=("$(jq -nc --arg id "$1" --arg g "$2" --arg s "$3" --arg l "$4" --arg d "$5" --arg f "${6:-}" \
                        '{id:$id, group:$g, status:$s, label:$l, detail:$d, fix:$f}')"); }
    # packages that must be installed ($1 group · $2 status if missing · $3 label);
    # missing ones also go to the combined fix
    need_pkgs() {
        local g="$1" s="$2" l="$3"; shift 3
        local p miss=()
        for p in "$@"; do [[ -n "$(pkg_ver "$p")" ]] || miss+=("$p"); done
        if ((${#miss[@]} == 0)); then
            chk "pkg:${1}" "$g" ok "$l" "$*"
        else
            missing+=("${miss[@]}")
            chk "pkg:${1}" "$g" "$s" "$l" "missing: ${miss[*]}" "sudo pacman -S --needed ${miss[*]}"
        fi
    }

    # --- system
    local multilib=0
    [[ -r "$PACMAN_CONF" ]] && grep -qE '^[[:space:]]*\[multilib\][[:space:]]*$' "$PACMAN_CONF" && multilib=1
    if ((multilib)); then
        chk multilib system ok "multilib repository" "enabled in $PACMAN_CONF (32-bit libraries for Steam and Wine)"
    else
        chk multilib system fail "multilib repository" \
            "disabled: Steam and Wine need its 32-bit libraries. Uncomment the [multilib] section (both lines) in $PACMAN_CONF, then update" \
            "sudo pacman -Syu"
    fi
    local mmc; mmc="$(cat "$PROCFS/sys/vm/max_map_count" 2>/dev/null)"
    if [[ "$mmc" =~ ^[0-9]+$ ]] && (( mmc >= 1048576 )); then
        chk max_map_count system ok "vm.max_map_count" "$mmc"
    else
        chk max_map_count system warn "vm.max_map_count" \
            "${mmc:-unknown}: some games crash below 1048576 (the value Arch ships)" \
            "echo 'vm.max_map_count = 1048576' | sudo tee /etc/sysctl.d/80-gamecompatibility.conf && sudo sysctl --system"
    fi
    if [[ -e "$NTSYNC_DEV" ]]; then
        chk ntsync system ok "ntsync" "$NTSYNC_DEV present: Proton/Wine can use kernel sync"
    elif have modinfo && modinfo ntsync >/dev/null 2>&1; then
        chk ntsync system warn "ntsync" "the kernel has the module but it is not loaded" \
            "echo ntsync | sudo tee /etc/modules-load.d/ntsync.conf && sudo modprobe ntsync"
    else
        chk ntsync system info "ntsync" "not in this kernel (needs 6.14 or newer); Proton falls back to esync/fsync"
    fi

    # --- GPU drivers
    vendors="$(gpu_devices)"
    [[ -z "$vendors" ]] && chk gpu driver warn "GPU" "no NVIDIA, AMD or Intel GPU found in $SYSFS/class/drm"
    while read -r v drv; do
        [[ -n "$v" ]] || continue
        case "$v" in
        nvidia)
            if [[ "$drv" == nvidia ]]; then
                kmod="$(cat "$SYSFS/module/nvidia/version" 2>/dev/null)"
                chk nvidia:module driver ok "NVIDIA kernel module" "loaded${kmod:+ ($kmod)}"
            else
                chk nvidia:module driver fail "NVIDIA kernel module" \
                    "the card uses «${drv:-no driver}», not the NVIDIA driver. Install the module for your kernel (nvidia-open-dkms is for GTX 16 / RTX 20 and newer; older cards need the legacy driver from the AUR), then reboot" \
                    "sudo pacman -S --needed nvidia-open-dkms nvidia-utils lib32-nvidia-utils"
                kmod=""
            fi
            need_pkgs driver fail "NVIDIA userspace" nvidia-utils lib32-nvidia-utils
            u32="$(pkg_ver lib32-nvidia-utils)"; u32="${u32%-*}"
            p="$(pkg_ver nvidia-utils)"; p="${p%-*}"
            if [[ -n "$p" && -n "$kmod" && "$p" != "$kmod" ]]; then
                chk nvidia:sync driver fail "NVIDIA versions" \
                    "nvidia-utils is $p but the loaded kernel module is $kmod: the driver was updated and the PC not restarted (games fail to start)" \
                    "reboot"
            elif [[ -n "$p" && -n "$u32" && "$p" != "$u32" ]]; then
                chk nvidia:sync driver fail "NVIDIA versions" \
                    "nvidia-utils is $p but lib32-nvidia-utils is $u32: 32-bit games and Steam break" \
                    "sudo pacman -Syu"
            elif [[ -n "$p" && -n "$kmod" ]]; then
                chk nvidia:sync driver ok "NVIDIA versions" "kernel module, nvidia-utils${u32:+ and lib32-nvidia-utils} at $p"
            fi
            if [[ -n "$kmod" ]]; then
                if [[ "$(cat "$SYSFS/module/nvidia_drm/parameters/modeset" 2>/dev/null)" == Y ]]; then
                    chk nvidia:modeset driver ok "nvidia_drm modeset" "on (needed by Wayland and gamescope)"
                else
                    chk nvidia:modeset driver fail "nvidia_drm modeset" "off: Wayland sessions and gamescope need it; reboot after the fix" \
                        "echo 'options nvidia_drm modeset=1' | sudo tee /etc/modprobe.d/nvidia-drm.conf"
                fi
            fi
            ;;
        amd)
            if [[ "$drv" == amdgpu ]]; then
                chk amd:module driver ok "amdgpu kernel driver" "in use"
            else
                chk amd:module driver warn "amdgpu kernel driver" \
                    "the card uses «${drv:-no driver}»: RADV Vulkan needs amdgpu (very old GCN 1/2 cards default to radeon)"
            fi
            need_pkgs driver fail "Mesa + RADV Vulkan" mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon
            local avk=()
            for p in amdvlk lib32-amdvlk; do [[ -n "$(pkg_ver "$p")" ]] && avk+=("$p"); done
            if ((${#avk[@]})); then
                chk amd:amdvlk driver warn "AMDVLK" \
                    "${avk[*]} installed: AMD discontinued it and it can take over from RADV, which Proton is tuned for" \
                    "sudo pacman -Rns ${avk[*]}"
            fi
            p="$(pkg_ver mesa)"; [[ -n "$p" ]] && chk amd:mesa driver info "Mesa" "${p%-*}"
            ;;
        intel)
            need_pkgs driver fail "Mesa + Intel Vulkan" mesa lib32-mesa vulkan-intel lib32-vulkan-intel
            ;;
        esac
    done <<<"$vendors"

    # --- Vulkan
    need_pkgs vulkan fail "Vulkan loader" vulkan-icd-loader lib32-vulkan-icd-loader
    local f; icd=""
    for f in /usr/share/vulkan/icd.d/*.json; do [[ -e "$f" ]] && icd+="${f##*/} "; done
    if [[ -n "${HEALTH_QUICK:-}" ]]; then
        :   # STATUS's summary: starting Vulkan every few minutes isn't worth it
    elif have vulkaninfo; then
        local devs
        devs="$(timeout 15 vulkaninfo --summary 2>/dev/null | awk -F'= ' '
            /deviceType/ {t=$2} /deviceName/ {n=$2}
            /driverName/ {print t "\t" n "\t" $2}')"
        if grep -qE 'DISCRETE_GPU|INTEGRATED_GPU' <<<"$devs"; then
            chk vulkan:device vulkan ok "Vulkan devices" \
                "$(grep -E 'DISCRETE_GPU|INTEGRATED_GPU' <<<"$devs" | cut -f2,3 | sed 's/\t/ · /' | paste -sd ',' | sed 's/,/, /g')"
        else
            chk vulkan:device vulkan fail "Vulkan devices" \
                "Vulkan sees no GPU${devs:+ (only a software renderer)}; drivers found: ${icd:-none}. Check the driver rows above"
        fi
    else
        chk vulkan:device vulkan info "Vulkan devices" "install vulkan-tools to check which GPUs Vulkan sees (drivers: ${icd:-none})" \
            "sudo pacman -S --needed vulkan-tools"
    fi

    # --- 32-bit libraries games commonly load
    if [[ -n "$(pkg_ver lib32-pipewire)" || -n "$(pkg_ver lib32-libpulse)" ]]; then
        chk lib32:audio libs ok "32-bit audio" "$( [[ -n "$(pkg_ver lib32-pipewire)" ]] && echo lib32-pipewire || echo lib32-libpulse)"
    else
        missing+=(lib32-pipewire)
        chk lib32:audio libs warn "32-bit audio" "no lib32-pipewire / lib32-libpulse: 32-bit games have no sound" \
            "sudo pacman -S --needed lib32-pipewire"
    fi
    need_pkgs libs warn "32-bit TLS (online games)" lib32-gnutls

    # GameMode: the GAMEMODE chip does nothing without it
    if gamemode_installed; then
        chk tools:gamemode tools ok "GameMode" "$(pkg_ver gamemode | sed 's/-[^-]*$//')"
    else
        local gmn; gmn="$(profiles_json 2>/dev/null | jq '[to_entries[] | select(.key != "default" and .value.gamemode == true)] | length' 2>/dev/null)"
        if (( ${gmn:-0} > 0 )); then
            chk tools:gamemode tools warn "GameMode" "not installed: $gmn game profile(s) have GAMEMODE on and it does nothing" \
                "sudo pacman -S --needed gamemode lib32-gamemode"
        else
            chk tools:gamemode tools info "GameMode" "not installed (optional: CPU governor and priorities while playing)" \
                "sudo pacman -S --needed gamemode lib32-gamemode"
        fi
    fi

    local all=""
    ((${#missing[@]})) && all="sudo pacman -S --needed $(printf '%s\n' "${missing[@]}" | sort -u | paste -sd ' ')"
    printf '%s\n' "${checks[@]}" | jq -sc --arg all "$all" --argjson ml "$multilib" --arg v "$vendors" '{
        checks: .,
        vendors: ($v | split("\n") | map(select(. != "") | split(" ")[0]) | unique),
        fail: ([.[] | select(.status == "fail")] | length),
        warn: ([.[] | select(.status == "warn")] | length),
        installAll: $all,
        multilib: ($ml == 1)
    }'
}

# --- temperature overlay ------------------------------------------------------
# A one-line CPU/GPU temperature readout drawn on a Wayland overlay layer (top
# right, above fullscreen games, click-through). `run` starts it for games whose
# profile has overlay on; it closes itself when the game's process ends.
OVERLAY_QML="${GAMING_DECK_OVERLAY_QML:-$HOME/.config/quickshell/gaming-deck-overlay/shell.qml}"

# first temperature (°C, integer) of a hwmon chip whose label matches, else temp1
# GameMode present? (GAMING_DECK_GAMEMODE=0/1 pins it, for the tests)
gamemode_installed() {
    [[ -n "${GAMING_DECK_GAMEMODE:-}" ]] && { [[ "$GAMING_DECK_GAMEMODE" == 1 ]]; return; }
    have gamemoderun
}
# the AMD GPU to report: the one with the most VRAM (the dedicated card, not the
# CPU's integrated graphics, which is also amdgpu: Ryzen 7000/9000 have one)
amd_gpu_dev() {
    local c best="" bv=-1 v
    for c in "$SYSFS"/class/drm/card[0-9]*; do
        [[ ! "${c##*/}" =~ - && "$(cat "$c/device/vendor" 2>/dev/null)" == 0x1002 ]] || continue
        v="$(cat "$c/device/mem_info_vram_total" 2>/dev/null || echo 0)"
        (( v > bv )) && { bv=$v; best="$c/device"; }
    done
    [[ -z "$best" ]] || echo "$best"     # none: empty, not an error (callers run under set -e)
}
# its temperature ("edge"), from its own hwmon
amd_gpu_temp() {
    local d h t; d="$(amd_gpu_dev)"
    if [[ -n "$d" ]]; then
        for h in "$d"/hwmon/hwmon*; do
            for t in "$h"/temp*_input; do
                [[ -f "$t" ]] || continue
                [[ "$(cat "${t%_input}_label" 2>/dev/null)" == edge || ! -f "${t%_input}_label" ]] && { echo $(( $(cat "$t") / 1000 )); return 0; }
            done
        done
    fi
    hwmon_temp amdgpu edge     # no per-card sensor found: the first amdgpu one
}
hwmon_temp() {   # name regex · label regex
    local h t l
    for h in "$SYSFS"/class/hwmon/hwmon*; do
        [[ "$(cat "$h/name" 2>/dev/null)" =~ ^($1)$ ]] || continue
        for t in "$h"/temp*_input; do
            [[ -f "$t" ]] || continue
            l="$(cat "${t%_input}_label" 2>/dev/null)"
            [[ -z "$2" || "$l" =~ ^($2)$ ]] || continue
            echo $(( $(cat "$t") / 1000 )); return 0
        done
        [[ -f "$h/temp1_input" ]] && { echo $(( $(cat "$h/temp1_input") / 1000 )); return 0; }
    done
    return 1
}

# temps [pid] → CPU=<°C> GPU=<°C> (empty when unknown) and, with a pid, ALIVE=0|1
cmd_temps() {
    local cpu gpu=""
    # Intel package, AMD Tctl/Tdie (k10temp / zenpower), else ACPI
    cpu="$(hwmon_temp coretemp 'Package id 0' || hwmon_temp 'k10temp|zenpower' 'Tctl|Tdie' \
           || hwmon_temp 'cpu_thermal|acpitz' '')"
    case "$(gpu_vendor)" in
        nvidia) have nvidia-smi && gpu="$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -dc 0-9)" ;;
        amd)    gpu="$(amd_gpu_temp)" ;;
        intel)  gpu="$(hwmon_temp 'i915|xe' '')" ;;
    esac
    printf 'CPU=%s\nGPU=%s\n' "$cpu" "$gpu"
    [[ -n "${1:-}" ]] && printf 'ALIVE=%s\n' "$([[ -d "${PROC_ROOT:-/proc}/$1" ]] && echo 1 || echo 0)"
    return 0
}

# overlay [pid] — show the readout until <pid> exits (no pid: a 10 s preview)
cmd_overlay() {
    local pid="${1:-}"
    [[ -f "$OVERLAY_QML" ]] || { err "overlay not installed ($OVERLAY_QML): run install.sh"; return 4; }
    have qs || { err "quickshell (qs) is needed for the overlay"; return 4; }
    if [[ -z "$pid" ]]; then sleep 10 & pid=$!; disown; fi
    [[ "$pid" =~ ^[0-9]+$ ]] || { err "use: overlay [pid]"; return 2; }
    # Steam may start games without the session's Wayland socket in the environment
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        local s; for s in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-[0-9]; do
            [[ -S "$s" ]] && { export WAYLAND_DISPLAY="${s##*/}"; break; }
        done
    fi
    # Steam's LD_LIBRARY_PATH (its runtime's libcurl…) and overlay LD_PRELOAD
    # break Qt: qs dies before showing anything
    mkdir -p "$STATE_DIR/logs"
    env -u LD_LIBRARY_PATH -u LD_PRELOAD CD_OVERLAY_PID="$pid" CD_OVERLAY_BIN="$(readlink -f "${BASH_SOURCE[0]}")" \
        setsid -f qs -p "$OVERLAY_QML" >"$STATE_DIR/logs/overlay.log" 2>&1 </dev/null
}

# --- in-game panel (F6): achievements, guides, notes -----------------------------
# A Quickshell layer over the game, like TEMPS: nothing is loaded into the
# game's process, so it is the same for games with anti-cheat (EAC, BattlEye…).
# Achievements come from the files the Steam client itself keeps up to date in
# appcache/stats (no Web API key); global rarity from Steam's public, keyless
# GetGlobalAchievementPercentagesForApp. Guides: the game's Fandom wiki through
# its MediaWiki API (text under CC BY-SA, shown with its source), and links
# that open in the browser (EliteGuías, Steam guides): their content is never
# copied, as their terms ask.
PANEL_QML="${GAMING_DECK_PANEL_QML:-$HOME/.config/quickshell/gaming-deck-panel/shell.qml}"
PANEL_SETTINGS="$GAMING_DIR/panel.json"
NOTES_DIR="$GAMING_DIR/notes"
ACH_CACHE="$CACHE_HOME/gaming-deck/ach"
WIKI_CACHE="$CACHE_HOME/gaming-deck/wiki"
WIKI_MAP="$GAMING_DIR/wiki.json"
STEAM_API="${GAMING_DECK_STEAM_API:-https://api.steampowered.com}"
FANDOM_FMT="${GAMING_DECK_FANDOM_FMT:-https://%s.fandom.com}"
DECK_UA="GamingDeck/1 (+https://github.com/madkyp/gaming-deck)"
PANEL_MARK_BEGIN="gaming-deck panel: managed by 'gaming-deck panel key'"
PANEL_MARK_END="end of gaming-deck panel"

panel_setting() {   # name default → value
    local v; v="$(jq -r --arg k "$1" 'if has($k) then .[$k] | tostring else empty end' "$PANEL_SETTINGS" 2>/dev/null)"   # (// would drop false)
    echo "${v:-$2}"
}
panel_setting_set() {   # name json-value
    mkdir -p "$GAMING_DIR"
    local cur='{}'; [[ -f "$PANEL_SETTINGS" ]] && cur="$(cat "$PANEL_SETTINGS")"
    jq --arg k "$1" --argjson v "$2" '.[$k] = $v' <<<"$cur" > "$PANEL_SETTINGS.tmp" && mv "$PANEL_SETTINGS.tmp" "$PANEL_SETTINGS"
}

# the Steam account (32-bit id) signed in: MostRecent in loginusers.vdf, else
# the one that signed in last (newer clients don't always write MostRecent)
steam_account() {
    local f s; f="$(steam_root)/config/loginusers.vdf"
    [[ -f "$f" ]] || return 0
    s="$(awk '/^\t"[0-9]+"$/ { gsub(/[\t"]/, ""); id = $0 }
              /"MostRecent"[ \t]+"1"/ { mr = id }
              /"Timestamp"/ { gsub(/[^0-9]/, "", $2); if ($2 + 0 >= ts) { ts = $2 + 0; last = id } }
              END { print (mr != "" ? mr : last) }' "$f")"
    [[ "$s" =~ ^[0-9]{17}$ ]] && echo $(( s - 76561197960265728 ))
    return 0
}
game_name() {   # appid → name from its manifest
    steam_games | awk -v i="$1" 'NR % 5 == 1 { x = $0 } NR % 5 == 2 && x == i { print; exit }'
}

# ingame → {"appid","name","pid"} of the Steam game being played ({} when none):
# the focused window's game when it is one, else the newest running game
cmd_ingame() {
    local id="" pid="" w
    if have hyprctl; then
        w="$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty' 2>/dev/null)"
        if [[ "$w" =~ ^[0-9]+$ && -r "${PROC_ROOT:-/proc}/$w/environ" ]]; then
            id="$(tr '\0' '\n' < "${PROC_ROOT:-/proc}/$w/environ" 2>/dev/null | sed -n 's/^SteamAppId=\([0-9]*\)$/\1/p' | head -1)"
            [[ "$id" == 0 ]] && id=""; [[ -n "$id" ]] && pid="$w"
        fi
    fi
    if [[ -z "$id" ]]; then
        read -r id pid < <(running_games | sort -t$'\t' -k2,2n | tail -1 | tr '\t' ' ')
    fi
    [[ -n "$id" ]] || { echo '{}'; return 0; }
    local since=0; [[ -d "${PROC_ROOT:-/proc}/$pid" ]] && since="$(stat -c %Y "${PROC_ROOT:-/proc}/$pid" 2>/dev/null || echo 0)"
    jq -nc --arg id "$id" --arg n "$(game_name "$id")" --argjson pid "${pid:-0}" --argjson since "${since:-0}" \
        '{appid:$id, name:(if $n == "" then null else $n end), pid:$pid, since:(if $since > 0 then $since else null end)}'
}

# global unlock percentages, cached a day (public endpoint, no key)
ach_rarity() {   # appid → path of the cached JSON (empty when unavailable)
    local f="$ACH_CACHE/$1-global.json"
    mkdir -p "$ACH_CACHE"
    if [[ ! -s "$f" || -n "$(find "$f" -mmin +1440 2>/dev/null)" ]]; then
        curl -fsSL -m 6 -A "$DECK_UA" "$STEAM_API/ISteamUserStats/GetGlobalAchievementPercentagesForApp/v2/?gameid=$1" -o "$f.tmp" 2>/dev/null \
            && jq -e '.achievementpercentages.achievements' "$f.tmp" >/dev/null 2>&1 && mv "$f.tmp" "$f"
        rm -f "$f.tmp"
    fi
    [[ -s "$f" ]] && echo "$f"
    return 0
}

# ach <appid> → this account's achievements for the game (JSON)
cmd_ach() {
    local id="$1" acc stats lang
    [[ "$id" =~ ^[0-9]+$ ]] || { err "use: ach <appid>"; return 2; }
    have python3 || { echo '{"error":"python"}'; return 0; }
    stats="$(steam_root)/appcache/stats"; acc="$(steam_account)"
    lang="english"; [[ "$(cmd_uilang)" == es ]] && lang="spanish"
    python3 - "$stats" "${acc:-}" "$id" "$lang" "$(ach_rarity "$id")" <<'PY'
import json, os, struct, sys, glob
stats, acc, app, lang, rar = sys.argv[1:6]

def kv(b, i=0):
    # Steam's binary KeyValues: type byte, NUL-terminated key, value; 8 closes a block
    d = {}
    while i < len(b):
        t = b[i]; i += 1
        if t == 8: return d, i
        j = b.index(0, i); k = b[i:j].decode('utf-8', 'replace'); i = j + 1
        if t == 0: v, i = kv(b, i)
        elif t == 1: j = b.index(0, i); v = b[i:j].decode('utf-8', 'replace'); i = j + 1
        elif t in (2, 4, 6): v = struct.unpack_from('<i', b, i)[0]; i += 4
        elif t == 3: v = struct.unpack_from('<f', b, i)[0]; i += 4
        elif t in (7, 10): v = struct.unpack_from('<Q', b, i)[0]; i += 8
        else: raise ValueError('type %d' % t)
        d[k] = v
    return d, i

def load(p):
    with open(p, 'rb') as f: return kv(f.read())[0]

schema_f = os.path.join(stats, 'UserGameStatsSchema_%s.bin' % app)
if not os.path.isfile(schema_f):
    print(json.dumps({'appid': app, 'error': 'noschema'})); sys.exit()
user_f = os.path.join(stats, 'UserGameStats_%s_%s.bin' % (acc, app)) if acc else ''
if not (user_f and os.path.isfile(user_f)):
    # no account found: the newest stats file of this game
    c = sorted(glob.glob(os.path.join(stats, 'UserGameStats_*_%s.bin' % app)), key=os.path.getmtime)
    user_f = c[-1] if c else user_f
try:
    sch = load(schema_f)[app]
    user = load(user_f).get('cache', {}) if user_f and os.path.isfile(user_f) else {}
except Exception as e:
    print(json.dumps({'appid': app, 'error': 'parse', 'detail': str(e)})); sys.exit()
pct = {}
if rar:
    try:
        for a in json.load(open(rar))['achievementpercentages']['achievements']:
            pct[a['name']] = float(a['percent'])
    except Exception: pass

def txt(d, k):
    v = (d or {}).get(k)
    if isinstance(v, dict): return v.get(lang) or v.get('english') or ''
    return v or ''

items = []
for bid, blk in sch.get('stats', {}).items():
    bits = blk.get('bits') if isinstance(blk, dict) else None
    if not isinstance(bits, dict): continue
    ub = user.get(bid, {}) if isinstance(user.get(bid), dict) else {}
    data = ub.get('data', 0) & 0xFFFFFFFF
    times = ub.get('AchievementTimes', {}) or {}
    for b, a in bits.items():
        disp = a.get('display', {}) or {}
        got = bool(data >> int(b) & 1)
        icon = disp.get('icon' if got else 'icon_gray') or disp.get('icon') or ''
        items.append({
            'id': a.get('name', ''), 'name': txt(disp, 'name'), 'desc': txt(disp, 'desc'),
            'nameEn': (disp.get('name') or {}).get('english', '') if isinstance(disp.get('name'), dict) else txt(disp, 'name'),
            'hidden': bool(int(disp.get('hidden', 0) or 0)), 'unlocked': got,
            'time': int(times.get(b, 0) or 0) if got else 0,
            'icon': ('https://cdn.fastly.steamstatic.com/steamcommunity/public/images/apps/%s/%s' % (app, icon)) if icon else '',
            'rarity': pct.get(a.get('name', '')),
        })
n = len(items); u = sum(1 for i in items if i['unlocked'])
print(json.dumps({'appid': app, 'game': sch.get('gamename', ''), 'lang': lang, 'total': n, 'unlocked': u,
                  'percent': round(100.0 * u / n, 1) if n else 0, 'hasRarity': bool(pct),
                  'statsFile': user_f, 'items': items}, ensure_ascii=False))
PY
}

# --- wiki (Fandom, MediaWiki API) ---
# the wiki candidates for a game name, and how well a wiki's name fits it
wiki_candidates() {   # name → subdomains, best guess first
    python3 - "$1" <<'PY'
import re, sys, unicodedata
n = unicodedata.normalize('NFKD', sys.argv[1]).encode('ascii', 'ignore').decode().lower()
def slugs(s):
    w = re.findall(r'[a-z0-9]+', s)
    while w and re.fullmatch(r'(i{1,3}|iv|v|vi{1,3}|\d+)', w[-1]): w = w[:-1]
    return [''.join(w), '-'.join(w)] if w else []
out = []
parts = [p for p in re.split(r'\s*[:\-–—]\s+', n) if p]
for s in [n] + parts[:1] + parts[1:][-1:] + [re.sub(r'^the\s+', '', n)]:
    for c in slugs(s):
        if c and c not in out: out.append(c)
print('\n'.join(out[:8]))
PY
}
wiki_score() {   # game name · wiki name → 0..100 (share of the game's words found in the wiki's name)
    python3 - "$1" "$2" <<'PY'
import re, sys, unicodedata
a = lambda s: unicodedata.normalize('NFKD', s).encode('ascii', 'ignore').decode().lower()
stop = {'the', 'of', 'and', 'a', 'an', 'de', 'la', 'el', 'wiki', 'ii', 'iii', 'iv', 'remastered', 'edition', 'definitive', 'goty'}
w = [x for x in re.findall(r'[a-z0-9]+', a(sys.argv[1])) if len(x) > 1 and x not in stop and not x.isdigit()]
site = ''.join(re.findall(r'[a-z0-9]+', a(sys.argv[2])))
print(int(100 * sum(1 for x in w if x in site) / len(w)) if w else 0)
PY
}
wiki_get() {   # appid → {"base","name","articles"} or {} (looked up once a week when nothing fits)
    local id="$1" name map='{}' e best="" bs=0 ba=0 c info url sn arts sc
    [[ -f "$WIKI_MAP" ]] && map="$(cat "$WIKI_MAP")"
    e="$(jq -c --arg i "$id" '.[$i] // empty' <<<"$map")"
    if [[ -n "$e" ]]; then
        if [[ "$(jq -r '.base // ""' <<<"$e")" != "" || $(( $(date +%s) - $(jq -r '.checked // 0' <<<"$e") )) -lt 604800 ]]; then
            jq -c 'if .base == "" then {} else {base, name, articles} end' <<<"$e"; return 0
        fi
    fi
    name="$(game_name "$id")"; [[ -z "$name" ]] && { echo '{}'; return 0; }
    have python3 || { echo '{}'; return 0; }
    while IFS= read -r c; do
        [[ -n "$c" ]] || continue
        # -L: Fandom redirects old names (liesofp → lies-of-p); the final address is the wiki's
        info="$(curl -fsSL -m 6 -A "$DECK_UA" -w '\n%{url_effective}' \
                "$(printf "$FANDOM_FMT" "$c")/api.php?action=query&meta=siteinfo&siprop=general%7Cstatistics&format=json" 2>/dev/null)" || continue
        url="$(tail -1 <<<"$info")"; url="${url%%/api.php*}"
        sn="$(sed '$d' <<<"$info" | jq -r '.query.general.sitename // empty' 2>/dev/null)"
        arts="$(sed '$d' <<<"$info" | jq -r '.query.statistics.articles // 0' 2>/dev/null)"
        [[ -n "$sn" && "${arts:-0}" -ge 10 ]] || continue
        sc="$(wiki_score "$name" "$sn")"
        if (( sc >= 60 && (sc > bs || (sc == bs && arts > ba)) )); then best="$(jq -nc --arg b "$url" --arg n "$sn" --argjson a "$arts" '{base:$b, name:$n, articles:$a}')"; bs=$sc; ba=$arts; fi
    done < <(wiki_candidates "$name")
    mkdir -p "$GAMING_DIR"
    jq --arg i "$id" --argjson e "${best:-"{\"base\":\"\"}"}" --argjson t "$(date +%s)" '.[$i] = ($e + {checked:$t, manual:false})' <<<"$map" > "$WIKI_MAP.tmp" && mv "$WIKI_MAP.tmp" "$WIKI_MAP"
    echo "${best:-"{}"}"
}
# wiki <appid> [search <text> | page <title> | set <url> | clear]
cmd_wiki() {
    local id="$1" act="${2:-}" w base f map='{}'
    [[ "$id" =~ ^[0-9]+$ ]] || { err "use: wiki <appid> [search <text>|page <title>|set <url>|clear]"; return 2; }
    [[ -f "$WIKI_MAP" ]] && map="$(cat "$WIKI_MAP")"
    case "$act" in
        set)
            [[ "${3:-}" =~ ^https://[A-Za-z0-9.-]+\.fandom\.com(/[a-z-]+)?/?$ ]] || { err "use a Fandom wiki address, e.g. https://eldenring.fandom.com"; return 2; }
            mkdir -p "$GAMING_DIR"; base="${3%/}"
            jq --arg i "$id" --arg b "$base" --argjson t "$(date +%s)" '.[$i] = {base:$b, name:($b | sub("^https://"; "")), articles:0, checked:$t, manual:true}' <<<"$map" > "$WIKI_MAP.tmp" && mv "$WIKI_MAP.tmp" "$WIKI_MAP"
            log "✔ Wiki for $id: $base"; return 0 ;;
        clear)
            [[ -f "$WIKI_MAP" ]] && jq --arg i "$id" 'del(.[$i])' <<<"$map" > "$WIKI_MAP.tmp" && mv "$WIKI_MAP.tmp" "$WIKI_MAP"
            return 0 ;;
    esac
    w="$(wiki_get "$id")"; base="$(jq -r '.base // empty' <<<"$w")"
    case "$act" in
        "") echo "$w" ;;
        search)
            [[ -n "$base" ]] || { echo '[]'; return 0; }
            curl -fsSL -m 8 -A "$DECK_UA" -G "$base/api.php" --data-urlencode "srsearch=${3:-}" \
                --data-urlencode "action=query" --data-urlencode "list=search" --data-urlencode "srlimit=12" --data-urlencode "format=json" 2>/dev/null \
                | jq -c '[.query.search[]? | {title}]' 2>/dev/null || echo '{"error":"net"}' ;;
        page)
            [[ -n "$base" && -n "${3:-}" ]] || { echo '{}'; return 0; }
            mkdir -p "$WIKI_CACHE/$id"
            f="$WIKI_CACHE/$id/$(printf '%s' "$3" | md5sum | cut -c1-16).json"
            if [[ ! -s "$f" || -n "$(find "$f" -mmin +10080 2>/dev/null)" ]]; then
                curl -fsSL -m 10 -A "$DECK_UA" -G "$base/api.php" --data-urlencode "page=$3" --data-urlencode "action=parse" \
                    --data-urlencode "prop=text" --data-urlencode "redirects=1" --data-urlencode "disabletoc=1" --data-urlencode "format=json" 2>/dev/null \
                    | wiki_text "$base" "$(jq -r '.name // ""' <<<"$w")" > "$f.tmp" && jq -e '.text' "$f.tmp" >/dev/null 2>&1 && mv "$f.tmp" "$f"
                rm -f "$f.tmp"
            fi
            if [[ -s "$f" ]]; then cat "$f"; else echo '{"error":"net"}'; fi ;;
        *) err "use: wiki <appid> [search <text>|page <title>|set <url>|clear]"; return 2 ;;
    esac
}
# MediaWiki parse JSON (stdin) → {"title","url","text","source","license"}: readable
# text only (infoboxes, tables, navigation and references left out)
wiki_text() {   # base · wiki name
    python3 -c '
import html.parser, json, re, sys, urllib.parse
base, site = sys.argv[1], sys.argv[2]
d = json.load(sys.stdin)["parse"]
SKIP = {"aside", "table", "script", "style", "figure", "sup", "nav", "noscript", "gallery"}
VOID = {"br", "img", "hr", "input", "meta", "link", "wbr", "source", "col", "area"}
SKIPCLS = ("toc", "mw-editsection", "navbox", "reference", "gallery", "noprint", "printfooter", "mw-empty-elt", "wds-tabs", "portable-infobox", "quote")
class P(html.parser.HTMLParser):
    def __init__(s): super().__init__(); s.out = []; s.skip = 0; s.stack = []
    def handle_startendtag(s, t, a):
        if t == "br" and not s.skip: s.out.append("\n")
    def handle_starttag(s, t, a):
        cls = dict(a).get("class") or ""
        sk = t in SKIP or any(c in cls for c in SKIPCLS)
        if t in VOID:
            if t == "br" and not s.skip: s.out.append("\n")
            return
        s.stack.append(sk)
        if sk: s.skip += 1
        if s.skip: return
        if t in ("h2", "h3", "h4"): s.out.append("\n\n§ ")
        elif t == "li": s.out.append("\n• ")
        elif t in ("p", "div", "dd", "dl", "ul", "ol"): s.out.append("\n")
    def handle_endtag(s, t):
        if t in VOID or not s.stack: return
        if s.stack.pop(): s.skip -= 1; return
        if not s.skip and t in ("h2", "h3", "h4"): s.out.append("\n")
    def handle_data(s, x):
        if not s.skip: s.out.append(x)
p = P(); p.feed(d["text"]["*"])
t = re.sub(r"[ \t\r\f\v]+", " ", "".join(p.out))
t = re.sub(r" *\n *", "\n", t); t = re.sub(r"\n{3,}", "\n\n", t).strip()
if len(t) > 24000: t = t[:24000].rsplit("\n", 1)[0] + "\n…"
title = d.get("title", "")
print(json.dumps({"title": title, "url": base + "/wiki/" + urllib.parse.quote(title.replace(" ", "_")),
                  "text": t, "source": site or base, "license": "CC BY-SA 3.0"}, ensure_ascii=False))
' "$1" "$2"
}

# Fextralife's wikis of souls-likes (checked by hand: their terms forbid automated
# lookups, so nothing is probed; the site is only opened, never read)
fextra_base() {   # appid → https://<x>.wiki.fextralife.com or nothing
    local s=""
    case "$1" in
        1245620) s=eldenring ;;          2622380) s=eldenringnightreign ;;
        374320)  s=darksouls3 ;;         570940)  s=darksouls ;;
        335300|236430) s=darksouls2 ;;   814380)  s=sekiroshadowsdietwice ;;
        1627720) s=liesofp ;;            1501750) s=lordsofthefallen ;;
        1282100) s=remnant2 ;;           1888160) s=armoredcore6 ;;
        1325200) s=nioh2 ;;              1110910) s=mortalshell ;;
    esac
    [[ -n "$s" ]] && echo "https://$s.wiki.fextralife.com"
    return 0
}

# EliteGuías' own addresses for a game (worked out from its name, nothing is
# fetched): guide /guias/<l>/<initials>/<name>.php, achievements /trucos/<l>/<name>.php
# "Kingdom Come: Deliverance II" → kingdom-come-deliverance-2 · kcd2
eg_slug() {   # name → "<slug> <initials>"
    local n w slug="" ini="" words last
    n="${1//[™®©]/}"     # before iconv, which spells them out ("(TM)")
    n="$(iconv -f utf-8 -t ascii//TRANSLIT <<<"$n" 2>/dev/null || echo "$n")"
    n="$(tr '[:upper:]' '[:lower:]' <<<"$n" | sed -E "s/[^a-z0-9&' ]+/ /g; s/['™®©]//g; s/&/ /g")"
    read -ra words <<<"$n"
    last=$(( ${#words[@]} - 1 ))
    if (( last > 0 )); then
        case "${words[$last]}" in ii) words[last]=2 ;; iii) words[last]=3 ;; iv) words[last]=4 ;; esac
    fi
    for w in "${words[@]}"; do
        slug+="${slug:+-}$w"
        if [[ "$w" =~ ^[0-9]+$ ]]; then ini+="$w"; else ini+="${w:0:1}"; fi
    done
    [[ -n "$slug" ]] && echo "$slug $ini"
    return 0
}

# guides <appid> → guide sites: opened (in the overlay browser or yours), never copied.
# "search" is the address to append a search text to.
cmd_guides() {
    local id="$1" name w fx
    [[ "$id" =~ ^[0-9]+$ ]] || { err "use: guides <appid>"; return 2; }
    name="$(game_name "$id")"; w="$(wiki_get "$id")"; fx="$(fextra_base "$id")"
    local eg="" egt="" slug ini
    read -r slug ini <<<"$(eg_slug "$name")"
    if [[ -n "$slug" ]]; then
        eg="https://www.eliteguias.com/guias/${slug:0:1}/$ini/$slug.php"; egt="https://www.eliteguias.com/trucos/${slug:0:1}/$slug.php"
    fi
    jq -nc --arg id "$id" --arg n "$name" --argjson w "$w" --arg fx "$fx" --arg eg "$eg" --arg egt "$egt" '
        ($n | @uri) as $q | ("https://www.eliteguias.com/buscar.php?q=" + $q) as $egq |
        # straight to the guide / achievements page of the game; its search when there is none
        [ {label:"EliteGuías", sub:"guide", url:(if $eg != "" then $eg else $egq end), fallback:$egq, search:($egq + "%20")},
          {label:"EliteGuías", sub:"achievements", url:(if $egt != "" then $egt else $egq + "%20logros" end), fallback:($egq + "%20logros")} ]
        + (if $fx != "" then [{label:"Fextralife", sub:"wiki", url:$fx, search:($fx + "/Special:Search?search=")}] else [] end)
        + [
          {label:"Steam", sub:"community guides", url:("https://steamcommunity.com/app/" + $id + "/guides/")},
          {label:"Steam", sub:"global achievements", url:("https://steamcommunity.com/stats/" + $id + "/achievements/")} ]
        + (if ($w.base // "") != "" then [{label:"Wiki", sub:$w.name, url:$w.base}] else [] end)
        | if $n == "" then map(select(.label != "EliteGuías")) else . end'
}
# gopen <url> — open a guide in the browser (https and steam:// only)
cmd_gopen() {
    [[ "${1:-}" =~ ^(https://|steam://) ]] || { err "use: gopen <https://…>"; return 2; }
    have xdg-open || { err "xdg-open is missing"; return 4; }
    env -u LD_LIBRARY_PATH -u LD_PRELOAD setsid -f xdg-open "$1" >/dev/null 2>&1 </dev/null
    if [[ "$(cmd_uilang)" == es ]]; then notify "Abierto en el navegador" "Sal del juego (Alt+Tab) para leerlo."
    else notify "Opened in your browser" "Leave the game (Alt+Tab) to read it."; fi
}

# web <https://…> [--back] | web close — a guide in a small browser over the game
# (bin/gaming-deck-web: GTK + WebKit on the overlay layer); without it, your browser
WEB_PID="${GAMING_DECK_WEB_PID:-${XDG_RUNTIME_DIR:-/tmp}/gaming-deck-web.pid}"
web_helper() {
    local h; h="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/gaming-deck-web"
    [[ -x "$h" ]] || h="$HOME/.local/bin/gaming-deck-web"
    [[ -x "$h" ]] && have python3 && python3 -c 'import gi; gi.require_version("WebKit2", "4.1"); gi.require_version("GtkLayerShell", "0.1")' 2>/dev/null \
        && echo "$h"
    return 0
}
web_running() { local p; p="$(cat "$WEB_PID" 2>/dev/null)"; [[ "$p" =~ ^[0-9]+$ ]] && [[ -d "${PROC_ROOT:-/proc}/$p" ]]; }
cmd_web() {
    if [[ "${1:-}" == close ]]; then
        web_running && kill "$(cat "$WEB_PID")" 2>/dev/null
        return 0
    fi
    [[ "${1:-}" =~ ^https:// ]] || { err "use: web <https://…> [--back] [--fallback <https://…>] | web close"; return 2; }
    local url="$1" back="" fb=""; shift
    while (( $# )); do
        case "$1" in
            --back) back=--back ;;
            --fallback) [[ "${2:-}" =~ ^https:// ]] && fb="$2"; shift ;;
        esac; shift
    done
    local h; h="$(web_helper)"
    [[ -n "$h" ]] || { cmd_gopen "$url"; return; }     # webkit2gtk-4.1 / gtk-layer-shell missing
    panel_env; mkdir -p "$STATE_DIR/logs"
    env -u LD_LIBRARY_PATH -u LD_PRELOAD -u SteamAppId -u SteamGameId -u SteamOverlayGameId GDK_BACKEND=wayland \
        CD_WEB_BIN="$(readlink -f "${BASH_SOURCE[0]}")" \
        setsid -f "$h" "$url" $back ${fb:+--fallback "$fb"} --lang "$(cmd_uilang)" >"$STATE_DIR/logs/web.log" 2>&1 </dev/null
}

# notes <appid> [set <text>] — the player's own notes for a game
cmd_notes() {
    local id="$1" f
    [[ "$id" =~ ^[0-9]+$ ]] || { err "use: notes <appid> [set <text>]"; return 2; }
    f="$NOTES_DIR/$id.md"
    case "${2:-}" in
        "") [[ -f "$f" ]] && cat "$f"; return 0 ;;
        set) mkdir -p "$NOTES_DIR"; printf '%s' "${3:-}" > "$f.tmp" && mv "$f.tmp" "$f" ;;
        *) err "use: notes <appid> [set <text>]"; return 2 ;;
    esac
}

# --- the panel itself ---
panel_env() {   # Steam starts games without these sometimes, and its libraries break Qt
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        local s; for s in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-[0-9]; do
            [[ -S "$s" ]] && { export WAYLAND_DISPLAY="${s##*/}"; break; }
        done
    fi
}
panel_launch() {   # show(1)|hidden(0)
    [[ -f "$PANEL_QML" ]] || { err "panel not installed ($PANEL_QML): run install.sh"; return 4; }
    have qs || { err "quickshell (qs) is needed for the panel"; return 4; }
    panel_env; mkdir -p "$STATE_DIR/logs"
    # without the game's SteamAppId: the panel (and what it runs) must not look like the game
    env -u LD_LIBRARY_PATH -u LD_PRELOAD -u SteamAppId -u SteamGameId -u SteamOverlayGameId CD_PANEL_SHOW="$1" CD_PANEL_BIN="$(readlink -f "${BASH_SOURCE[0]}")" \
        setsid -f qs -n -p "$PANEL_QML" >"$STATE_DIR/logs/panel.log" 2>&1 </dev/null
}
panel_ipc() { panel_env; env -u LD_LIBRARY_PATH -u LD_PRELOAD qs ipc -p "$PANEL_QML" call panel "$1" >/dev/null 2>&1; }

# the activation key, written into Hyprland's config between two marker lines
panel_hypr_conf() {
    local d="${GAMING_DECK_HYPR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr}"
    if [[ -f "$d/hyprland.lua" ]]; then echo "$d/hyprland.lua"; elif [[ -f "$d/hyprland.conf" ]]; then echo "$d/hyprland.conf"; fi
}
panel_key_mods() {   # "SUPER + SHIFT + G" → modmask · key
    local m=0 k="" p
    IFS='+' read -ra parts <<<"$1"
    for p in "${parts[@]}"; do
        p="$(tr -d ' ' <<<"$p")"
        case "${p^^}" in
            SUPER|WIN|MOD4) m=$(( m | 64 )) ;; SHIFT) m=$(( m | 1 )) ;; CTRL|CONTROL) m=$(( m | 4 )) ;; ALT|MOD1) m=$(( m | 8 )) ;;
            *) k="$p" ;;
        esac
    done
    echo "$m $k"
}
panel_key() {   # KEY | off
    local key="$1" conf bin tmp m k other
    conf="$(panel_hypr_conf)"; [[ -n "$conf" ]] || { err "Hyprland's config not found (~/.config/hypr/hyprland.lua or .conf)"; return 3; }
    if [[ "$key" != off ]]; then
        [[ "$key" =~ ^[A-Za-z0-9_]+([[:space:]]*\+[[:space:]]*[A-Za-z0-9_]+)*$ ]] || { err "not a key: $key (e.g. F6, SUPER + G)"; return 2; }
        read -r m k <<<"$(panel_key_mods "$key")"
        [[ -n "$k" ]] || { err "not a key: $key"; return 2; }
        # a bind already on that key (not ours) wins: say which
        if have hyprctl; then
            other="$(hyprctl binds -j 2>/dev/null | jq -r --argjson m "$m" --arg k "$k" \
                '.[] | select(.modmask == $m and (.key | ascii_downcase) == ($k | ascii_downcase))
                 | select(((.arg // "") | test("gaming-deck panel")) or (.description // "") == "Gaming Deck: in-game panel" | not)
                 | if (.description // "") != "" then .description else "\(.dispatcher) \(.arg // "")" end' 2>/dev/null | head -1)"
            [[ -n "$other" ]] && { err "$key is already used in Hyprland ($other): choose another key"; return 3; }
        fi
    fi
    bin="$(gaming_deck_bin)"
    [[ -f "$conf.gaming-deck.bak" ]] || cp -p "$conf" "$conf.gaming-deck.bak"
    tmp="$(mktemp)"
    awk -v b="$PANEL_MARK_BEGIN" -v e="$PANEL_MARK_END" 'index($0, b) { skip = 1 } !skip { print } index($0, e) { skip = 0 }' "$conf" > "$tmp"
    if [[ "$key" != off ]]; then
        if [[ "$conf" == *.lua ]]; then
            printf -- '-- %s\nhl.bind("%s", hl.dsp.exec_cmd("%s panel"), { description = "Gaming Deck: in-game panel" })\n-- %s\n' \
                "$PANEL_MARK_BEGIN" "$key" "$bin" "$PANEL_MARK_END" >> "$tmp"
        else
            local mods=""; [[ "$key" == *+* ]] && mods="$(sed -E 's/[[:space:]]*\+[[:space:]]*[^+]*$//; s/[[:space:]]*\+[[:space:]]*/ /g' <<<"$key")"
            printf '# %s\nbind = %s, %s, exec, %s panel\n# %s\n' "$PANEL_MARK_BEGIN" "$mods" "$k" "$bin" "$PANEL_MARK_END" >> "$tmp"
        fi
    fi
    cat "$tmp" > "$conf"; rm -f "$tmp"
    panel_setting_set key "$(jq -n --arg k "$key" '$k')"
    if [[ "$key" == off ]]; then log "✔ In-game panel key removed from ${conf/#$HOME/\~}."
    else log "✔ In-game panel on $key (${conf/#$HOME/\~}; Hyprland reloads it by itself)."; fi
}

# panel [toggle|show|hide|start|key <KEY|off>|toast on|off|status]
cmd_panel() {
    case "${1:-toggle}" in
        toggle|show|hide)
            # the key with a guide open over the game: close it, that's all
            if [[ "${1:-toggle}" != show ]] && web_running; then cmd_web close; return 0; fi
            local fn="${1:-toggle}"; fn="${fn/show/open}"; fn="${fn/hide/close}"
            panel_ipc "$fn" && return 0
            [[ "${1:-toggle}" == hide ]] && return 0
            panel_launch 1 ;;
        start) panel_ipc ping || panel_launch 0 ;;     # hidden: only watches for achievements
        key) need "${2:-}" "use: panel key <KEY|off>"; panel_key "$2" ;;
        toast)
            case "${2:-}" in on) panel_setting_set toast true ;; off) panel_setting_set toast false ;; *) err "use: panel toast on|off"; return 2 ;; esac
            log "✔ Achievement pop-ups: $2." ;;
        status)
            jq -nc --arg k "$(panel_setting key "")" --argjson t "$(panel_setting toast true)" \
                --argjson inst "$([[ -f "$PANEL_QML" ]] && echo true || echo false)" \
                --argjson run "$(panel_ipc ping && echo true || echo false)" \
                '{key:(if $k == "" then null else $k end), toast:$t, installed:$inst, running:$run}' ;;
        *) err "use: panel [toggle|show|hide|start|key <KEY|off>|toast on|off|status]"; return 2 ;;
    esac
}
# anti-cheat a game folder ships → JSON list
game_ac_files() {
    [[ -d "$1" ]] || { echo '[]'; return 0; }
    find "$1" -maxdepth 4 \( -iname 'EasyAntiCheat*' -o -iname 'BattlEye' -o -iname 'BEService*' -o -iname 'vgc.exe' \) 2>/dev/null \
        | awk '{ l = tolower($0) } l ~ /easyanticheat/ { print "Easy Anti-Cheat" } l ~ /battleye|beservice/ { print "BattlEye" } l ~ /vgc\.exe/ { print "Vanguard" }' \
        | jq -Rsc 'split("\n") | map(select(. != "")) | unique'
}
# ovgames → every installed Steam game with its achievements and wiki, for OVERLAY
cmd_ovgames() {
    local id name dir size lib a w ac
    {
        while IFS= read -r id && IFS= read -r name && IFS= read -r dir && IFS= read -r size && IFS= read -r lib; do
            a="$(cmd_ach "$id" | jq -c 'if .error then null else {unlocked, total, percent} end' 2>/dev/null)"
            w="$(wiki_get "$id")"; ac="$(fx_online "$id" | jq -c '.anticheats' 2>/dev/null)"
            # …and what the game's own folder ships (AreWeAntiCheatYet misses some, e.g. Lords of the Fallen)
            ac="$(jq -c --argjson f "$(game_ac_files "$lib/steamapps/common/$dir")" '. + $f | unique' <<<"${ac:-[]}")"
            # anti-cheat: shown so it's clear why the panel never goes into the game
            jq -nc --arg id "$id" --arg n "$name" --argjson a "${a:-null}" --argjson w "${w:-"{}"}" --argjson ac "${ac:-[]}" \
                '{appid:$id, name:$n, ach:$a, wiki:$w, anticheats:$ac}'
        done < <(steam_games)
    } | jq -sc 'sort_by(.name | ascii_downcase)'
}

# run/session: the panel watches for achievements while the game runs
panel_autostart() {
    [[ "$(panel_setting toast true)" == true && -f "$PANEL_QML" ]] && have qs || return 0
    cmd_panel start >/dev/null 2>&1 || true
}

# ------------------------------------------------------ 2.14 visual shaders ----
# vkBasalt (a Vulkan layer) runs ReShade FX shaders and its own CAS/SMAA/FXAA on
# any game that draws through Vulkan: native Vulkan, and D3D9–12 under Proton
# (DXVK / VKD3D). Same on AMD and NVIDIA. Shaders come from the packages the
# official ReShade installer lists (EffectPackages.ini); per-game presets from
# the SweetFX Settings DB are converted to a vkBasalt config (see fx_convert for
# what can't be carried over). The wrapper turns it on with ENABLE_VKBASALT=1.
FX_DIR="$DATA_HOME/gaming-deck/reshade"               # Shaders/ Textures/ packages.json
FX_PROFILES="$GAMING_DIR/fx"                            # <key>/vkBasalt.conf, preset.ini, report.json
FX_CACHE="$CACHE_HOME/gaming-deck/fx"
FX_PACKAGES_URL="${GAMING_DECK_FX_PACKAGES_URL:-https://raw.githubusercontent.com/crosire/reshade-shaders/list/EffectPackages.ini}"
SFX_URL="${GAMING_DECK_SFX_URL:-https://sfx.thelazy.net}"
AWACY_URL="${GAMING_DECK_AWACY_URL:-https://raw.githubusercontent.com/AreWeAntiCheatYet/AreWeAntiCheatYet/master/games.json}"
STEAM_STORE_API="${GAMING_DECK_STEAM_STORE_API:-https://store.steampowered.com/api/appdetails}"
FX_UA="gaming-deck (+https://github.com/madkyp/gaming-deck)"

fx_key_dir() { echo "$FX_PROFILES/${1//:/_}"; }

# the key that opens ReShade's menu / toggles vkBasalt (one for every game)
FX_SETTINGS="$GAMING_DIR/fx.json"
fx_key() { local k; k="$(jq -r '.key // empty' "$FX_SETTINGS" 2>/dev/null)"; echo "${k:-Home}"; }
fx_vk() {   # key name → Windows virtual-key code (ReShade.ini)
    case "$1" in Home) echo 36 ;; End) echo 35 ;; Insert) echo 45 ;; PrtSc) echo 44 ;; F8) echo 119 ;; F9) echo 120 ;; F10) echo 121 ;; F11) echo 122 ;; F12) echo 123 ;; None) echo 0 ;; *) echo 36 ;; esac
}
# one setting of fx.json changed, the others kept
fx_settings_set() {   # name value
    local cur; cur="$(jq -c 'objects' "$FX_SETTINGS" 2>/dev/null)"; [[ -n "$cur" ]] || cur='{}'
    mkdir -p "$GAMING_DIR"
    jq -n --argjson c "$cur" --arg k "$1" --arg v "$2" '$c + {($k): $v}' > "$FX_SETTINGS"
}
# ReShade's screenshot key (KeyScreenshot). PrtSc by default, but desktops often take
# it for their own screenshots (HyDE/Hyprland binds Print), so the game never sees it.
fx_shot_key() { local k; k="$(jq -r '.shotKey // empty' "$FX_SETTINGS" 2>/dev/null)"; echo "${k:-PrtSc}"; }
# fx shotkey <PrtSc|F8|F10|F11> — saved and pushed to every game set up with ReShade
cmd_fx_shotkey() {
    local k="$1" f dir
    [[ "$k" =~ ^(PrtSc|F8|F10|F11)$ ]] || { err "use: fx shotkey PrtSc|F8|F10|F11"; return 2; }
    [[ "$k" == "$(fx_key)" || "$k" == "$(fx_effects_key)" ]] && { err "$k is already the menu or the on/off key"; return 2; }
    fx_settings_set shotKey "$k"
    for f in "$FX_PROFILES"/*/reshade.json; do
        [[ -f "$f" ]] || continue
        dir="$(jq -r .dir "$f")"
        [[ -f "$dir/ReShade.ini" ]] && ini_set "$dir/ReShade.ini" INPUT KeyScreenshot "$(fx_vk "$k"),0,0,0"
    done
    log "✔ ReShade screenshot key: $k (a game already open keeps the old one until it restarts)"
}
# ReShade's effects on/off switch (KeyEffects); End by default, "None" = no key
fx_effects_key() { local k; k="$(jq -r '.effectsKey // empty' "$FX_SETTINGS" 2>/dev/null)"; echo "${k:-End}"; }
# fx key <Home|Insert|F10|F11|F12> — saved and pushed to every game already set up
cmd_fx_key() {
    local k="$1" f st dir
    [[ "$k" =~ ^(Home|Insert|F10|F11|F12)$ ]] || { err "use: fx key Home|Insert|F10|F11|F12"; return 2; }
    fx_settings_set key "$k"
    for f in "$FX_PROFILES"/*/vkBasalt.conf; do
        [[ -f "$f" ]] && sed -i "s/^toggleKey = .*/toggleKey = $k/" "$f"
    done
    for f in "$FX_PROFILES"/*/reshade.json; do
        [[ -f "$f" ]] || continue
        dir="$(jq -r .dir "$f")"
        [[ -f "$dir/ReShade.ini" ]] && ini_set "$dir/ReShade.ini" INPUT KeyOverlay "$(fx_vk "$k"),0,0,0"
    done
    log "✔ In-game shader key: $k (a game already open keeps the old one until it restarts)"
}

# fx effectskey <End|F9|None> — ReShade's "all effects on/off" key, every game
cmd_fx_effectskey() {
    local k="$1" f dir
    [[ "$k" =~ ^(End|F9|None)$ ]] || { err "use: fx effectskey End|F9|None"; return 2; }
    fx_settings_set effectsKey "$k"
    for f in "$FX_PROFILES"/*/reshade.json; do
        [[ -f "$f" ]] || continue
        dir="$(jq -r .dir "$f")"
        [[ -f "$dir/ReShade.ini" ]] && ini_set "$dir/ReShade.ini" INPUT KeyEffects "$(fx_vk "$k"),0,0,0"
    done
    log "✔ Effects on/off key: $k (a game already open keeps the old one until it restarts)"
}

# cached download: fx_cached <file> <max age s> <url>  (stale copy beats nothing)
fx_cached() {
    local f="$FX_CACHE/$1" age="$2" url="$3" tmp
    mkdir -p "$FX_CACHE"
    if [[ -s "$f" ]] && (( $(date +%s) - $(stat -c %Y "$f") < age )); then cat "$f"; return 0; fi
    tmp="$(mktemp)"
    if curl -fsSL --max-time 20 -A "$FX_UA" "$url" -o "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        mv "$tmp" "$f"; cat "$f"
    else
        rm -f "$tmp"; [[ -s "$f" ]] && cat "$f"
    fi
}

# EffectPackages.ini → JSON [{idx,name,desc,url,repo,sub,files:[…],deny:[…],default}]
fx_packages() {
    fx_cached EffectPackages.ini 604800 "$FX_PACKAGES_URL" | tr -d '\r' | awk '
        function flush() { if (sec != "") print sec "\t" en "\t" nm "\t" ds "\t" u "\t" rp "\t" ip "\t" ef "\t" dn }
        /^\[/ { flush(); sec = substr($0, 2, length($0) - 2); en = ""; nm = ""; ds = ""; u = ""; rp = ""; ip = ""; ef = ""; dn = ""; next }
        { i = index($0, "="); if (!i) next; k = substr($0, 1, i - 1); v = substr($0, i + 1) }
        k == "Enabled" { en = v } k == "Required" { en = v } k == "PackageName" { nm = v }
        k == "PackageDescription" { ds = v } k == "DownloadUrl" { u = v } k == "RepositoryUrl" { rp = v }
        k == "InstallPath" { ip = v } k == "EffectFiles" { ef = v } k == "DenyEffectFiles" { dn = v }
        END { flush() }' \
    | jq -Rsc --slurpfile inst <(fx_installed_json) --argjson extra "$(fx_extra_packages)" \
          --argjson dirs "$(find "$FX_DIR/Shaders" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | jq -Rsc 'split("\n") | map(select(. != ""))')" '
        [split("\n")[] | select(. != "") | split("\t")
         | {idx:.[0], default:(.[1] == "1"), name:.[2], desc:.[3], url:.[4], repo:.[5],
            sub:(.[6] | sub("^\\.\\\\reshade-shaders\\\\Shaders\\\\?"; "") | gsub("\\\\"; "/")),
            files:(.[7] | split(",") | map(select(. != ""))), deny:(.[8] | split(",") | map(select(. != "")))}]
        + $extra
        # installed: recorded by fx_install_pkg, or its own folder already there (put by hand)
        | map(.sub as $s | . + {installed:((($inst[0][.idx] // null) != null) or ($s != "" and ($dirs | index($s)) != null))})'
}
fx_installed_json() { if [[ -s "$FX_DIR/packages.json" ]]; then cat "$FX_DIR/packages.json"; else echo '{}'; fi; }

# free shader packs that presets use but ReShade's installer doesn't list; same shape
# as fx_packages, merged into it. Checked by hand: repo, license, folder layout, files.
FX_EXTRA_PACKAGES='[
  {"idx":"x-niceguy", "default":false, "extra":true, "name":"NiceGuy-Shaders by Ehsan2077 (community)",
   "desc":"NGLighting (ray traced GI), lamps, volumetric fog, rim light… CC0.",
   "url":"https://github.com/mj-ehsan/NiceGuy-Shaders/archive/refs/heads/main.zip",
   "repo":"https://github.com/mj-ehsan/NiceGuy-Shaders", "sub":"NiceGuy-Shaders",
   "files":["NGLighting.fx","NiceGuy_Lamps.fx","DynamicRaindrops.fx","FastSharp.fx","HoleFiller.fx","Rim.fx","Scatter.fx","SlowSharp.fx","Volumetric Fog V2.0.fx","VolumetricFog.fx"],
   "deny":[]}]'
fx_extra_packages() { if [[ -n "${GAMING_DECK_FX_EXTRA_PACKAGES:-}" ]]; then cat "$GAMING_DECK_FX_EXTRA_PACKAGES"; else echo "$FX_EXTRA_PACKAGES"; fi; }

# download one package and merge it: shaders keep the package's sub-folder,
# textures are flattened (vkBasalt takes a single texture folder)
fx_install_pkg() {
    local idx="$1" p url sub tmp top shd tex f n=0
    p="$(fx_packages | jq -c --arg i "$idx" '.[] | select(.idx == $i)')"
    [[ -n "$p" ]] || { err "unknown shader package: $idx"; return 2; }
    url="$(jq -r .url <<<"$p")"; sub="$(jq -r .sub <<<"$p")"
    [[ "$url" == https://github.com/* || "$url" == file://* ]] || { err "unexpected download URL: $url"; return 4; }
    log "→ $(jq -r .name <<<"$p")  ($url)"
    tmp="$(mktemp -d)"
    if ! curl -fsSL --max-time 300 -A "$FX_UA" "$url" -o "$tmp/p.zip" || ! bsdtar -xf "$tmp/p.zip" -C "$tmp"; then
        rm -rf "$tmp"; err "download failed: $url"; return 4
    fi
    top="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -1)"
    shd="$(find "$top" -type d -iname Shaders | awk '{ print length, $0 }' | sort -n | head -1 | cut -d' ' -f2-)"
    tex="$(find "$top" -type d -iname Textures | awk '{ print length, $0 }' | sort -n | head -1 | cut -d' ' -f2-)"
    mkdir -p "$FX_DIR/Shaders/$sub" "$FX_DIR/Textures"
    if [[ -n "$shd" ]]; then cp -rf "$shd"/. "$FX_DIR/Shaders/$sub/"
    else find "$top" -type f \( -name '*.fx' -o -name '*.fxh' \) -exec cp -f {} "$FX_DIR/Shaders/$sub/" \; ; fi
    [[ -n "$tex" ]] && find "$tex" -type f -exec cp -f {} "$FX_DIR/Textures/" \;
    while IFS= read -r f; do
        [[ -n "$f" ]] && find "$FX_DIR/Shaders/$sub" -type f -name "$f" -delete
    done < <(jq -r '.deny[]' <<<"$p")
    n="$(find "$FX_DIR/Shaders/$sub" -name '*.fx' | wc -l)"
    rm -rf "$tmp"
    local cur; cur="$(fx_installed_json)"
    jq --arg i "$idx" --arg n "$(jq -r .name <<<"$p")" --argjson t "$(date +%s)" '.[$i] = {name:$n, installed:$t}' \
        <<<"$cur" > "$FX_DIR/packages.json"
    log "  ✔ installed ($n effects in Shaders/${sub:-.})"
}

# the .fx file for an effect name, searched like ReShade does (recursively)
fx_find() { find "$FX_DIR/Shaders" -type f -iname "$1" 2>/dev/null | head -1; }

# is this game known to use anti-cheat / to be online? → JSON
# Umbral games: AreWeAntiCheatYet by name — an entry whose name starts the
# game's name counts ("World of Warcraft" → "World of Warcraft: Forever (beta)")
fx_online_by_name() {
    local n; n="$(fx_norm "$1")"
    fx_cached awacy.json 604800 "$AWACY_URL" | jq -c --arg n "$n" '
        def norm: ascii_downcase | gsub("[™®©]"; "") | gsub("[^a-z0-9]+"; "");
        [.[] | (.name | norm) as $a | select(($a | length) >= 8 and ($n | startswith($a))) | select(.anticheats | length > 0)]
        | sort_by(-(.name | length)) | first
        | if . then {anticheats, multiplayer:true, awacyStatus:.status, level:"anticheat"}
          else {anticheats:[], multiplayer:false, awacyStatus:null, level:"none"} end' 2>/dev/null \
        || echo '{"anticheats":[],"multiplayer":false,"awacyStatus":null,"level":"none"}'
}

fx_online() {
    local id="$1" aw cats
    aw="$(fx_cached awacy.json 604800 "$AWACY_URL" | jq -c --arg id "$id" \
          '[.[] | select((.storeIds.steam // "") == $id)] | first // null | if . then {anticheats, status} else null end' 2>/dev/null)"
    cats="$(fx_cached "store-$id.json" 604800 "$STEAM_STORE_API?appids=$id&filters=categories&l=english" \
            | jq -c --arg id "$id" '[.[$id].data.categories[]? | .id]' 2>/dev/null)"
    jq -nc --argjson aw "${aw:-null}" --argjson c "${cats:-[]}" '
        ($c | index(8) != null) as $vac
        | ([$c[] | select(. == 1 or . == 9 or . == 27 or . == 36 or . == 38 or . == 49)] | length > 0) as $mp
        | {anticheats:((($aw // {}).anticheats // []) + (if $vac then ["VAC"] else [] end) | unique),
           multiplayer:$mp, awacyStatus:(($aw // {}).status // null)}
        | .level = (if (.anticheats | length) > 0 then "anticheat" elif .multiplayer then "online" else "none" end)'
}

# can vkBasalt reach this game? → JSON {ok, route, reason}
fx_route() {
    local key="$1" p env
    p="$(profile_get "$key")"; env="$(jq -r '.env | to_entries | map("\(.key)=\(.value)") | join(" ")' <<<"$p")"
    if [[ "$key" == umbral:* ]]; then
        jq -nc '{ok:true, route:"vulkan", reason:"Umbral runs it with umu-Proton: D3D9–12 goes through DXVK/VKD3D (Vulkan). A 2D game drawn with GDI (RPG Maker XP…) takes no shaders at all."}'
    elif [[ "$key" != steam:* ]]; then
        jq -nc '{ok:false, route:"none", reason:"Only Steam and Umbral games can get shaders."}'
    elif [[ "$env" =~ PROTON_USE_WINED3D=1 ]]; then
        jq -nc '{ok:false, route:"wined3d", reason:"PROTON_USE_WINED3D=1 draws with OpenGL: vkBasalt only works on Vulkan. Remove it from ENV."}'
    else
        jq -nc '{ok:true, route:"vulkan", reason:"Under Proton, D3D9–12 is drawn through DXVK/VKD3D (Vulkan), so vkBasalt applies; a native Linux game only if it renders with Vulkan (not OpenGL)."}'
    fi
}

# fx status [key] → install state, GPU, and (with a key) route, online risk, current preset
# which route suits a game, and why: {pick: reshade|vkbasalt|none, reasons:[…]}
# Anti-cheat games whose anti-cheat accepts plain ReShade (the build without add-ons, which is what
# "fx reshade install" gets): Steam app id → why we know. Only games where it is established.
FX_RESHADE_AC_OK='{"1245620":"Elden Ring: popular ReShade presets (e.g. Nexus \"Unreal ReShade\") are played online with Easy Anti-Cheat on"}'
fx_advice() {   # key exes-json online-json report-json
    local key="$1" exes="$2" online="$3" cur="$4" native=""
    if [[ "$(jq length <<<"$exes")" == 0 && "$key" == steam:* ]]; then
        # no .exe: a native Linux build — Vulkan or OpenGL decides
        local dir f; dir="$(steam_game_dir "${key#steam:}")"
        if [[ -d "$dir" ]]; then
            native=opengl
            while IFS= read -r f; do
                [[ "$(head -c 4 "$f" 2>/dev/null)" == $'\x7fELF' ]] || continue
                grep -qa 'libvulkan\.so' "$f" && { native=vulkan; break; }
            done < <(find "$dir" -maxdepth 3 -type f -size +500k \( -perm -u+x -o -name '*.so*' \) 2>/dev/null | head -40)
        fi
    fi
    jq -nc --argjson exes "$exes" --argjson online "${online:-null}" --argjson cur "${cur:-null}" --arg native "$native" \
        --argjson acok "$FX_RESHADE_AC_OK" --arg id "${key#steam:}" '
        ($exes[0].api // "unknown") as $api
        | (($online // {}).level // "none") as $risk
        | $acok[$id] as $acwhy
        | ([($cur // {}).skipped[]? | select(.why | test("depth"))] | length) as $depth
        | if $native == "vulkan" then {pick:"vkbasalt", reasons:["Native Linux build that draws with Vulkan: vkBasalt is the only one that can hook it (ReShade needs a Windows game)."]}
          elif $native == "opengl" then {pick:"none", reasons:["Native Linux build that draws with OpenGL: neither vkBasalt (Vulkan only) nor ReShade (Windows only) can hook it."]}
          elif $api == "gdi" then {pick:"none", reasons:["2D game drawn with GDI (RPG Maker style): no shader tool can hook it."]}
          elif $api == "vulkan" then {pick:"vkbasalt", reasons:["The game renders with Vulkan: ReShade'"'"'s DLL can'"'"'t hook it here, vkBasalt can."]}
          elif $risk == "anticheat" and $acwhy != null then {pick:"reshade", reasons:[
                "Anti-cheat (\(($online.anticheats // []) | join(", "))) that accepts plain ReShade: \($acwhy).",
                "Use Gaming Deck'"'"'s ReShade (no add-ons build) and IMPORT the preset; skip the DLL some presets ship.",
                "vkBasalt is not recommended here: with converted presets this game can stay on a white screen."]}
          elif $risk == "anticheat" then {pick:"vkbasalt", reasons:[
                "Online game with anti-cheat (\(($online.anticheats // []) | join(", "))): neither is safe there.",
                "If you use one anyway, vkBasalt is the lighter touch: a Vulkan layer, no DLL or files in the game folder."]}
          else {pick:"reshade", reasons:(
                ["\(if $api == "dxgi" then "DirectX 10–12" elif $api == "d3d9" then "DirectX 9" elif $api == "opengl32" then "OpenGL" else "A Windows game" end) under Proton: ReShade itself runs presets exactly as made, depth effects included, with its in-game menu to tweak them."]
                + (if $depth > 0 then ["Your current preset has \($depth) depth effect(s) vkBasalt has to skip."] else [] end)
                + (if $risk == "online" then ["Has online modes without anti-cheat: fine for single-player; check the game'"'"'s rules online."] else [] end)
                + ["vkBasalt also works (via DXVK/VKD3D) if you prefer nothing in the game folder; presets get converted and lose depth effects."])}
          end'
}

cmd_fx_status() {
    local key="${1:-}" v64 v32 n cur="null" route="null" online="null" d rs="null" exes="[]" mode="vkbasalt" wrapped=false
    v64="$(pkg_ver vkbasalt)"; v32="$(pkg_ver lib32-vkbasalt)"
    n="$(find "$FX_DIR/Shaders" -name '*.fx' 2>/dev/null | wc -l)"
    if [[ -n "$key" ]]; then
        valid_game_key "$key" || { err "not a game key: $key"; return 2; }
        d="$(fx_key_dir "$key")"
        if [[ -s "$d/report.json" ]]; then
            cur="$(cat "$d/report.json")"
            # which shader pack each effect comes from (the folder under Shaders/)
            local e fp packs="{}"
            while IFS= read -r e; do
                [[ -n "$e" ]] || continue
                fp="$(fx_find "$e")"; fp="${fp#"$FX_DIR/Shaders/"}"
                packs="$(jq -c --arg e "$e" --arg p "$([[ "$fp" == */* ]] && echo "${fp%%/*}")" '. + {($e): $p}' <<<"$packs")"
            done < <(jq -r '.effects[]?' <<<"$cur")
            cur="$(jq -c --argjson p "$packs" --arg ini "${d/#$HOME/\~}/ReShadePreset.ini" '. + {packs:$p, presetFile:$ini}' <<<"$cur")"
            # what the preset does (the whole downloaded/imported one, switched-off effects included)
            local rv; rv="$(cmd_fx_review "$key" 2>/dev/null)" && cur="$(jq -c --argjson r "$rv" '. + {review:$r}' <<<"$cur")"
        fi
        route="$(fx_route "$key")"
        if [[ "$key" == steam:* || "$key" == umbral:* ]]; then
            if [[ "$key" == steam:* ]]; then online="$(fx_online "${key#steam:}")"
            else online="$(fx_online_by_name "$(umbral_game_name "$key")")"; fi
            exes="$(cmd_fx_exes "$key" 2>/dev/null | jq -c '.[0:6] | map({path, rel, arch, api})')"; [[ -n "$exes" ]] || exes="[]"
            rs="$(reshade_state "$key")"; [[ -n "$rs" ]] || rs="null"
            mode="$(profile_get "$key" | jq -r '.fxMode // "vkbasalt"')"
            if [[ "$key" == steam:* ]]; then wrapped="$(game_wrapped "${key#steam:}" && echo true || echo false)"
            else wrapped="$(umbral_has_hook && echo true || echo false)"; fi
        fi
    fi
    jq -nc --arg v64 "$v64" --arg v32 "$v32" --argjson n "$n" --arg vendor "$(gpu_vendor)" --arg gpu "$(gpu_name)" \
        --argjson cur "$cur" --argjson route "$route" --argjson online "$online" \
        --argjson rs "$rs" --argjson exes "$exes" --arg mode "$mode" --argjson wrapped "$wrapped" --arg wrappedKey "${key%%:*}" \
        --argjson steamRunning "$(steam_running && echo true || echo false)" --arg key "$(fx_key)" --arg ekey "$(fx_effects_key)" --arg skey "$(fx_shot_key)" \
        --arg shots "$(if [[ -n "$key" ]]; then reshade_shots_dir "$key" | sed "s|^$HOME|~|"; fi)" \
        --argjson advice "$(if [[ -n "$key" ]]; then fx_advice "$key" "$exes" "$online" "$cur"; else echo null; fi)" \
        --argjson links "$(if [[ "$key" == steam:* ]]; then fx_links_json | jq -c --arg k "$key" --arg a "$(jq -r '.archive // ""' <<<"$cur" 2>/dev/null)" '
            # a Nexus file is named <name>-<mod id>-<version>-<time>: that link is the installed preset
            (.[$k] // []) | map(. + {installed:(($a != "") and ((.url | capture("nexusmods\\.com/[^/]+/mods/(?<id>[0-9]+)")? .id) as $id
                                                   | $id != null and ($a | test("-" + $id + "-"))))})'; else echo '[]'; fi)" \
        --arg rver "$(reshade_version | sed 's/^ReShade-//')" --arg rlatest "$(reshade_latest 2>/dev/null)" \
        --arg d3dc "$([[ -f "$RESHADE_BIN/d3dcompiler_47.dll.64" && -f "$RESHADE_BIN/d3dcompiler_47.dll.32" ]] && echo 1 || echo 0)" \
        --arg chaotic "$(grep -qE '^[[:space:]]*\[chaotic-aur\]' "$PACMAN_CONF" 2>/dev/null && echo 1 || echo 0)" '{
        vkbasalt:($v64 != ""), vkbasalt32:($v32 != ""), version:$v64, effects:$n, shadersInstalled:($n > 0),
        chaotic:($chaotic == "1"), vendor:$vendor, gpu:$gpu, current:$cur, route:$route, online:$online,
        installCmd:(if $v64 != "" and $v32 != "" then "" else "sudo pacman -S --needed vkbasalt lib32-vkbasalt" end),
        mode:$mode, wrapped:$wrapped, steamRunning:$steamRunning, key:$key, effectsKey:$ekey, shotKey:$skey, links:$links, shotsDir:$shots,
        reshade:{version:$rver, latest:$rlatest, ready:($rver != "" and $d3dc == "1"),
                 update:($rver != "" and $rlatest != "" and $rver != $rlatest), game:$rs, exes:$exes},
        recommended:(($advice // {}).pick // "reshade"), advice:$advice,
        source:(if $wrappedKey == "umbral" then "umbral" else "steam" end)}'
}

# fx install — vkBasalt (pkexec pacman, chaotic-aur) + the default shader packages
cmd_fx_install() {
    local miss=() p
    for p in vkbasalt lib32-vkbasalt; do [[ -n "$(pkg_ver "$p")" ]] || miss+=("$p"); done
    if ((${#miss[@]})); then
        pacman -Si vkbasalt >/dev/null 2>&1 || { err "vkbasalt isn't in your repositories (it comes from chaotic-aur): enable chaotic-aur or install it from the AUR"; return 4; }
        log "→ pkexec pacman -S --needed ${miss[*]}"
        pk_pacman -S --needed --noconfirm -- "${miss[@]}" || { err "pacman failed"; return 4; }
    fi
    local idx
    while IFS= read -r idx; do
        [[ -n "$idx" ]] && { fx_install_pkg "$idx" || return 4; }
    done < <(fx_packages | jq -r '.[] | select(.default and (.installed | not)) | .idx')
    history_add "shader install" gaming "vkBasalt + standard shaders" 0
    log "✔ Visual shaders ready: pick a preset for a game."
}

# SweetFX Settings DB: games matching a name → [{title, id}]
cmd_fx_search() {
    local q="$1" out
    [[ -n "$q" ]] || { err "use: fx search <game name>"; return 2; }
    out="$(curl -fsS --max-time 15 -A "$FX_UA" -G "$SFX_URL/games/game/search/" --data-urlencode "query=$q" 2>/dev/null)" \
        || { err "SweetFX Settings DB didn't answer"; return 4; }
    jq -c '[.Games[]? | {title, id:(.url | capture("/games/game/(?<i>[0-9]+)/").i)}]' <<<"$out"
}

# presets of a SweetFX DB game → [{id, name}] (newest first, as the site lists them)
cmd_fx_presets() {
    local g="$1" html
    [[ "$g" =~ ^[0-9]+$ ]] || { err "use: fx presets <sfx game id>"; return 2; }
    html="$(fx_cached "sfx-game-$g.html" 86400 "$SFX_URL/games/game/$g/")"
    [[ -n "$html" ]] || { err "couldn't load the game's presets"; return 4; }
    fx_sfx_rows <<<"$html" | jq -c 'unique_by(.id) | sort_by(-(.id | tonumber))'
}

# turn a ReShade preset (.ini text) into a vkBasalt config; missing effect files
# are fetched from the package that lists them. Can't be carried over:
# - effects that read the depth buffer (vkBasalt has none),
# - a technique that isn't the first one of its file (vkBasalt runs only that),
# - vector values whose components differ (vkBasalt sets every component of a
#   uniform to one value) — those keep the shader's default.
fx_convert() {   # preset.ini out.conf → report JSON on stdout
    local ini="$1" out="$2" techs name file path first pk skipped="[]" partial="[]" opts="" fxlist="" n=0
    local -a t=() used=()
    techs="$(tr -d '\r' < "$ini" | grep -m1 -E '^Techniques=' | cut -d= -f2-)"
    [[ -n "$techs" ]] || { err "not a ReShade preset (no Techniques= line); it only says: $(tr -d '\r' < "$ini" | head -c 120)"; return 4; }
    local pkgs; pkgs="$(fx_packages)"
    IFS=',' read -ra t <<<"$techs"
    for name in "${t[@]}"; do
        [[ "$name" == *@* ]] || continue
        file="${name#*@}"; name="${name%@*}"
        path="$(fx_find "$file")"
        if [[ -z "$path" ]]; then
            pk="$(jq -r --arg f "$file" '[.[] | select(.files | index($f)) | .idx] | first // empty' <<<"$pkgs")"
            [[ -n "$pk" ]] && fx_install_pkg "$pk" >&2 && pkgs="$(fx_packages)"
            path="$(fx_find "$file")"
        fi
        if [[ -z "$path" ]]; then
            skipped="$(jq -c --arg n "$name" --arg f "$file" '. + [{effect:$n, file:$f, why:"shader not found in any known package"}]' <<<"$skipped")"; continue
        fi
        if grep -qE 'ReShade::(GetLinearizedDepth|DepthBuffer)|GetLinearizedDepth\(|DepthBufferTex|SV_Depth' "$path"; then
            skipped="$(jq -c --arg n "$name" --arg f "$file" '. + [{effect:$n, file:$f, why:"uses the depth buffer, which vkBasalt can'\''t read"}]' <<<"$skipped")"; continue
        fi
        first="$(grep -oE '^[[:space:]]*technique[[:space:]]+[A-Za-z0-9_]+' "$path" | head -1 | awk '{ print $2 }')"
        if [[ -n "$first" && "$first" != "$name" ]]; then
            skipped="$(jq -c --arg n "$name" --arg f "$file" --arg x "$first" '. + [{effect:$n, file:$f, why:"vkBasalt only runs the first technique of \($f) (\($x))"}]' <<<"$skipped")"; continue
        fi
        n=$((n + 1)); fxlist+="${fxlist:+:}fx$n"; opts+="fx$n = \"$path\""$'\n'
        used+=("$file")
    done
    # values of the effects kept: [File.fx] sections, key=value
    local vals
    vals="$(tr -d '\r' < "$ini" | awk -v keep="$(printf '%s\n' "${used[@]}")" '
        BEGIN { n = split(keep, k, "\n"); for (i = 1; i <= n; i++) if (k[i] != "") want[k[i]] = 1 }
        /^\[/ { sec = substr($0, 2, length($0) - 2); next }
        sec != "" && (sec in want) && index($0, "=") { i = index($0, "="); print sec "\t" substr($0, 1, i - 1) "\t" substr($0, i + 1) }')"
    local sec k v seen="" first_v
    while IFS=$'\t' read -r sec k v; do
        [[ -n "$k" && "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        if [[ "$v" == *,* ]]; then
            first_v="${v%%,*}"
            if [[ -n "$(tr ',' '\n' <<<"$v" | grep -vxF -- "$first_v")" ]]; then
                partial="$(jq -c --arg f "$sec" --arg k "$k" '. + [{file:$f, value:$k}]' <<<"$partial")"; continue
            fi
            v="$first_v"
        fi
        [[ "$v" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || continue
        [[ "$seen" == *$'\n'"$k"$'\n'* ]] && continue      # one namespace for all effects: first wins
        seen+=$'\n'"$k"$'\n'
        opts+="$k = $v"$'\n'
    done <<<"$vals"
    if (( n == 0 )); then
        jq -nc --argjson s "$skipped" '{applied:0, effects:[], skipped:$s, partial:[]}'; return 5
    fi
    {
        echo "# written by Gaming Deck from a ReShade preset — edits are overwritten"
        echo "effects = $fxlist"
        echo "reshadeTexturePath = \"$FX_DIR/Textures\""
        echo "reshadeIncludePath = \"$FX_DIR/Shaders\""
        echo "depthCapture = off"
        echo "toggleKey = $(fx_key)"
        echo "enableOnLaunch = True"
        printf '%s' "$opts"
    } > "$out"
    jq -nc --argjson s "$skipped" --argjson p "$partial" --args '{applied:($ARGS.positional | length), effects:$ARGS.positional, skipped:$s, partial:$p}' "${used[@]}"
}

# built-in looks: vkBasalt's own effects, no downloads
fx_builtin() {   # name out.conf
    local body
    case "$1" in
        sharpen)    body=$'effects = cas\ncasSharpness = 0.5' ;;
        sharpen-aa) body=$'effects = smaa:cas\ncasSharpness = 0.4\nsmaaEdgeDetection = luma\nsmaaThreshold = 0.05\nsmaaMaxSearchSteps = 32\nsmaaMaxSearchStepsDiag = 16\nsmaaCornerRounding = 25' ;;
        fxaa)       body=$'effects = fxaa\nfxaaQualitySubpix = 0.75\nfxaaQualityEdgeThreshold = 0.125\nfxaaQualityEdgeThresholdMin = 0.0312' ;;
        clarity)    body=$'effects = dls\ndlsSharpness = 0.5\ndlsDenoise = 0.17' ;;
        test)       # black and white (SweetFX Monochrome, a ReShade shader): can't be missed
                    local mono; mono="$(fx_find Monochrome.fx)"
                    [[ -n "$mono" ]] || return 3
                    body="effects = monochrome"$'\n'"monochrome = \"$mono\""$'\n'"reshadeTexturePath = \"$FX_DIR/Textures\""$'\n'"reshadeIncludePath = \"$FX_DIR/Shaders\"" ;;
        *) return 2 ;;
    esac
    printf '# written by Gaming Deck (built-in look: %s)\n%s\ntoggleKey = %s\nenableOnLaunch = True\n' "$1" "$body" "$(fx_key)" > "$2"
}

# fx set <key> builtin:<name> | sfx:<preset id> | off — applied through the
# game's mode: vkBasalt (converted config) or ReShade (the preset as it is)
cmd_fx_set() {
    local key="$1" what="$2" d rep name mode
    valid_game_key "$key" && [[ "$key" != default ]] || { err "not a game key: $key"; return 2; }
    d="$(fx_key_dir "$key")"
    # another look: the effects switched off in the previous one don't apply
    [[ -n "${FX_TOGGLING:-}" ]] || rm -f "$d/preset.orig.ini" "$d/disabled.json"
    mode="$(profile_get "$key" | jq -r '.fxMode // "vkbasalt"')"
    case "$what" in
        off)
            [[ -n "$(reshade_state "$key")" ]] && cmd_reshade_off "$key" --keep-profile >/dev/null
            rm -f "$d/vkBasalt.conf" "$d/preset.ini" "$d/report.json"
            profile_write "$key" '{"fx":false}'
            log "✔ Visual shaders off for $(game_label "$key")."; return 0 ;;
        builtin:*)
            name="${what#builtin:}"; mkdir -p "$d"
            if [[ "$mode" == reshade ]]; then
                [[ -n "$(reshade_state "$key")" ]] || { cmd_reshade_on "$key" || return $?; }
                reshade_builtin "$name" "$d/ReShadePreset.ini.new" || { rm -f "$d/ReShadePreset.ini.new"; err "unknown built-in look: $name"; return 2; }
                rep="$(reshade_need_files "$d/ReShadePreset.ini.new")"; mv "$d/ReShadePreset.ini.new" "$d/ReShadePreset.ini"
                rep="$(jq -c --arg n "$name" '. + {source:"builtin", name:$n}' <<<"$rep")"
            else
                local brc=0; fx_builtin "$name" "$d/vkBasalt.conf.new" || brc=$?
                if (( brc )); then
                    rm -f "$d/vkBasalt.conf.new"
                    if (( brc == 3 )); then err "this look needs the shaders: FX → INSTALL"; return 3; fi
                    err "unknown built-in look: $name"; return 2
                fi
                mv "$d/vkBasalt.conf.new" "$d/vkBasalt.conf"
                rep="$(jq -nc --arg n "$name" '{source:"builtin", name:$n, applied:1, effects:[$n], skipped:[], partial:[]}')"
            fi
            rm -f "$d/preset.ini" ;;
        sfx:*|file:*)
            local id="" tmp r rc=0
            mkdir -p "$d"; tmp="$(mktemp)"
            if [[ "$what" == file:* ]]; then
                cp -- "${what#file:}" "$tmp" 2>/dev/null || { rm -f "$tmp"; err "can't read ${what#file:}"; return 4; }
            else
                id="${what#sfx:}"
                [[ "$id" =~ ^[0-9]+$ ]] || { rm -f "$tmp"; err "bad preset id"; return 2; }
                curl -fsSL --max-time 20 -A "$FX_UA" "$SFX_URL/games/preset/$id/download/" -o "$tmp" \
                    || { rm -f "$tmp"; err "couldn't download the preset"; return 4; }
            fi
            if ! tr -d '\r' < "$tmp" | grep -qE '^Techniques='; then
                err "not a ReShade preset (no Techniques= line); it only says: $(tr -d '\r' < "$tmp" | head -c 120)"; rm -f "$tmp"; return 4
            fi
            name="$(tr -d '\r' < "$tmp" | head -1 | sed -E 's/^-->[[:space:]]*//' | cut -c1-80)"
            [[ "$name" == Techniques=* || "$name" == \[* || "$name" == *=* ]] && name="preset $id"
            [[ -n "${FX_IMPORT_NAME:-}" ]] && name="$FX_IMPORT_NAME"
            if [[ "$mode" == reshade ]]; then
                [[ -n "$(reshade_state "$key")" ]] || { cmd_reshade_on "$key" || { rc=$?; rm -f "$tmp"; return $rc; }; }
                r="$(reshade_need_files "$tmp")"
                tr -d '\r' < "$tmp" | grep -vE '^-->' > "$d/ReShadePreset.ini"
            else
                [[ "$(find "$FX_DIR/Shaders" -name '*.fx' 2>/dev/null | head -1)" ]] || { rm -f "$tmp"; err "install the shaders first (fx install)"; return 3; }
                r="$(fx_convert "$tmp" "$d/vkBasalt.conf.new")" || rc=$?
                if (( rc != 0 )); then
                    rm -f "$tmp" "$d/vkBasalt.conf.new"
                    if [[ -n "$r" ]]; then
                        jq -r '.skipped[] | "  ✗ \(.effect): \(.why)"' <<<"$r"
                        err "nothing in this preset works with vkBasalt"
                    fi
                    return "$rc"
                fi
                mv "$d/vkBasalt.conf.new" "$d/vkBasalt.conf"
            fi
            mv "$tmp" "$d/preset.ini"
            if [[ -n "$id" ]]; then
                # the SweetFX game it's listed under, so FX opens that list again (names can repeat: a 2014 and a 2023 game)
                local sg="${FX_SFX_GAME:-}"; [[ "$sg" =~ ^[0-9]+$ ]] || sg=""
                [[ -z "$sg" && -s "$d/report.json" ]] && sg="$(jq -r --arg id "$id" 'if .id == $id then .sfxGame // "" else "" end' "$d/report.json" 2>/dev/null)"
                # the file often has no name in it: the one it's listed with on SweetFX DB
                if [[ -n "$sg" && ( -z "$name" || "$name" == "preset $id" ) ]]; then
                    local ln; ln="$(cmd_fx_presets "$sg" 2>/dev/null | jq -r --arg id "$id" '.[] | select(.id == $id) | .name' | head -1)"
                    [[ -n "$ln" ]] && name="$ln"
                fi
                rep="$(jq -c --arg n "${name:-preset $id}" --arg id "$id" --arg url "$SFX_URL/games/preset/$id/" --arg sg "$sg" \
                       '. + {source:"sfx", name:$n, id:$id, url:$url} + (if $sg != "" then {sfxGame:$sg} else {} end)' <<<"$r")"
            else
                # where it came from: set by IMPORT; kept when the same preset is applied again
                local prev="{}"; [[ -s "$d/report.json" ]] && prev="$(jq -c 'if .source == "file" then {archive, bundled, importedAt} else {} end' "$d/report.json" 2>/dev/null || echo '{}')"
                rep="$(jq -c --arg n "${name:-imported preset}" --arg a "${FX_IMPORT_ARCHIVE:-}" --arg b "${FX_IMPORT_BUNDLED:-0}" \
                       --argjson prev "$prev" --argjson now "$(date +%s)" \
                       '. + {source:"file", name:$n}
                        + (if $a != "" then {archive:$a, bundled:($b | tonumber), importedAt:$now} else ($prev | with_entries(select(.value != null))) end)' <<<"$r")"
            fi ;;
        *) err "use: fx set <key> builtin:<sharpen|sharpen-aa|fxaa|clarity> | sfx:<preset id> | off"; return 2 ;;
    esac
    rep="$(jq -c --arg m "$mode" '. + {mode:$m}' <<<"$rep")"
    printf '%s\n' "$rep" > "$d/report.json"
    profile_write "$key" '{"fx":true}'
    log "✔ $(jq -r '.name' <<<"$rep") → $(game_label "$key") via $mode ($(jq -r '.applied' <<<"$rep") effect(s))"
    [[ "$key" == steam:* || "$key" == umbral:* ]] && fx_ensure_wrapped "$key"
    jq -r '.skipped[]? | "  ✗ \(.effect): \(.why)"' <<<"$rep"
    [[ "$(jq '.partial | length' <<<"$rep")" != 0 ]] && log "  ~ $(jq '.partial | length' <<<"$rep") colour value(s) kept at the shader's default (vkBasalt can't set vectors)"
    history_add "visual shaders" gaming "$key $(jq -r '.name' <<<"$rep") ($mode)" 0
    return 0
}

# fx mode <key> reshade [exe] [api] | vkbasalt — switch route, keep the look
cmd_fx_mode() {
    local key="$1" mode="$2" d look=""
    [[ "$key" == steam:* || "$key" == umbral:* ]] || { err "only Steam and Umbral games"; return 2; }
    d="$(fx_key_dir "$key")"
    if [[ -s "$d/report.json" ]]; then
        look="$(jq -r --arg p "$d/preset.ini" 'if .source == "sfx" then "sfx:\(.id)" elif .source == "file" then "file:\($p)" else "builtin:\(.name)" end' "$d/report.json")"
        if [[ "$look" == file:* ]]; then cp -f "$d/preset.ini" "$d/preset.keep"; look="file:$d/preset.keep"
            export FX_IMPORT_NAME; FX_IMPORT_NAME="$(jq -r .name "$d/report.json")"; fi
    fi
    case "$mode" in
        reshade)
            cmd_reshade_on "$key" "${3:-}" "${4:-}" || return $?
            rm -f "$d/vkBasalt.conf" ;;
        vkbasalt)
            [[ -n "$(reshade_state "$key")" ]] && cmd_reshade_off "$key" --keep-profile >/dev/null
            profile_write "$key" '{"fxMode":"vkbasalt"}' ;;
        *) err "use: fx mode <key> reshade [exe] [dxgi|d3d9|opengl32] | vkbasalt"; return 2 ;;
    esac
    if [[ -n "$look" ]]; then cmd_fx_set "$key" "$look"; rm -f "$d/preset.keep"
    elif [[ "$mode" == vkbasalt ]]; then profile_write "$key" '{"fx":false}'; fi
    log "✔ $(game_label "$key") now uses $mode."
}

# --- ReShade (real, DLL) under Proton -------------------------------------------
# For D3D9–12 / OpenGL games: ReShade's own DLL next to the game's .exe, named
# after the API it hooks (dxgi.dll for D3D10–12, d3d9.dll, opengl32.dll), loaded
# through WINEDLLOVERRIDES=<dll>=n,b; it then chains to Proton's DXVK/VKD3D.
# Unlike vkBasalt it runs presets as they are (depth effects included) and has
# its in-game menu (HOME). Files come from their official sources:
#  - ReShade_Setup_<v>.exe from reshade.me (a zip: ReShade64/32.dll inside),
#  - d3dcompiler_47.dll, which ReShade needs to compile shaders on D3D9–11, from
#    Mozilla's Firefox 62.0.3 installer, checked by SHA-256 (same as winetricks).
# Nothing is copied into the game folder: symlinks to ~/.local/share, removed
# on OFF; ReShade.ini is written only when the game had none.
RESHADE_URL="${GAMING_DECK_RESHADE_URL:-https://reshade.me}"
FF_D3DC_URL="${GAMING_DECK_FF_D3DC_URL:-https://download-installer.cdn.mozilla.net/pub/firefox/releases/62.0.3}"
declare -A FF_D3DC_SHA=(
    [64]=721977f36c008af2b637aedd3f1b529f3cfed6feb10f68ebe17469acb1934986
    [32]=d6edb4ff0a713f417ebd19baedfe07527c6e45e84a6c73ed8c66a33377cc0aca
)
[[ -n "${GAMING_DECK_FF_D3DC_SHA64:-}" ]] && FF_D3DC_SHA[64]="$GAMING_DECK_FF_D3DC_SHA64"
[[ -n "${GAMING_DECK_FF_D3DC_SHA32:-}" ]] && FF_D3DC_SHA[32]="$GAMING_DECK_FF_D3DC_SHA32"
RESHADE_BIN="$FX_DIR/bin"

reshade_latest() {
    fx_cached reshade-home.html 86400 "$RESHADE_URL/" \
        | grep -oE '/downloads/ReShade_Setup_[0-9][0-9.]*[0-9]\.exe' | head -1 \
        | sed -E 's|.*ReShade_Setup_([0-9.]+)\.exe|\1|'
}
reshade_version() { [[ -L "$RESHADE_BIN/current" ]] && basename "$(readlink "$RESHADE_BIN/current")"; }

# fx reshade install — ReShade (latest from reshade.me) + d3dcompiler_47 (32/64)
cmd_reshade_install() {
    local v tmp a
    v="$(reshade_latest)"; [[ -n "$v" ]] || { err "couldn't read the current ReShade version from $RESHADE_URL"; return 4; }
    mkdir -p "$RESHADE_BIN"
    if [[ ! -f "$RESHADE_BIN/ReShade-$v/ReShade64.dll" ]]; then
        log "→ ReShade $v  ($RESHADE_URL/downloads/ReShade_Setup_$v.exe)"
        tmp="$(mktemp -d)"
        curl -fsSL --max-time 120 -A "$FX_UA" "$RESHADE_URL/downloads/ReShade_Setup_$v.exe" -o "$tmp/setup.exe" \
            || { rm -rf "$tmp"; err "download failed"; return 4; }
        [[ "$(head -c 2 "$tmp/setup.exe")" == MZ ]] || { rm -rf "$tmp"; err "that isn't the ReShade installer"; return 4; }
        mkdir -p "$tmp/x"
        bsdtar -xf "$tmp/setup.exe" -C "$tmp/x" ReShade64.dll ReShade32.dll 2>/dev/null
        [[ -f "$tmp/x/ReShade64.dll" && -f "$tmp/x/ReShade32.dll" ]] || { rm -rf "$tmp"; err "ReShade64/32.dll not found in the installer"; return 4; }
        mkdir -p "$RESHADE_BIN/ReShade-$v"; mv "$tmp/x/ReShade64.dll" "$tmp/x/ReShade32.dll" "$RESHADE_BIN/ReShade-$v/"
        rm -rf "$tmp"
    fi
    ln -sfn "ReShade-$v" "$RESHADE_BIN/current"
    for a in 64 32; do
        [[ -f "$RESHADE_BIN/d3dcompiler_47.dll.$a" ]] && continue
        log "→ d3dcompiler_47.dll ($a-bit) from Mozilla's Firefox 62.0.3 installer"
        tmp="$(mktemp -d)"
        curl -fsSL --max-time 300 -A "$FX_UA" "$FF_D3DC_URL/win$a/ach/Firefox%20Setup%2062.0.3.exe" -o "$tmp/ff.exe" \
            || { rm -rf "$tmp"; err "download failed"; return 4; }
        [[ "$(sha256sum "$tmp/ff.exe" | cut -d' ' -f1)" == "${FF_D3DC_SHA[$a]}" ]] \
            || { rm -rf "$tmp"; err "Firefox installer checksum mismatch: not using it"; return 4; }
        bsdtar -xf "$tmp/ff.exe" -C "$tmp" core/d3dcompiler_47.dll 2>/dev/null \
            && mv "$tmp/core/d3dcompiler_47.dll" "$RESHADE_BIN/d3dcompiler_47.dll.$a" \
            || { rm -rf "$tmp"; err "d3dcompiler_47.dll not found in the installer"; return 4; }
        rm -rf "$tmp"
    done
    # the standard shaders too (same folders vkBasalt uses)
    local idx
    while IFS= read -r idx; do
        [[ -n "$idx" ]] && { fx_install_pkg "$idx" || return 4; }
    done < <(fx_packages | jq -r '.[] | select(.default and (.installed | not)) | .idx')
    history_add "reshade install" gaming "ReShade $v" 0
    log "✔ ReShade $v ready."
}

# PE header → {"arch":64|32, "imports":[…]} per file (Python; arch only without it)
pe_info() {
    if have python3; then
        python3 - "$@" <<'PY'
import json, mmap, struct, sys
def info(p):
    # mmap: only the pages of the headers and the import table get read
    with open(p, 'rb') as f:
        d = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
    if d[:2] != b'MZ': return None
    pe = struct.unpack_from('<I', d, 0x3C)[0]
    if d[pe:pe + 4] != b'PE\0\0': return None
    machine, nsec = struct.unpack_from('<HH', d, pe + 4)
    optsz = struct.unpack_from('<H', d, pe + 20)[0]
    opt = pe + 24
    ddir = opt + (112 if struct.unpack_from('<H', d, opt)[0] == 0x20b else 96)
    imp = struct.unpack_from('<I', d, ddir + 8)[0]
    secs = [struct.unpack_from('<IIII', d, pe + 24 + optsz + i * 40 + 8) for i in range(nsec)]
    def off(rva):
        for vsz, va, rsz, rp in secs:
            if va <= rva < va + max(vsz, rsz): return rva - va + rp
    names, o = [], (off(imp) if imp else None)
    while o is not None and o + 20 <= len(d):
        n = struct.unpack_from('<I', d, o + 12)[0]
        no = off(n) if n else None
        if no is None: break
        names.append(d[no:d.find(b'\0', no)].decode('ascii', 'replace').lower()); o += 20
    return {'arch': {0x8664: 64, 0x14c: 32}.get(machine, 0), 'imports': names}
out = {}
for p in sys.argv[1:]:
    try: out[p] = info(p)
    except Exception: out[p] = None
print(json.dumps(out))
PY
    else
        local f m o
        for f in "$@"; do
            o="$(od -An -tu4 -j60 -N4 "$f" | tr -d ' ')"
            m="$(od -An -tx2 -j$((o + 4)) -N2 "$f" | tr -d ' ')"
            jq -nc --arg f "$f" --arg m "$m" '{($f): {arch:(if $m == "8664" then 64 elif $m == "014c" then 32 else 0 end), imports:[]}}'
        done | jq -sc 'add // {}'
    fi
}

steam_game_dir() {   # appid → install folder
    steam_games | awk -v i="$1" 'NR % 5 == 1 { id = $0 } NR % 5 == 3 { d = $0 } NR % 5 == 0 && id == i { print $0 "/steamapps/common/" d; exit }'
}

# iosched <key> — the disk a game lives on and its I/O scheduler. IO PRIORITY
# (ionice best-effort level 0) only changes anything under BFQ: mq-deadline and
# kyber honour the class but not the level, none ignores priorities.
cmd_iosched() {
    local key="$1" dir dev disk s
    valid_game_key "$key" || { err "not a game key: $key"; return 2; }
    case "$key" in
        steam:*)  dir="$(steam_game_dir "${key#steam:}")" ;;
        umbral:*) dir="$(umbral_game_exe "$key")"; dir="${dir%/*}"
                  [[ -d "$dir" ]] || dir="$(umbral_json | jq -r --arg i "${key#umbral:}" '(.games[]? | select(.id == $i) | .prefix_id) as $p | .prefixes[]? | select(.id == $p) | .path' | head -1)" ;;
    esac
    [[ -d "$dir" ]] || { jq -nc '{disk:null, scheduler:null, levels:null}'; return 0; }
    dev="$(df --output=source "$dir" 2>/dev/null | tail -1)"
    disk="$(lsblk -sno NAME,TYPE "$dev" 2>/dev/null | awk '$2 == "disk" { gsub(/^[^[:alnum:]]+/, "", $1); print $1; exit }')"
    s="$(sed -n 's/.*\[\(.*\)\].*/\1/p' "$SYSFS/block/$disk/queue/scheduler" 2>/dev/null)"
    jq -nc --arg d "$disk" --arg s "$s" '{disk:($d | select(. != "")), scheduler:($s | select(. != "")), levels:(if $s == "" then null else $s == "bfq" end)}'
}

# fx exes <key> → the game's .exe candidates, best first, with arch and the API
# ReShade should hook (from the imports of the .exe and of the DLLs beside it)
# an Umbral game's .exe (from Umbral's config)
umbral_game_exe() { umbral_json | jq -r --arg i "${1#umbral:}" '.games[]? | select(.id == $i) | .exe // empty'; }
umbral_game_name() { umbral_json | jq -r --arg i "${1#umbral:}" '.games[]? | select(.id == $i) | .name // empty'; }
# a game key as people read it: its name (the key itself if the game is unknown)
game_label() {
    local n=""
    case "$1" in
        steam:*)  n="$(steam_games | awk -v i="${1#steam:}" 'NR % 5 == 1 { x = $0 } NR % 5 == 2 && x == i { print; exit }')" ;;
        umbral:*) n="$(umbral_game_name "$1")" ;;
    esac
    echo "${n:-$1}"
}

cmd_fx_exes() {
    local key="$1" dir main="" gname=""
    case "$key" in
        steam:*)
            dir="$(steam_game_dir "${key#steam:}")"
            gname="$(steam_games | awk -v i="${key#steam:}" 'NR % 5 == 1 { id = $0 } NR % 5 == 2 && id == i { print; exit }')" ;;
        umbral:*)
            main="$(umbral_game_exe "$key")"; [[ -f "$main" ]] || { err "this Umbral game has no .exe set"; return 4; }
            dir="$(dirname "$main")"; gname="$(umbral_game_name "$key")" ;;
        *) err "only Steam and Umbral games"; return 2 ;;
    esac
    [[ -d "$dir" ]] || { err "game folder not found"; return 4; }
    local exes=() f
    while IFS= read -r f; do exes+=("$f"); done < <(find "$dir" -maxdepth 5 -type f -iname '*.exe' -size +100k 2>/dev/null \
        | grep -viE '/(unins[^/]*|[^/]*crash[^/]*|[^/]*redist[^/]*|dxsetup|vc_?redist[^/]*|[^/]*setup[^/]*|[^/]*report[^/]*|[^/]*helper[^/]*|UnityCrashHandler[^/]*)\.exe$|/(_CommonRedist|Redist|redist|DirectX|Support)/')
    # the .exe Umbral launches counts even when it's tiny (RPG Maker's Game.exe)
    [[ -n "$main" ]] && ! printf '%s\n' "${exes[@]}" | grep -qxF -- "$main" && exes+=("$main")
    ((${#exes[@]})) || { echo '[]'; return 0; }
    local rgss=false; compgen -G "$dir/RGSS*.dll" >/dev/null && rgss=true
    local dlls=() d
    while IFS= read -r d; do
        for f in "$d"/*.dll; do [[ -f "$f" ]] && dlls+=("$f"); done
    done < <(for f in "${exes[@]}"; do dirname "$f"; done | sort -u)
    pe_info "${exes[@]}" "${dlls[@]}" | jq -c --arg root "$dir" --arg game "$gname" --arg main "$main" --argjson rgss "$rgss" --argjson exes "$(printf '%s\n' "${exes[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))')" \
        --argjson sizes "$(for f in "${exes[@]}"; do stat -c %s "$f"; done | jq -sc .)" '
        . as $pe
        | def dirof: sub("/[^/]*$"; "");
          def norm: ascii_downcase | gsub("[^a-z0-9]"; "");
          (($root | sub(".*/"; "")) | norm) as $idir | ($game | norm) as $gname |
          [range(0; $exes | length) as $i | $exes[$i] as $e
           | ([$pe | to_entries[] | select((.key | dirof) == ($e | dirof)) | .value.imports[]?] | unique) as $imp
           | {path:$e, rel:($e | ltrimstr($root + "/")), size:$sizes[$i], arch:($pe[$e].arch // 0),
              api:(if ($imp | map(select(test("^(d3d1[0-2]|d3d10_1|d3d10core|dxgi)\\.dll$"))) | length) > 0 then "dxgi"
                   elif ($imp | index("d3d9.dll")) then "d3d9"
                   elif ($imp | index("opengl32.dll")) then "opengl32"
                   elif ($imp | index("vulkan-1.dll")) then "vulkan"
                   elif $rgss then "gdi"
                   else "unknown" end)}
           | .score = (.size / 1048576
                       + (if (.rel | test("-Shipping\\.exe$"; "i")) then 1000 else 0 end)
                       + (if .api != "unknown" then 200 else 0 end)
                       - (if (.rel | test("launcher"; "i")) then 500 else 0 end)
                       - (if (.rel | test("console|editor|server|bench|config|settings|tool"; "i")) then 400 else 0 end)
                       + (if .path == $main then 5000 else 0 end)
                       + ((.rel | sub(".*/"; "") | sub("(-win64)?(-shipping)?\\.exe$"; ""; "i") | norm) as $stem
                          | if $stem != "" and (($idir | contains($stem)) or ($gname | contains($stem)) or ($stem | contains($idir))) then 300 else 0 end))]
        | sort_by(-.score)'
}

winpath() { local p="$1"; printf 'Z:%s' "${p//\//\\}"; }

# set/replace one key of an ini section in place (ReShade.ini)
ini_set() {   # file section key value
    local tmp; tmp="$(mktemp)"
    # the value goes through the environment: awk -v would eat its backslashes
    INI_S="[$2]" INI_K="$3" INI_V="$4" awk '
        BEGIN { S = ENVIRON["INI_S"]; K = ENVIRON["INI_K"]; V = ENVIRON["INI_V"]; done = 0 }
        { sub(/\r$/, "") }
        $0 == S { insec = 1; print; next }
        /^\[/ { if (insec && !done) { print K "=" V; done = 1 } insec = 0 }
        insec && index($0, K "=") == 1 { if (!done) print K "=" V; done = 1; next }
        { print }
        END { if (!done) { if (!insec) print S; print K "=" V } }' "$1" > "$tmp" && cat "$tmp" > "$1"; rm -f "$tmp"
}

# does the game launch through the wrapper? (Steam launch options)
game_wrapped() {
    local lc; lc="$(steam_localconfig)"
    [[ -f "$lc" ]] && [[ "$(vdf_get "$lc" "$LOCALCONFIG_APPS/$1" LaunchOptions)" == *"gaming-deck run"* ]]
}
# FX only works through the wrapper: wrap the game now if Steam allows it
fx_ensure_wrapped() {
    if [[ "$1" == umbral:* ]]; then
        umbral_has_hook || log "⚠ Umbral $UMBRAL_HOOK_VERSION or newer is needed for shaders/TEMPS on its games (update Umbral)."
        return 0
    fi
    local id="${1#steam:}"
    game_wrapped "$id" && return 0
    if steam_running; then
        log "⚠ The game doesn't launch through Gaming Deck yet: close Steam and press USE IN STEAM (LIBRARY)."
    else
        cmd_steamwrap "$id" on >/dev/null && log "→ USE IN STEAM turned on (the game now launches through Gaming Deck)"
    fi
}

# Umbral calls `gaming-deck hook umbral:<id>` before launching (Umbral ≥ 0.10.0):
# the environment the deck's features need and whether to show TEMPS
UMBRAL_HOOK_VERSION="0.10.0"
umbral_has_hook() {
    local v; v="$(pkg_ver umbral)"; v="${v%-*}"
    [[ -n "$v" ]] && [[ "$(vercmp "$v" "$UMBRAL_HOOK_VERSION" 2>/dev/null)" -ge 0 ]]
}
cmd_hook() {
    local key="$1" p env='{}' st api fxc
    valid_game_key "$key" || { err "not a game key: $key"; return 2; }
    p="$(profile_get "$key")"
    if [[ "$(jq -r '.fx' <<<"$p")" == true ]]; then
        if [[ "$(jq -r '.fxMode // "vkbasalt"' <<<"$p")" == reshade ]]; then
            st="$(reshade_state "$key")"
            if [[ -n "$st" ]]; then api="$(jq -r .api <<<"$st")"
                env="$(jq -nc --arg o "d3dcompiler_47=n;$api=n,b" '{WINEDLLOVERRIDES:$o}')"; fi
        else
            fxc="$(fx_key_dir "$key")/vkBasalt.conf"
            [[ -s "$fxc" ]] && { mkdir -p "$STATE_DIR/logs"; env="$(jq -nc --arg c "$fxc" --arg l "$STATE_DIR/logs/vkbasalt-${key//[:\/]/_}.log" '{ENABLE_VKBASALT:"1", VKBASALT_CONFIG_FILE:$c, VKBASALT_LOG_LEVEL:"info", VKBASALT_LOG_FILE:$l}')"; }
        fi
    fi
    jq -nc --argjson env "$env" --argjson overlay "$(jq '.overlay == true' <<<"$p")" \
        --argjson session "$({ [[ "$(jq -r .overlay <<<"$p")" == true ]] || [[ -n "$(sched_setting whilePlaying)" ]] || session_summary_on || playing_on quiet || playing_on lite; } && echo true || echo false)" \
        '{env:$env, overlay:$overlay, session:$session}'
}

# ReShade's screenshots (PrtSc) go to ~/Pictures/ReShade/<game>, not the game folder
reshade_shots_dir() {   # key → folder
    local name pics
    case "$1" in
        steam:*)  name="$(steam_games | awk -v i="${1#steam:}" 'NR % 5 == 1 { x = $0 } NR % 5 == 2 && x == i { print; exit }')" ;;
        umbral:*) name="$(umbral_game_name "$1")" ;;
    esac
    name="${name:-${1//:/_}}"; name="${name//\//-}"; name="${name//[:*?\"<>|]/}"
    pics="${GAMING_DECK_PICTURES:-$(xdg-user-dir PICTURES 2>/dev/null)}"; [[ -d "$pics" ]] || pics="$HOME/Pictures"
    echo "$pics/ReShade/$name"
}
reshade_set_shots() {   # key ini
    local d; d="$(reshade_shots_dir "$1")"
    mkdir -p "$d" && ini_set "$2" SCREENSHOT SavePath "$(winpath "$d")"
}

reshade_state() { local f; f="$(fx_key_dir "$1")/reshade.json"; [[ -s "$f" ]] && cat "$f"; }

# fx reshade on <key> [exe path] [dxgi|d3d9|opengl32]
cmd_reshade_on() {
    local key="$1" exe="${2:-}" api="${3:-}" cand dir arch d target ini ours="$RESHADE_BIN"
    [[ "$key" == steam:* || "$key" == umbral:* ]] || { err "only Steam and Umbral games"; return 2; }
    [[ -n "$(reshade_version)" && -f "$RESHADE_BIN/d3dcompiler_47.dll.64" ]] || { cmd_reshade_install || return 4; }
    cand="$(cmd_fx_exes "$key")" || return 4
    [[ -n "$exe" ]] || exe="$(jq -r '.[0].path // empty' <<<"$cand")"
    [[ -n "$exe" ]] || { err "no game .exe found"; return 4; }
    jq -e --arg e "$exe" 'any(.[]; .path == $e)' <<<"$cand" >/dev/null || { err "not one of this game's executables: $exe"; return 2; }
    arch="$(jq -r --arg e "$exe" '.[] | select(.path == $e) | .arch' <<<"$cand")"
    [[ -n "$api" ]] || api="$(jq -r --arg e "$exe" '.[] | select(.path == $e) | .api' <<<"$cand")"
    case "$api" in
        dxgi|d3d9|opengl32) ;;
        vulkan) err "this game renders with Vulkan: ReShade's DLL can't hook it — use vkBasalt"; return 3 ;;
        gdi)    err "this is a 2D game drawn with GDI (RPG Maker): no shader tool can hook it"; return 3 ;;
        *) err "couldn't tell which graphics API the game uses: pick DXGI (DirectX 10–12), D3D9 or OPENGL"; return 3 ;;
    esac
    [[ "$arch" == 32 || "$arch" == 64 ]] || { err "unknown .exe architecture"; return 4; }
    dir="$(dirname "$exe")"
    # an earlier ReShade in another folder/API of this game goes first
    [[ -n "$(reshade_state "$key")" ]] && cmd_reshade_off "$key" --keep-profile >/dev/null
    target="$dir/$api.dll"
    if [[ -e "$target" || -L "$target" ]] && [[ "$(readlink "$target" 2>/dev/null)" != "$ours"/* ]]; then
        err "the game already has its own $api.dll: not replacing it"; return 3
    fi
    ln -sfn "$ours/current/ReShade$arch.dll" "$target"
    local d3dc=false
    if [[ ! -e "$dir/d3dcompiler_47.dll" || "$(readlink "$dir/d3dcompiler_47.dll" 2>/dev/null)" == "$ours"/* ]]; then
        ln -sfn "$ours/d3dcompiler_47.dll.$arch" "$dir/d3dcompiler_47.dll"; d3dc=true
    fi
    d="$(fx_key_dir "$key")"; mkdir -p "$d"
    [[ -f "$d/ReShadePreset.ini" ]] || printf 'Techniques=\nTechniqueSorting=\n' > "$d/ReShadePreset.ini"
    ini="$dir/ReShade.ini"; local created=false
    if [[ ! -f "$ini" ]]; then
        created=true
        printf '[GENERAL]\n[INPUT]\n[OVERLAY]\nTutorialProgress=4\n' > "$ini"
    fi
    ini_set "$ini" INPUT KeyOverlay "$(fx_vk "$(fx_key)"),0,0,0"
    ini_set "$ini" INPUT KeyEffects "$(fx_vk "$(fx_effects_key)"),0,0,0"
    ini_set "$ini" INPUT KeyScreenshot "$(fx_vk "$(fx_shot_key)"),0,0,0"
    ini_set "$ini" GENERAL EffectSearchPaths "$(winpath "$FX_DIR/Shaders")\\**"
    ini_set "$ini" GENERAL TextureSearchPaths "$(winpath "$FX_DIR/Textures")\\**"
    ini_set "$ini" GENERAL PresetPath "$(winpath "$d/ReShadePreset.ini")"
    ini_set "$ini" GENERAL IntermediateCachePath 'C:\users\steamuser\Temp'
    reshade_set_shots "$key" "$ini"
    jq -nc --arg exe "$exe" --arg dir "$dir" --arg api "$api" --argjson arch "$arch" --argjson d3dc "$d3dc" \
        --argjson created "$created" --arg v "$(reshade_version)" \
        --arg key "$key" '{key:$key, exe:$exe, dir:$dir, api:$api, arch:$arch, d3dcompiler:$d3dc, iniCreated:$created, version:$v}' > "$d/reshade.json"
    profile_write "$key" '{"fx":true,"fxMode":"reshade"}'
    history_add "reshade on" gaming "$key $api" 0
    log "✔ ReShade on: ${exe#"$(dirname "$dir")"/} ($arch-bit, $api.dll). In game, $(fx_key) opens its menu."
}

# fx reshade off <key> — remove only what we put there
cmd_reshade_off() {
    local key="$1" st dir api d f
    st="$(reshade_state "$key")"; d="$(fx_key_dir "$key")"
    if [[ -n "$st" ]]; then
        dir="$(jq -r .dir <<<"$st")"; api="$(jq -r .api <<<"$st")"
        for f in "$dir/$api.dll" "$dir/d3dcompiler_47.dll"; do
            [[ -L "$f" && "$(readlink "$f")" == "$RESHADE_BIN"/* ]] && rm -f "$f"
        done
        if [[ "$(jq -r .iniCreated <<<"$st")" == true ]]; then rm -f "$dir/ReShade.ini" "$dir/ReShade.log" "$dir"/ReShade.log.*; fi
        rm -f "$d/reshade.json"
    fi
    [[ "${2:-}" == --keep-profile ]] || profile_write "$key" '{"fx":false,"fxMode":"vkbasalt"}'
    log "✔ ReShade removed from the game folder."
}

# a preset's effect files, fetching the official package of each missing one
reshade_need_files() {   # preset.ini → report JSON {applied, effects, skipped}
    local techs name file pk pkgs used=() skipped="[]"
    techs="$(tr -d '\r' < "$1" | grep -m1 -E '^Techniques=' | cut -d= -f2-)"
    pkgs="$(fx_packages)"
    local -a t=(); IFS=',' read -ra t <<<"$techs"
    for name in "${t[@]}"; do
        [[ "$name" == *@* ]] || continue
        file="${name#*@}"; name="${name%@*}"
        if [[ -z "$(fx_find "$file")" ]]; then
            pk="$(jq -r --arg f "$file" '[.[] | select(.files | index($f)) | .idx] | first // empty' <<<"$pkgs")"
            [[ -n "$pk" ]] && fx_install_pkg "$pk" >&2 && pkgs="$(fx_packages)"
        fi
        if [[ -n "$(fx_find "$file")" ]]; then used+=("$file")
        else skipped="$(jq -c --arg n "$name" --arg f "$file" '. + [{effect:$n, file:$f, why:"shader not found in any known package"}]' <<<"$skipped")"; fi
    done
    jq -nc --argjson s "$skipped" --args '{applied:($ARGS.positional | unique | length), effects:($ARGS.positional | unique), skipped:$s, partial:[]}' "${used[@]}"
}

# built-in looks as ReShade presets (SweetFX effects from the standard packages)
reshade_builtin() {   # name out.ini
    local t
    case "$1" in
        sharpen)    t="ContrastAdaptiveSharpen@CAS.fx" ;;
        sharpen-aa) t="SMAA@SMAA.fx,ContrastAdaptiveSharpen@CAS.fx" ;;
        fxaa)       t="FXAA@FXAA.fx" ;;
        clarity)    t="LumaSharpen@LumaSharpen.fx,Vibrance@Vibrance.fx" ;;
        test)       t="Monochrome@Monochrome.fx" ;;     # black and white: the effects are obviously on
        *) return 2 ;;
    esac
    printf 'Techniques=%s\nTechniqueSorting=%s\n' "$t" "$t" > "$2"
}

# --- preset review: what a preset does, and what tends to make it look worse -----
# An effect's kind, from its file name (order matters: the first match wins).
FX_KIND_JQ='def kind: ascii_downcase as $f
  | if   ($f | test("lilium|convertcolorspace|monitorgamma|autohdr|sdr_trc|inverse_tone|hdr_converter|hdr_black")) then "gamma"
    elif ($f | test("^(smaa|fxaa|cmaa|nfaa|daa|dlaa|temporal_aa|pirate_fxaa|cfxaa|cdlaa)|martysmods_smaa")) then "aa"
    elif ($f | test("mxao|ssao|ssdo|dof|nglighting|radiantgi|rtgi|_gi\\.|zn_gi|ssr|ssrt|fog|depth|gloomao|neogi|pirate_depth")) then "depth"
    elif ($f | test("grain|chromatic|^ca\\.|flexibleca|vignette|noise|letterbox|lens|anamorph|scanline|crt|vhs|halftone|prism")) then "film"
    elif ($f | test("bloom|glow|godrays|flare|halation|magichdr|fakehdr|hdrbloom")) then "bloom"
    elif ($f | test("clarity|localcontrast|_lc\\.|quark_local")) then "detail"
    elif ($f | test("sharp|^cas\\.|rcas|unsharp|deblur|finesharp|filmicanamorph")) then "sharpen"
    elif ($f | test("colou?r|technicolor|levels|curves|vibrance|lut|tonemap|lightroom|grading|satur|matrix|tint|sepia|pd80_0[34]|lift|dpx|cross|emphasize|pcolors|hsl|hue|balance|contrast|exposure|gamma|dehaze|filmic")) then "color"
    else "other" end;'

# fx review <preset.ini> → {effects:[{technique,file,kind}], count:{kind:n}, flags:[{t,tone,why,off:[files]}], verdict, suggestOff:[files]}
fx_review() {
    local techs
    techs="$(tr -d '\r' < "$1" | grep -m1 -E '^Techniques=' | cut -d= -f2-)"
    jq -nc --arg techs "$techs" --arg ini "$(tr -d '\r' < "$1")" "$FX_KIND_JQ"'
      ($ini | split("\n")) as $l
      # a numeric setting of an effect: [<file>] … key=value
      | def setting($file; $key): ([range(0; $l | length) as $i | select($l[$i] == "[" + $file + "]") | $i] | first) as $s
            | if $s == null then null else
              ([$l[$s + 1:][] ] | (to_entries | map(select(.value | startswith("["))) | first | .key // length) as $e
               | .[0:$e] | map(select(startswith($key + "="))) | first // null
               | if . == null then null else (split("=")[1] | split(",")[0] | tonumber? ) end) end;
      [$techs | split(",")[] | select(contains("@")) | split("@") | {technique:.[0], file:.[1], kind:(.[1] | kind)}] as $e
      | ($e | group_by(.kind) | map({key:.[0].kind, value:length}) | from_entries) as $c
      | ([$e[] | select(.kind == "sharpen")]) as $sh
      # the one to keep: CAS (contrast-adaptive, the cleanest) when there is one
      | (([$sh[] | select(.file | test("^(CAS|RCAS)\\.fx$"; "i"))] | first) // $sh[0]) as $keep
      | ($c.detail // 0) as $det
      | (setting("CAS.fx"; "Sharpening") // 0) as $cas
      | [ (if ($sh | length) >= 2 then {t:"\($sh | length) SHARPENERS", tone:"bad",
              why:"\($sh | length) sharpening effects stacked (\($sh | map(.technique) | join(", "))): halos and grain. One is enough.",
              off:[$sh[] | select(.file != $keep.file) | .file]} else empty end),
          (if ($sh | length) + $det >= 3 then {t:"OVER-SHARP", tone:"warn",
              why:"\($sh | length) sharpener(s) + \($det) local-contrast effect(s) (Clarity…): too much detail enhancement, the image gets harsh.", off:[]} else empty end),
          (if ($sh | length) >= 1 and $cas >= 0.9 then {t:"SHARP 100 %", tone:"warn",
              why:"CAS at full strength: set the game'"'"'s own sharpening to 0 so it isn'"'"'t sharpened twice.", off:[]} else empty end),
          (if ($c.gamma // 0) > 0 then {t:"GAMMA", tone:"bad",
              why:"Gamma / colour-space tools (\([$e[] | select(.kind == "gamma") | .technique] | join(", "))) are made for one monitor or HDR setup: on another they wash out or darken the picture.",
              off:[$e[] | select(.kind == "gamma") | .file]} else empty end),
          (if ($c.color // 0) >= 4 then {t:"STRONG COLOUR", tone:"warn",
              why:"\($c.color) colour effects: a strong style of its own, not a fix — very different from the game'"'"'s look.", off:[]} else empty end),
          (if ($c.film // 0) > 0 then {t:"FILM FX", tone:"info",
              why:"Grain / chromatic aberration / vignette (\([$e[] | select(.kind == "film") | .technique] | join(", "))): a taste, many find them worse.",
              off:[$e[] | select(.kind == "film") | .file]} else empty end),
          (if ($c.depth // 0) > 0 then {t:"NEEDS DEPTH", tone:"info",
              why:"\([$e[] | select(.kind == "depth") | .technique] | join(", ")) read the depth buffer: if you see halos or shading on the UI, turn them off.", off:[]} else empty end),
          (if ($e | length) >= 10 then {t:"\($e | length) EFFECTS", tone:"info", why:"Many effects: more GPU cost and more ways to look off.", off:[]} else empty end) ] as $fl
      | {effects:$e, count:$c, flags:$fl,
         suggestOff:([$fl[].off[]] | unique),
         verdict:(if ($e | length) == 0 then "empty"
                  elif any($fl[]; .tone == "bad") or ($e | length) >= 10 then "strong"
                  elif any($fl[]; .tone == "warn") or ($e | length) >= 6 then "moderate" else "light" end)}'
}

# --- library scan: best preset + known ReShade settings for every game ----------
# Sources: SweetFX Settings DB (presets, with download counts) and the ReShade
# compatibility list that reshade.me points to — PCGamingWiki's "ReShade" page
# (MediaWiki API; CC BY-NC-SA): render API, status and notes per game, plus
# "Online games to avoid" (bans/blocks). Notes about the depth buffer are turned
# into ReShade's own preprocessor definitions (see ReShade.fxh).
PCGW_API="${GAMING_DECK_PCGW_API:-https://www.pcgamingwiki.com/w/api.php}"

fx_norm() { tr '[:upper:]' '[:lower:]' <<<"$1" | sed -E 's/[™®©]//g; s/[^a-z0-9]+//g'; }

# PCGW sections → JSON [{names:[…], api, status, notes, avoid}]
fx_pcgw() {
    local sec out
    for sec in 15 16; do
        fx_cached "pcgw-$sec.json" 604800 "$PCGW_API?action=parse&page=ReShade&prop=wikitext&section=$sec&format=json" \
            | jq -r '.parse.wikitext["*"] // empty' 2>/dev/null \
            | awk -v avoid="$([[ $sec == 15 ]] && echo 1 || echo 0)" '/^\| *\[\[/ { print avoid "\t" $0 }'
    done | jq -Rsc '
        def clean: gsub("\\{\\{Code\\|(?<c>[^}]*)\\}\\}"; "\(.c)") | gsub("\\{\\{[^}]*\\}\\}"; "")
                   | gsub("\\[\\[(?:[^]|]*\\|)?(?<t>[^]]*)\\]\\]"; "\(.t)") | gsub("<[^>]*>"; " ")
                   | gsub("\\[https?://[^ \\]]+ ?(?<t>[^]]*)\\]"; "\(.t)")
                   | gsub("\u0027\u0027+"; "") | gsub("\\s+"; " ") | ltrimstr(" ") | rtrimstr(" ");
        [split("\n")[] | select(. != "") | split("\t") | .[0] as $av | .[1] | ltrimstr("|") | split("||")
         | select(length >= 3)
         | {names:([.[0] | scan("\\[\\[([^]|]+)") | .[0] | ltrimstr(" ") | rtrimstr(" ")]),
            api:(.[1] | clean), status:(.[2] | clean), notes:((.[3] // "") | clean), avoid:($av == "1")}]'
}

# depth notes → ReShade definitions
fx_depth_defines() {
    local n; n="$(tr '[:upper:]' '[:lower:]' <<<"$1")"
    [[ "$n" == *depth* ]] || return 0
    [[ "$n" =~ revers ]] && echo "RESHADE_DEPTH_INPUT_IS_REVERSED=1"
    [[ "$n" =~ upside|flipped|y.flip|vertically ]] && echo "RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=1"
    [[ "$n" =~ logarithm ]] && echo "RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=1"
    return 0
}

# SweetFX DB rows of a game page → [{id, name, added, downloads, shader}]
fx_sfx_rows() {
    tr -d '\r' | tr '\n' ' ' \
        | grep -oE '<a href="/games/preset/[0-9]+/">[^<]*</a></td> *<td>[^<]*</td> *<td><a [^>]*>[^<]*</a> *</td> *<td>[0-9]+</td> *<td>[0-9]+</td> *<td><a href="/games/shader/[0-9]+/">[^<]+</a>' \
        | sed -E 's|<a href="/games/preset/([0-9]+)/">([^<]*)</a></td> *<td>([^<]*)</td> *<td><a [^>]*>[^<]*</a> *</td> *<td>[0-9]+</td> *<td>([0-9]+)</td> *<td><a href="/games/shader/[0-9]+/">([^<]+)</a>|\1\t\2\t\3\t\4\t\5|' \
        | jq -Rsc '[split("\n")[] | select(. != "") | split("\t")
                    | {id:.[0], name:(.[1] | gsub("&amp;"; "&") | gsub("&#39;"; "\u0027") | gsub("&quot;"; "\"")),
                       added:.[2], downloads:(.[3] | tonumber), shader:.[4]}]'
}

# the SweetFX DB game whose title matches a name exactly (normalized)
fx_sfx_game() {
    local name="$1" q res
    q="$(jq -rn --arg q "$name" '$q | @uri')"
    res="$(fx_cached "sfx-search-$(fx_norm "$name").json" 604800 "$SFX_URL/games/game/search/?query=$q")"
    jq -c --arg n "$(fx_norm "$name")" '
        def norm: ascii_downcase | gsub("[™®©]"; "") | gsub("[^a-z0-9]+"; "");
        [.Games[]? | select((.title | norm) == $n) | {title, id:(.url | capture("/games/game/(?<i>[0-9]+)/").i)}] | first // empty' <<<"$res" 2>/dev/null
}

# fx scan → every installed Steam game with its best preset, compatibility,
# online risk and current look; also saved for LIBRARY/new-game hints
cmd_fx_scan() {
    local pcgw id name g sfx rows online cur d scan_rows=()
    pcgw="$(fx_pcgw)"; [[ -n "$pcgw" ]] || pcgw="[]"
    while IFS= read -r id && IFS= read -r name && IFS= read -r _ && IFS= read -r _ && IFS= read -r _; do
        sfx="null"; g="$(fx_sfx_game "$name")"
        if [[ -n "$g" ]]; then
            rows="$(fx_cached "sfx-game-$(jq -r .id <<<"$g").html" 86400 "$SFX_URL/games/game/$(jq -r .id <<<"$g")/" | fx_sfx_rows)"
            sfx="$(jq -c --argjson r "${rows:-[]}" '. + {count:($r | map(select(.shader == "ReShade")) | length),
                    best:($r | map(select(.shader == "ReShade")) | sort_by(-.downloads) | first // null)}' <<<"$g")"
        fi
        online="$(fx_online "$id")"
        d="$(fx_key_dir "steam:$id")"; cur="null"; [[ -s "$d/report.json" ]] && cur="$(cat "$d/report.json")"
        local adv; adv="$(fx_advice "steam:$id" "$(cmd_fx_exes "steam:$id" 2>/dev/null || echo '[]')" "${online:-null}" "$cur" 2>/dev/null)"
        scan_rows+=("$(jq -nc --arg id "$id" --arg name "$name" --argjson sfx "$sfx" --argjson online "${online:-null}" \
                 --argjson cur "$cur" --argjson pcgw "$pcgw" --arg n "$(fx_norm "$name")" --argjson links "$(fx_links_json)" \
                 --argjson advice "${adv:-null}" '
            def norm: ascii_downcase | gsub("[™®©]"; "") | gsub("[^a-z0-9]+"; "");
            ([$pcgw[] | select(any(.names[]; norm == $n))] | first // null) as $pc
            | {key:("steam:" + $id), id:$id, name:$name, sfx:$sfx, pcgw:$pc, online:$online, current:$cur, links:($links[("steam:" + $id)] // []), advice:$advice,
               nexus:("https://duckduckgo.com/?q=" + ("site:nexusmods.com \($name) reshade preset" | @uri))}
            | .blocked = (($pc // {}).avoid == true)
            | .eligible = ((.blocked | not) and ((.online // {}).level // "none") != "anticheat" and (($advice // {}).pick // "reshade") != "none")')")
    done < <(steam_games)
    mkdir -p "$FX_CACHE"
    printf '%s\n' "${scan_rows[@]}" | jq -sc '
        map(. + {defines:[]}) ' > "$FX_CACHE/scan.json.tmp"
    # depth definitions from the notes (bash regexes)
    local i n tmp="[]" line
    n="$(jq length "$FX_CACHE/scan.json.tmp")"
    for ((i = 0; i < n; i++)); do
        line="$(jq -c ".[$i]" "$FX_CACHE/scan.json.tmp")"
        line="$(jq -c --argjson d "$(fx_depth_defines "$(jq -r '.pcgw.notes // ""' <<<"$line")" | jq -Rsc 'split("\n") | map(select(. != ""))')" '.defines = $d' <<<"$line")"
        tmp="$(jq -c --argjson l "$line" '. + [$l]' <<<"$tmp")"
    done
    jq -c 'sort_by(.name | ascii_downcase)' <<<"$tmp" > "$FX_CACHE/scan.json"; rm -f "$FX_CACHE/scan.json.tmp"
    cat "$FX_CACHE/scan.json"
}

# add ReShade preprocessor definitions to a game's ReShade.ini (keeps others)
reshade_defines() {   # key def…
    local st ini cur
    st="$(reshade_state "$1")"; [[ -n "$st" ]] || return 0; shift
    (($#)) || return 0
    ini="$(jq -r .dir <<<"$st")/ReShade.ini"; [[ -f "$ini" ]] || return 0
    cur="$(awk -F= '/^\[GENERAL\]/ { g = 1; next } /^\[/ { g = 0 } g && $1 == "PreprocessorDefinitions" { sub(/^[^=]*=/, ""); print }' "$ini" | tr -d '\r')"
    local all d; all="$cur"
    for d in "$@"; do
        [[ ",$all," == *",${d%%=*}="* ]] && continue
        all="${all:+$all,}$d"
    done
    ini_set "$ini" GENERAL PreprocessorDefinitions "$all"
}

# fx autoinstall [key…] — ReShade + the best preset (a quick look when there's
# none) for every eligible game, or just the ones given; anti-cheat games and
# PCGW "avoid" ones are never touched (optional co-op is fine)
cmd_fx_autoinstall() {
    local scan keys=() k row name ok=0 skip=0 fail=0
    scan="$( [[ -s "$FX_CACHE/scan.json" ]] && cat "$FX_CACHE/scan.json" || cmd_fx_scan )"
    if (($#)); then keys=("$@"); else mapfile -t keys < <(jq -r '.[] | select(.eligible) | .key' <<<"$scan"); fi
    ((${#keys[@]})) || { log "Nothing to set up: no single-player game without shaders found."; return 0; }
    [[ -n "$(reshade_version)" && -f "$RESHADE_BIN/d3dcompiler_47.dll.64" ]] || { cmd_reshade_install || return 4; }
    for k in "${keys[@]}"; do
        row="$(jq -c --arg k "$k" '.[] | select(.key == $k)' <<<"$scan")"
        [[ -n "$row" ]] || { err "$k: not in the scan"; fail=$((fail + 1)); continue; }
        name="$(jq -r .name <<<"$row")"
        if [[ "$(jq -r .eligible <<<"$row")" != true ]]; then
            log "✗ $name: skipped ($(jq -r 'if .blocked then "ReShade is banned/blocked there (PCGamingWiki)" else "online game with anti-cheat" end' <<<"$row"))"
            skip=$((skip + 1)); continue
        fi
        log "── $name"
        local pick; pick="$(jq -r '(.advice // {}).pick // "reshade"' <<<"$row")"
        if [[ "$pick" == vkbasalt ]]; then
            if [[ -z "$(pkg_ver vkbasalt)" ]]; then log "  ✗ vkBasalt is the one for this game: install it first (FX → INSTALL)"; skip=$((skip + 1)); continue; fi
            profile_write "$k" '{"fxMode":"vkbasalt"}'
        elif ! cmd_reshade_on "$k" >/dev/null 2>"$FX_CACHE/auto.err"; then
            log "  ✗ ReShade: $(sed 's/^ERROR: //' "$FX_CACHE/auto.err" | head -1)"; fail=$((fail + 1)); continue
        fi
        local look; look="$(jq -r 'if .sfx.best then "sfx:\(.sfx.best.id)" else "builtin:sharpen-aa" end' <<<"$row")"
        cmd_fx_set "$k" "$look" 2>&1 | sed 's/^/  /'
        if [[ "${PIPESTATUS[0]}" == 0 ]]; then ok=$((ok + 1)); else fail=$((fail + 1)); fi
        local defs=(); mapfile -t defs < <(jq -r '.defines[]' <<<"$row")
        ((${#defs[@]})) && reshade_defines "$k" "${defs[@]}" && log "  depth: ${defs[*]}"
    done
    log "✔ $ok set up · $skip skipped · $fail failed"
    ((fail == 0))
}

# --- import a preset downloaded by hand (Nexus Mods…) ----------------------------
# A .ini/.txt, or an archive (zip/7z/rar: bsdtar reads them all). Presets are
# the files with a "Techniques=" line; any shaders/textures the archive brings
# go to Shaders/imported/<name> (a file name we already have is kept, not
# replaced) and Textures. ReShade.ini, DLLs and the like are ignored: the deck
# manages those.
fx_unpack() {   # file → dir with its content (a lone preset is copied in)
    local f="$1" t; t="$(mktemp -d)"
    case "${f,,}" in
        *.ini|*.txt) cp -f -- "$f" "$t/" ;;
        *) bsdtar -xf "$f" -C "$t" 2>/dev/null || { rm -rf "$t"; return 1; } ;;
    esac
    echo "$t"
}
fx_presets_in() {   # dir → preset files (relative), best first: most techniques
    local d="$1" f
    while IFS= read -r -d '' f; do
        [[ "$(basename "${f,,}")" == reshade.ini ]] && continue
        tr -d '\r' < "$f" | grep -qE '^Techniques=[^[:space:]]' || continue
        printf '%s\t%s\n' "$(tr -d '\r' < "$f" | grep -m1 -E '^Techniques=' | tr ',' '\n' | grep -c @)" "${f#"$d"/}"
    done < <(find "$d" -type f \( -iname '*.ini' -o -iname '*.txt' \) -print0)
}

# fx importlist <file> → [{path, effects}]
cmd_fx_importlist() {
    local f="$1" d
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    d="$(fx_unpack "$f")" || { err "couldn't open $(basename "$f") (zip, 7z, rar, .ini or .txt)"; return 4; }
    fx_presets_in "$d" | sort -t$'\t' -k1,1nr | jq -Rsc '[split("\n")[] | select(. != "") | split("\t") | {path:.[1], effects:(.[0] | tonumber)}]'
    rm -rf "$d"
}

# fx import <key> <file> [preset path inside the archive]
cmd_fx_import() {
    local key="$1" f="$2" pick="${3:-}" d list slug sub n=0 g
    [[ "$key" == steam:* || "$key" == umbral:* ]] || { err "only Steam and Umbral games"; return 2; }
    [[ -f "$f" ]] || { err "not found: $f"; return 2; }
    d="$(fx_unpack "$f")" || { err "couldn't open $(basename "$f") (zip, 7z, rar, .ini or .txt)"; return 4; }
    list="$(fx_presets_in "$d" | sort -t$'\t' -k1,1nr | cut -f2)"
    if [[ -z "$list" ]]; then rm -rf "$d"; err "no ReShade preset (a file with Techniques=) in $(basename "$f")"; return 4; fi
    [[ -n "$pick" ]] || pick="$(head -1 <<<"$list")"
    grep -qxF -- "$pick" <<<"$list" || { rm -rf "$d"; err "not a preset in that archive: $pick"; return 2; }
    # shaders and textures it brings
    slug="${f##*/}"; slug="${slug%.*}"; slug="${slug//[^A-Za-z0-9._-]/_}"; slug="${slug:0:60}"
    sub="$FX_DIR/Shaders/imported/$slug"
    while IFS= read -r -d '' g; do
        [[ -n "$(fx_find "$(basename "$g")")" ]] && continue
        mkdir -p "$sub"; cp -n -- "$g" "$sub/"; n=$((n + 1))
    done < <(find "$d" -type f \( -iname '*.fx' -o -iname '*.fxh' \) -print0)
    while IFS= read -r -d '' g; do
        mkdir -p "$FX_DIR/Textures"; cp -n -- "$g" "$FX_DIR/Textures/"
    done < <(find "$d" -type f -ipath '*/textures/*' \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.dds' -o -iname '*.bmp' -o -iname '*.tga' \) -print0)
    ((n)) && log "→ $n shader file(s) from the archive → Shaders/imported/$slug"
    local keep; keep="$(mktemp)"; cp -- "$d/$pick" "$keep"; rm -rf "$d"
    local label="${pick##*/}"; label="${label%.*}"
    FX_IMPORT_NAME="$label" FX_IMPORT_ARCHIVE="${f##*/}" FX_IMPORT_BUNDLED="$n" cmd_fx_set "$key" "file:$keep"; local rc=$?
    rm -f "$keep"
    return $rc
}

# --- saved preset links per game (e.g. a Nexus page to download and IMPORT) ----
# Keyed by Steam app id, so a link can be saved before the game is installed.
FX_LINKS="$GAMING_DIR/fx-links.json"
fx_links_json() { if [[ -s "$FX_LINKS" ]]; then cat "$FX_LINKS"; else echo '{}'; fi; }
# fx link add <key> <https url> [label] | note <key> <url> <text> | rm <key> <url> | get <key>
cmd_fx_link() {
    local sub="$1" key="$2" url="${3:-}" label="${4:-}" tmp
    [[ "$key" =~ ^steam:[0-9]+$ ]] || { err "use: fx link add|rm|get steam:<appid> …"; return 2; }
    case "$sub" in
        get) fx_links_json | jq -c --arg k "$key" '.[$k] // []' ;;
        add)
            [[ "$url" =~ ^https://[^[:space:]\"\'\`]+$ ]] || { err "a https link is needed"; return 2; }
            if [[ -z "$label" && "$url" =~ nexusmods\.com/([a-z0-9]+)/mods/([0-9]+) ]]; then label="Nexus #${BASH_REMATCH[2]}"; fi
            mkdir -p "$GAMING_DIR"; tmp="$(mktemp)"
            fx_links_json | jq --arg k "$key" --arg u "$url" --arg l "${label:-$url}" \
                '.[$k] = ((.[$k] // []) | map(select(.url != $u)) + [{url:$u, label:$l}])' > "$tmp" && mv "$tmp" "$FX_LINKS"
            log "✔ Saved for $(game_label "$key"): ${label:-$url}" ;;
        note)
            [[ -n "$url" ]] || { err "use: fx link note <key> <url> <text>"; return 2; }
            fx_links_json | jq -e --arg k "$key" --arg u "$url" '(.[$k] // []) | any(.url == $u)' >/dev/null \
                || { err "that link isn't saved for $key"; return 2; }
            mkdir -p "$GAMING_DIR"; tmp="$(mktemp)"
            fx_links_json | jq --arg k "$key" --arg u "$url" --arg n "$label" \
                '.[$k] |= map(if .url == $u then .notes = $n else . end)' > "$tmp" && mv "$tmp" "$FX_LINKS"
            log "✔ Notes saved." ;;
        rm)
            mkdir -p "$GAMING_DIR"; tmp="$(mktemp)"
            fx_links_json | jq --arg k "$key" --arg u "$url" '.[$k] = ((.[$k] // []) | map(select(.url != $u))) | with_entries(select(.value | length > 0))' \
                > "$tmp" && mv "$tmp" "$FX_LINKS"
            log "✔ Removed." ;;
        *) err "use: fx link add|rm|get steam:<appid> …"; return 2 ;;
    esac
}

# fx review <key> | sfx:<preset id> — what a preset does and what may make it look worse
cmd_fx_review() {
    local w="$1" f d
    case "$w" in
        sfx:*) [[ "${w#sfx:}" =~ ^[0-9]+$ ]] || { err "bad preset id"; return 2; }
               f="$FX_CACHE/sfx-preset-${w#sfx:}.ini"
               fx_cached "sfx-preset-${w#sfx:}.ini" 2592000 "$SFX_URL/games/preset/${w#sfx:}/download/" >/dev/null
               [[ -s "$f" ]] && tr -d '\r' < "$f" | grep -qE '^Techniques=' || { err "couldn't read that preset"; return 4; } ;;
        *)     valid_game_key "$w" || { err "use: fx review <key> | sfx:<id>"; return 2; }
               d="$(fx_key_dir "$w")"; f="$d/preset.orig.ini"; [[ -s "$f" ]] || f="$d/preset.ini"
               [[ -s "$f" ]] || { err "no imported/downloaded preset on this game"; return 3; } ;;
    esac
    fx_review "$f"
}

# fx reviews <sfx game id> — a short review of the game's most downloaded presets
# (the list shows first; each preset file is downloaded once, cached 30 days)
cmd_fx_reviews() {
    local g="$1" id r out="{}"
    [[ "$g" =~ ^[0-9]+$ ]] || { err "use: fx reviews <sfx game id>"; return 2; }
    while IFS= read -r id; do
        # no Techniques= line: SweetFX or ReShade 1/2 era, can't be applied
        r="$(cmd_fx_review "sfx:$id" 2>/dev/null)" || { out="$(jq -c --arg i "$id" '. + {($i): {verdict:"old", effects:0, flags:[]}}' <<<"$out")"; continue; }
        out="$(jq -c --arg i "$id" --argjson r "$r" '. + {($i): {verdict:$r.verdict, effects:($r.effects | length), flags:[$r.flags[] | {t, tone, why}]}}' <<<"$out")"
    done < <(cmd_fx_presets "$g" 2>/dev/null | jq -r 'sort_by(-.downloads) | .[0:10][] | .id')
    echo "$out"
}

# fx toggle <key> <effect file> on|off — switch one effect of the game's preset
# (the downloaded/imported one is kept as preset.orig.ini; applies at the next launch)
fx_reapply_without() {   # key disabled-json
    local key="$1" dis="$2" d orig prev tmp rc
    d="$(fx_key_dir "$key")"; orig="$d/preset.orig.ini"
    [[ -s "$orig" ]] || cp -- "$d/preset.ini" "$orig"
    prev="$(cat "$d/report.json")"
    tmp="$(mktemp)"
    tr -d '\r' < "$orig" | jq -Rr --argjson dis "$dis" '
        if test("^(Techniques|TechniqueSorting)=") then
            (split("=")[0]) as $k | ((. | sub("^[^=]*="; "")) | split(",") | map(select((split("@")[1] // "") as $f | ($dis | index($f)) | not)) | join(",")) as $v
            | $k + "=" + $v
        else . end' > "$tmp"
    FX_TOGGLING=1 FX_IMPORT_NAME="$(jq -r .name <<<"$prev")" cmd_fx_set "$key" "file:$tmp" >/dev/null; rc=$?
    rm -f "$tmp"
    (( rc == 0 )) || return $rc
    printf '%s\n' "$dis" > "$d/disabled.json"
    # keep where the look came from (an SFX preset stays one), and what's off
    jq -c --argjson p "$prev" --argjson dis "$dis" \
        '. + ($p | {source, name, id, url, sfxGame, archive, bundled, importedAt} | with_entries(select(.value != null))) + {disabled:$dis}' \
        "$d/report.json" > "$d/report.json.new" && mv "$d/report.json.new" "$d/report.json"
}
cmd_fx_toggle() {
    local key="$1" file="$2" st="$3" d dis
    valid_game_key "$key" && [[ "$file" =~ ^[^/]+\.fx$ && "$st" =~ ^(on|off)$ ]] || { err "use: fx toggle <key> <file.fx> on|off"; return 2; }
    d="$(fx_key_dir "$key")"
    [[ -s "$d/preset.ini" || -s "$d/preset.orig.ini" ]] || { err "only a downloaded or imported preset has effects to switch"; return 3; }
    dis="$(jq -c '.' "$d/disabled.json" 2>/dev/null || echo '[]')"
    dis="$(jq -c --arg f "$file" --arg s "$st" 'if $s == "off" then (. + [$f] | unique) else map(select(. != $f)) end' <<<"$dis")"
    fx_reapply_without "$key" "$dis" || return $?
    log "✔ ${file%.fx} $([[ "$st" == off ]] && echo off || echo on) in $(game_label "$key") — applies the next time the game starts"
}
# fx lighter <key> — switch off what the review flags (extra sharpeners, gamma tools, film effects)
cmd_fx_lighter() {
    local key="$1" d dis r
    valid_game_key "$key" || { err "use: fx lighter <key>"; return 2; }
    d="$(fx_key_dir "$key")"
    r="$(cmd_fx_review "$key")" || return $?
    dis="$(jq -c --argjson s "$(jq -c .suggestOff <<<"$r")" '. + $s | unique' "$d/disabled.json" 2>/dev/null || jq -c .suggestOff <<<"$r")"
    [[ "$dis" != "[]" ]] || { log "Nothing flagged to switch off in this preset."; return 0; }
    fx_reapply_without "$key" "$dis" || return $?
    log "✔ Lighter: $(jq -r 'map(sub("\\.fx$"; "")) | join(", ")' <<<"$dis") off in $(game_label "$key") — applies the next time the game starts"
}

cmd_fx() {
    local sub="$1"; shift 2>/dev/null
    case "$sub" in
        status)   cmd_fx_status "$@" ;;
        install)  cmd_fx_install ;;
        packages) fx_packages ;;
        package)  [[ -n "${1:-}" ]] || { err "use: fx package <idx>"; return 2; }; fx_install_pkg "$1" ;;
        search)   cmd_fx_search "$*" ;;
        presets)  cmd_fx_presets "${1:-}" ;;
        set)      FX_SFX_GAME="${3:-}" cmd_fx_set "${1:-}" "${2:-}" ;;
        importlist) cmd_fx_importlist "${1:-}" ;;
        link)     cmd_fx_link "$@" ;;
        import)   cmd_fx_import "${1:-}" "${2:-}" "${3:-}" ;;
        mode)     cmd_fx_mode "${1:-}" "${2:-}" "${3:-}" "${4:-}" ;;
        exes)     cmd_fx_exes "${1:-}" ;;
        key)      cmd_fx_key "${1:-}" ;;
        screenshots) local f k; for f in "$FX_PROFILES"/*/reshade.json; do
                         [[ -f "$f" ]] || continue
                         k="$(jq -r '.key // empty' "$f")"; [[ -n "$k" ]] || { k="$(basename "$(dirname "$f")")"; k="${k/_/:}"; }
                         [[ -f "$(jq -r .dir "$f")/ReShade.ini" ]] && reshade_set_shots "$k" "$(jq -r .dir "$f")/ReShade.ini" \
                             && log "→ $(game_label "$k"): screenshots to $(reshade_shots_dir "$k" | sed "s|^$HOME|~|")"
                     done ;;
        effectskey) cmd_fx_effectskey "${1:-}" ;;
        shotkey)  cmd_fx_shotkey "${1:-}" ;;
        review)   cmd_fx_review "${1:-}" ;;
        reviews)  cmd_fx_reviews "${1:-}" ;;
        toggle)   cmd_fx_toggle "${1:-}" "${2:-}" "${3:-}" ;;
        lighter)  cmd_fx_lighter "${1:-}" ;;
        scan)     if [[ "${1:-}" == --cached ]]; then
                      if [[ -s "$FX_CACHE/scan.json" ]]; then cat "$FX_CACHE/scan.json"; else echo '[]'; fi
                  else cmd_fx_scan; fi ;;
        autoinstall) cmd_fx_autoinstall "$@" ;;
        reshade)  case "${1:-}" in
                      install) cmd_reshade_install ;;
                      off)     cmd_reshade_off "${2:-}" ;;
                      *) err "use: fx reshade install | off <key>"; return 2 ;;
                  esac ;;
        *) err "use: fx status [key] | install | packages | package <idx> | search <name> | presets <id> | set <key> <look> | mode <key> reshade|vkbasalt | exes <key> | key <name> | scan | autoinstall [key…] | reshade install|off"; return 2 ;;
    esac
}

# --- STATUS: live system / GPU / display / tools info (polled every few s) ------
gs_system() {
    local mi st ops mhz
    mi="$(cat "${PROCFS}/meminfo" 2>/dev/null)"
    mhz="$(awk -F: '/^cpu MHz/ { s += $2; n++ } END { if (n) printf "%d", s / n }' "${PROCFS}/cpuinfo" 2>/dev/null)"
    st="$(cat "$SYSFS/kernel/sched_ext/state" 2>/dev/null)"; ops="$(cat "$SYSFS/kernel/sched_ext/root/ops" 2>/dev/null)"
    jq -nc --arg kernel "$(uname -r)" \
        --arg cpu "$(awk -F': ' '/^model name/ { print $2; exit }' "${PROCFS}/cpuinfo" 2>/dev/null)" \
        --argjson threads "$(nproc 2>/dev/null || echo 0)" --arg mhz "$mhz" \
        --arg temp "$(hwmon_temp coretemp 'Package id 0' || hwmon_temp 'k10temp|zenpower' 'Tctl|Tdie' || true)" \
        --arg load "$(cut -d' ' -f1 "${PROCFS}/loadavg" 2>/dev/null)" \
        --arg memTotal "$(awk '/^MemTotal:/ { print $2 * 1024 }' <<<"$mi")" \
        --arg memAvail "$(awk '/^MemAvailable:/ { print $2 * 1024 }' <<<"$mi")" \
        --arg swapTotal "$(awk '/^SwapTotal:/ { print $2 * 1024 }' <<<"$mi")" \
        --arg swapFree "$(awk '/^SwapFree:/ { print $2 * 1024 }' <<<"$mi")" \
        --argjson zram "$(swapon --show=NAME --noheadings 2>/dev/null | grep -q zram && echo true || echo false)" \
        --arg scx "$st" --arg scxOps "$ops" \
        --argjson scxLoader "$(systemctl is-active --quiet scx_loader 2>/dev/null && echo true || echo false)" '
        def n: (tonumber? // null);
        {kernel:$kernel, cpu:$cpu, threads:$threads, mhz:($mhz | n), temp:($temp | n), load:($load | n),
         memTotal:($memTotal | n), memUsed:((($memTotal | n) // 0) - (($memAvail | n) // 0)),
         swapTotal:($swapTotal | n), swapUsed:((($swapTotal | n) // 0) - (($swapFree | n) // 0)), zram:$zram,
         scx:{state:(if $scx == "" then null else $scx end), ops:(if $scxOps == "" then null else $scxOps end), loader:$scxLoader}}'
}

# NVIDIA clock-event reasons (NVML bitmask) → words
nv_reasons() {
    local v=$(( ${1:-0} )) why=()
    (( v & 0x1 ))   && why+=("idle")
    (( v & 0x2 ))   && why+=("app clocks")
    (( v & 0x4 ))   && why+=("power cap")
    (( v & 0x8 ))   && why+=("hw slowdown")
    (( v & 0x10 ))  && why+=("sync boost")
    (( v & 0x20 ))  && why+=("thermal (sw)")
    (( v & 0x40 ))  && why+=("thermal (hw)")
    (( v & 0x80 ))  && why+=("power brake")
    (( v & 0x100 )) && why+=("display clock")
    printf '%s\n' "${why[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))'
}

gs_gpu() {
    local v; v="$(gpu_vendor)"
    case "$v" in
        nvidia)
            local q; q="$(nvidia-smi --query-gpu=name,driver_version,memory.used,memory.total,temperature.gpu,power.draw,power.limit,clocks.gr,clocks.max.gr,utilization.gpu,pstate,clocks_throttle_reasons.active --format=csv,noheader,nounits 2>/dev/null | head -1)"
            [[ -n "$q" ]] || { jq -nc --arg v "$v" --arg n "$(gpu_name)" '{vendor:$v, name:$n}'; return; }
            IFS=',' read -r name drv mu mt t pw pl clk clkmax util ps thr <<<"$q"
            jq -nc --arg name "${name# }" --arg drv "${drv# }" --arg mu "${mu# }" --arg mt "${mt# }" --arg t "${t# }" \
                --arg pw "${pw# }" --arg pl "${pl# }" --arg clk "${clk# }" --arg clkmax "${clkmax# }" --arg util "${util# }" \
                --arg ps "${ps# }" --argjson why "$(nv_reasons "${thr# }")" '
                def n: (tonumber? // null);
                {vendor:"nvidia", name:$name, driver:("NVIDIA " + $drv), vramUsed:(($mu | n) // 0) * 1048576, vramTotal:(($mt | n) // 0) * 1048576,
                 temp:($t | n), power:($pw | n), powerLimit:($pl | n), clock:($clk | n), clockMax:($clkmax | n),
                 load:($util | n), pstate:$ps, limits:$why}' ;;
        amd)
            local dev h
            dev="$(amd_gpu_dev)"
            h="$(ls -d "$dev"/hwmon/hwmon* 2>/dev/null | head -1)"
            jq -nc --arg name "$(gpu_name)" --arg mesa "$(pkg_ver mesa)" \
                --arg busy "$(cat "$dev/gpu_busy_percent" 2>/dev/null)" \
                --arg mu "$(cat "$dev/mem_info_vram_used" 2>/dev/null)" --arg mt "$(cat "$dev/mem_info_vram_total" 2>/dev/null)" \
                --arg t "$(amd_gpu_temp || true)" \
                --arg pw "$(cat "$h/power1_average" 2>/dev/null || cat "$h/power1_input" 2>/dev/null)" \
                --arg pl "$(cat "$h/power1_cap" 2>/dev/null)" --arg clk "$(cat "$h/freq1_input" 2>/dev/null)" '
                def n: (tonumber? // null);
                {vendor:"amd", name:$name, driver:("amdgpu · Mesa " + ($mesa | sub("-[^-]*$"; "") | sub("^[0-9]+:"; ""))),
                 vramUsed:($mu | n), vramTotal:($mt | n), temp:($t | n),
                 power:(if ($pw | n) then ($pw | n) / 1000000 else null end), powerLimit:(if ($pl | n) then ($pl | n) / 1000000 else null end),
                 clock:(if ($clk | n) then (($clk | n) / 1000000 | floor) else null end), clockMax:null, load:($busy | n), pstate:null, limits:[]}' ;;
        *) jq -nc --arg v "$v" --arg n "$(gpu_name)" '{vendor:$v, name:$n}' ;;
    esac
}

gs_displays() {
    have hyprctl || { echo '[]'; return; }
    local m; m="$(hypr monitors -j 2>/dev/null | jq -c '[.[] | {name, width, height, hz:(.refreshRate * 100 | round / 100), vrr, focused}]' 2>/dev/null)"
    echo "${m:-[]}"     # no answer (no Hyprland) → no JSON from jq: still valid
}

# versions change rarely: cached for a day
gs_tools() {
    local f="$FX_CACHE/tools.json"; mkdir -p "$FX_CACHE"
    if [[ ! -s "$f" ]] || (( $(date +%s) - $(stat -c %Y "$f") > 86400 )); then
        # from pacman's db: running the tools would start Vulkan (gamescope), which
        # also writes driver shader caches
        jq -nc --arg gm "$(pkg_ver gamemode)" --arg mh "$(pkg_ver mangohud)" --arg gs "$(pkg_ver gamescope)" \
            'def v: sub("-[^-]*$"; "") | sub("^[0-9]+:"; "");
             {gamemode:($gm | v), mangohud:($mh | v), gamescope:($gs | v)}' > "$f"
    fi
    jq -c --argjson steam "$(steam_running && echo true || echo false)" --argjson ntsync "$([[ -e "$NTSYNC_DEV" ]] && echo true || echo false)" \
        --arg rs "$(reshade_version | sed 's/^ReShade-//')" --arg vkb "$(pkg_ver vkbasalt)" \
        --argjson protons "$(cmd_compattools 2>/dev/null | jq length 2>/dev/null || echo 0)" \
        '. + {steam:$steam, ntsync:$ntsync, reshade:$rs, vkbasalt:$vkb, protons:$protons}' "$f"
}

# a running game's details: uptime, Proton build, shaders in use
gs_running_detail() {   # key pid → JSON
    local key="$1" pid="$2" id="${1#*:}" up proton="" fx="" p env
    up="$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')"
    if [[ "$key" == umbral:* ]]; then
        proton="$(umbral_running_file 2>/dev/null | jq -r --arg k "$key" '.[] | select(.key == $k) | .proton // empty' 2>/dev/null)"
    elif [[ "$key" == steam:* ]]; then
        for p in "${PROC_ROOT:-/proc}"/[0-9]*; do
            grep -qa "waitforexitandrun" "$p/cmdline" 2>/dev/null || continue
            grep -qa "SteamAppId=$id" "$p/environ" 2>/dev/null || continue
            proton="$(tr '\0' '\n' < "$p/cmdline" | grep -m1 -E '/proton$' | xargs -r -d '\n' dirname | xargs -r -d '\n' basename)"
            [[ -n "$proton" ]] && break
        done
    fi
    env="$(tr '\0' '\n' < "${PROC_ROOT:-/proc}/$pid/environ" 2>/dev/null)"
    grep -qx 'ENABLE_VKBASALT=1' <<<"$env" && fx="vkBasalt"
    grep -qE '^WINEDLLOVERRIDES=.*d3dcompiler_47=n;(dxgi|d3d9|opengl32)=n,b' <<<"$env" && fx="ReShade"
    jq -nc --arg up "$up" --arg proton "$proton" --arg fx "$fx" \
        '{uptime:($up | tonumber? // null), proton:(if $proton == "" then null else $proton end), fx:(if $fx == "" then null else $fx end)}'
}

# STATUS → library & storage. Disks are live; the rest (du of caches and
# prefixes, HEALTH, the games list) is cached for 10 minutes.
gs_library() {
    local f="$FX_CACHE/status-library.json" disks
    mkdir -p "$FX_CACHE"
    disks="$({ steam_libs; echo "$HOME"; } | while IFS= read -r d; do
                 [[ -d "$d" ]] && df -B1 --output=target,size,avail "$d" 2>/dev/null | tail -1
             done | awk '!seen[$1]++ { print $1 "\t" $2 "\t" $3 }' \
             | jq -Rsc '[split("\n")[] | select(. != "") | split("\t") | {mount:.[0], size:(.[1] | tonumber), free:(.[2] | tonumber)}]')"
    if [[ ! -s "$f" ]] || (( $(date +%s) - $(stat -c %Y "$f") > 600 )); then
        local games lc recent=() id name lp pt sc pf hl
        games="$(cmd_games 2>/dev/null)"; [[ -n "$games" ]] || games="[]"
        lc="$(steam_localconfig)"
        while IFS=$'\t' read -r id name; do
            [[ -n "$id" && -f "$lc" ]] || continue
            lp="$(vdf_get "$lc" "$LOCALCONFIG_APPS/$id" LastPlayed)"; pt="$(vdf_get "$lc" "$LOCALCONFIG_APPS/$id" Playtime)"
            [[ "$lp" =~ ^[0-9]+$ ]] && recent+=("$(jq -nc --arg n "$name" --argjson lp "$lp" --argjson pt "${pt:-0}" '{name:$n, last:$lp, minutes:$pt, source:"steam"}')")
        done < <(jq -r '.[] | select(.source == "steam") | [.id, .name] | @tsv' <<<"$games")
        while IFS=$'\t' read -r name lp pt; do
            [[ -n "$lp" ]] || continue
            recent+=("$(jq -nc --arg n "$name" --arg lp "$lp" --argjson pt "${pt:-0}" \
                '{name:$n, last:(($lp | sub("\\.[0-9]+"; "") | strptime("%Y-%m-%dT%H:%M:%S") | mktime) // null), minutes:(($pt / 60) | floor), source:"umbral"}' 2>/dev/null)")
        done < <(jq -r '.[] | select(.source == "umbral" and (.lastPlayed // "") != "") | [.name, .lastPlayed, (.playtime // 0 | tostring)] | @tsv' <<<"$games")
        sc="$(cmd_shadercache 2>/dev/null | jq -c '{total:(([.games[].total] + [.global[].size]) | add // 0), stale:(.staleBytes // 0), orphan:(.orphanBytes // 0)}')"
        pf="$(cmd_prefixes 2>/dev/null | jq -c '{total:([.prefixes[].size] | add // 0), count:(.prefixes | length), orphans:([.prefixes[] | select(.orphan)] | length)}')"
        hl="$(HEALTH_QUICK=1 cmd_health 2>/dev/null | jq -c '{fail, warn}')"
        jq -nc --argjson g "$games" --argjson recent "$(printf '%s\n' "${recent[@]}" | jq -sc 'map(select(. != null and .last != null)) | sort_by(-.last) | .[0:4]')" \
            --argjson sc "${sc:-null}" --argjson pf "${pf:-null}" --argjson hl "${hl:-null}" \
            --argjson fx "$(ls -d "$FX_PROFILES"/*/report.json 2>/dev/null | wc -l)" \
            --arg drv "$(last_driver_update 2>/dev/null)" --arg drvPkgs "$(driver_pkgs 2>/dev/null | cut -d' ' -f1 | paste -sd ' ')" '
            {games:{steam:([$g[] | select(.source == "steam")] | length), umbral:([$g[] | select(.source == "umbral")] | length),
                    wrapped:([$g[] | select(.wrapped)] | length), fx:$fx},
             recent:$recent, shaders:$sc, prefixes:$pf, health:$hl,
             driverUpdate:($drv | tonumber? // null), driverPkgs:$drvPkgs}' > "$f.tmp" && mv "$f.tmp" "$f"
    fi
    jq -c --argjson disks "$disks" '. + {disks:$disks}' "$f"
}

# --- GE-Proton: offered in UPDATES when a GE build is installed ------------------
# Releases of GloriousEggroll/proton-ge-custom: <tag>-x86_64.tar.gz (older ones:
# <tag>.tar.gz) plus its .sha512sum; unpacks to one folder in Steam's
# compatibilitytools.d. Old builds stay: CLEAN → Unused Proton versions.
GE_REPO="GloriousEggroll/proton-ge-custom"

ge_installed() {   # newest GE-Proton folder name in Steam's compatibilitytools.d
    local d; for d in "$(steam_root)"/compatibilitytools.d/GE-Proton*/; do [[ -d "$d" ]] && basename "$d"; done | sort -V | tail -1
}
ge_latest_json() {   # cached 6 h
    local f="$FX_CACHE/ge-latest.json"; mkdir -p "$FX_CACHE"
    if [[ -s "$f" ]] && (( $(date +%s) - $(stat -c %Y "$f") < 21600 )); then cat "$f"; return; fi
    local j; j="$(gh_api "repos/$GE_REPO/releases/latest" 2>/dev/null)" && jq -e .tag_name <<<"$j" >/dev/null 2>&1 \
        && { printf '%s' "$j" > "$f"; printf '%s' "$j"; return; }
    [[ -s "$f" ]] && cat "$f"
}

upd_proton() {
    local cur tag
    cur="$(ge_installed)"; [[ -n "$cur" ]] || return 0      # only for people who use GE
    tag="$(ge_latest_json | jq -r '.tag_name // empty')"; [[ -n "$tag" ]] || return 0
    [[ -d "$(steam_root)/compatibilitytools.d/$tag-x86_64" || -d "$(steam_root)/compatibilitytools.d/$tag" ]] && return 0
    printf '%s\n' proton "$tag" "GE-Proton" "${cur%-x86_64}" "$tag"
}

# proton install [tag] — latest when no tag
# proton status — GE-Proton here and the latest release: {installed, latest, update}
cmd_proton_status() {
    local cur tag
    cur="$(ge_installed)"; tag="$(ge_latest_json | jq -r '.tag_name // empty')"
    jq -nc --arg c "${cur%-x86_64}" --arg l "$tag" --argjson u "$([[ -n "$(upd_proton)" ]] && echo true || echo false)" \
        '{installed:(if $c == "" then null else $c end), latest:(if $l == "" then null else $l end), update:$u}'
}
cmd_proton_install() {
    local tag="${1:-}" rel asset sum dir tmp top
    if [[ -n "$tag" ]]; then
        [[ "$tag" =~ ^GE-Proton[0-9A-Za-z._-]+$ ]] || { err "not a GE-Proton tag: $tag"; return 2; }
        rel="$(gh_api "repos/$GE_REPO/releases/tags/$tag")" || { err "release $tag not found"; return 4; }
    else rel="$(ge_latest_json)"; tag="$(jq -r .tag_name <<<"$rel")"; fi
    asset="$(jq -r --arg t "$tag" '.assets[] | select(.name == ($t + "-x86_64.tar.gz") or .name == ($t + ".tar.gz")) | .browser_download_url' <<<"$rel" | head -1)"
    sum="$(jq -r --arg t "$tag" '.assets[] | select(.name == ($t + "-x86_64.sha512sum") or .name == ($t + ".sha512sum")) | .browser_download_url' <<<"$rel" | head -1)"
    [[ -n "$asset" && -n "$sum" ]] || { err "no x86_64 build or checksum in $tag"; return 4; }
    dir="$(steam_root)/compatibilitytools.d"; mkdir -p "$dir"
    tmp="$(mktemp -d)"
    log "→ downloading $tag ($(jq -r --arg u "$asset" '.assets[] | select(.browser_download_url == $u) | .size' <<<"$rel" | numfmt --to=iec 2>/dev/null)B)"
    curl -fsSL --max-time 1800 -o "$tmp/${asset##*/}" "$asset" && curl -fsSL --max-time 60 -o "$tmp/sum" "$sum" \
        || { rm -rf "$tmp"; err "download failed"; return 4; }
    ( cd "$tmp" && sha512sum -c --status sum ) || { rm -rf "$tmp"; err "checksum mismatch: not installed"; return 4; }
    log "→ SHA-512 verified"
    top="$(bsdtar -tzf "$tmp/${asset##*/}" 2>/dev/null | head -1 | cut -d/ -f1)"
    [[ "$top" == GE-Proton* ]] || { rm -rf "$tmp"; err "unexpected archive layout"; return 4; }
    [[ -e "$dir/$top" ]] && { rm -rf "$tmp"; log "✔ $top is already installed."; return 0; }
    bsdtar -xzf "$tmp/${asset##*/}" -C "$dir" || { rm -rf "${dir:?}/${top:?}" "$tmp"; err "extract failed"; return 4; }
    rm -rf "$tmp"
    rm -f "$FX_CACHE/tools.json"
    history_add "proton install" steam "$top" 0
    log "✔ $top installed in ${dir/#$HOME/\~}. Restart Steam to see it; pick it per game in LIBRARY → PROTON."
    log "  Older GE builds no game uses show up in SYSTEM → CLEAN → Unused Proton versions."
}

# --- CPU scheduler (sched-ext via scx_loader) ------------------------------------
# scxctl talks to scx_loader over D-Bus; polkit (org.scx.loader.manage-schedulers,
# auth_admin_keep) asks for the password. The boot default lives in
# /etc/scx_loader.toml (default_sched = "scx_<name>", default_mode = "<Mode>").
SCHED_SETTINGS="$GAMING_DIR/sched.json"
SCX_TOML="${GAMING_DECK_SCX_TOML:-/etc/scx_loader.toml}"
SCX_POLKIT_RULE="${GAMING_DECK_SCX_RULE:-/etc/polkit-1/rules.d/49-gaming-deck-scx.rules}"
# the same rule as Control Deck wrote it (before the split): still counts, and NO PASSWORD off removes it too
SCX_POLKIT_RULE_OLD="${GAMING_DECK_SCX_RULE_OLD:-/etc/polkit-1/rules.d/49-control-deck-scx.rules}"
sched_setting() { jq -r --arg k "$1" '.[$k] // empty' "$SCHED_SETTINGS" 2>/dev/null; }
sched_running() { [[ "$(cat "$SYSFS/kernel/sched_ext/state" 2>/dev/null)" == enabled ]]; }

cmd_sched_status() {
    local ops def mode
    ops="$(cat "$SYSFS/kernel/sched_ext/root/ops" 2>/dev/null)"
    def="$(awk -F'"' '/^[[:space:]]*default_sched[[:space:]]*=/ { print $2 }' "$SCX_TOML" /etc/scx_loader/config.toml 2>/dev/null | head -1)"
    mode="$(awk -F'"' '/^[[:space:]]*default_mode[[:space:]]*=/ { print $2 }' "$SCX_TOML" /etc/scx_loader/config.toml 2>/dev/null | head -1)"
    jq -nc --argjson have "$(have scxctl && echo true || echo false)" \
        --argjson loader "$(systemctl is-active --quiet scx_loader 2>/dev/null && echo true || echo false)" \
        --argjson running "$(sched_running && echo true || echo false)" --arg ops "$ops" \
        --arg def "$def" --arg mode "$mode" --arg playing "$(sched_setting whilePlaying)" \
        --argjson rule "$([[ -f "$SCX_POLKIT_RULE" || -f "$SCX_POLKIT_RULE_OLD" ]] && echo true || echo false)" \
        '{scxctl:$have, loader:$loader, running:$running, current:(if $ops == "" then null else ($ops | sub("_[0-9].*$"; "")) end),
          bootDefault:(if $def == "" then null else ($def | sub("^scx_"; "")) end), bootMode:(if $mode == "" then null else $mode end),
          whilePlaying:(if $playing == "" then null else $playing end), noPassword:$rule}'
}

# sched start <name> [mode] | stop | playing <name:mode|off> | boot <name|none> [mode] | nopassword on|off
cmd_sched() {
    local sub="${1:-}"; shift 2>/dev/null
    have scxctl || { err "scxctl isn't installed (scx-tools)"; return 4; }
    case "$sub" in
        status) cmd_sched_status ;;
        start)
            local s="${1:-lavd}" m="${2:-gaming}"
            [[ "$s" =~ ^[a-z0-9_]+$ && "$m" =~ ^[a-z]+$ ]] || { err "bad scheduler or mode"; return 2; }
            if sched_running; then scxctl switch --sched "$s" --mode "$m" || { err "scxctl switch failed (cancelled?)"; return 4; }
            else scxctl start --sched "$s" --mode "$m" || { err "scxctl start failed (cancelled?)"; return 4; }; fi
            log "✔ scx_$s running in $m mode." ;;
        stop)
            sched_running || { log "No sched-ext scheduler is running."; return 0; }
            scxctl stop || { err "scxctl stop failed (cancelled?)"; return 4; }
            log "✔ Back to the kernel's default scheduler." ;;
        playing)
            local v="${1:-}"; mkdir -p "$GAMING_DIR"
            [[ "$v" == off || "$v" =~ ^[a-z0-9_]+:[a-z]+$ ]] || { err "use: sched playing <name:mode|off>"; return 2; }
            jq -n --arg v "$([[ "$v" == off ]] || echo "$v")" '{whilePlaying:$v}' > "$SCHED_SETTINGS"
            if [[ "$v" == off ]]; then log "✔ While playing: the scheduler is left alone."
            else log "✔ While playing: scx_${v%%:*} (${v#*:} mode), stopped when the game ends."; fi ;;
        boot)
            local s="${1:-}" m="${2:-Gaming}"
            [[ "$s" == none || "$s" =~ ^[a-z0-9_]+$ ]] && [[ "$m" =~ ^[A-Za-z]+$ ]] || { err "use: sched boot <name|none> [Mode]"; return 2; }
            log "→ pkexec: default scheduler in $SCX_TOML"
            # shellcheck disable=SC2016
            pkexec sh -c 'f="$1"; s="$2"; m="$3"; touch "$f"
                sed -i "/^[[:space:]]*#\{0,1\}[[:space:]]*default_sched[[:space:]]*=/d; /^[[:space:]]*#\{0,1\}[[:space:]]*default_mode[[:space:]]*=/d" "$f"
                if [ "$s" != none ]; then printf "default_sched = \"scx_%s\"\ndefault_mode = \"%s\"\n" "$s" "$m" | cat - "$f" > "$f.new" && mv "$f.new" "$f"; fi' \
                sh "$SCX_TOML" "$s" "$m" || { err "couldn't write $SCX_TOML"; return 4; }
            log "✔ At boot: ${s/none/kernel default}${s:+ }$([[ "$s" != none ]] && echo "($m)")" ;;
        nopassword)
            case "${1:-}" in
                on)
                    log "→ pkexec: polkit rule so $(id -un) can switch schedulers without a password"
                    # shellcheck disable=SC2016
                    pkexec sh -c 'printf "%s\n" "// Gaming Deck: let $2 switch sched-ext schedulers (scxctl) without a password" \
                        "polkit.addRule(function (action, subject) {" \
                        "    if (action.id == \"org.scx.loader.manage-schedulers\" && subject.user == \"$2\" && subject.local && subject.active)" \
                        "        return polkit.Result.YES;" "});" > "$1" && chmod 644 "$1"' sh "$SCX_POLKIT_RULE" "$(id -un)" \
                        || { err "couldn't write the polkit rule"; return 4; }
                    log "✔ No password needed to switch schedulers." ;;
                off)
                    [[ -f "$SCX_POLKIT_RULE" || -f "$SCX_POLKIT_RULE_OLD" ]] || { log "No rule installed."; return 0; }
                    pkexec rm -f "$SCX_POLKIT_RULE" "$SCX_POLKIT_RULE_OLD" || { err "couldn't remove the rule"; return 4; }
                    log "✔ Rule removed: switching schedulers asks for the password again." ;;
                *) err "use: sched nopassword on|off"; return 2 ;;
            esac ;;
        *) err "use: sched status | start <name> [mode] | stop | playing <name:mode|off> | boot <name|none> [Mode] | nopassword on|off"; return 2 ;;
    esac
}

# --- while playing: quiet notifications, a lighter Hyprland ---------------------
# playing.json {quiet, lite}. Both apply when the first game starts and are
# undone when the last one ends; only what the deck changed is undone.
PLAYING_SETTINGS="$GAMING_DIR/playing.json"
playing_on() { [[ "$(jq -r --arg k "$1" '.[$k] == true' "$PLAYING_SETTINGS" 2>/dev/null)" == true ]]; }
notifier() {   # the notification daemon that can be paused: dunst | swaync | ""
    if have dunstctl && dunstctl is-paused >/dev/null 2>&1; then echo dunst
    elif have swaync-client && swaync-client -D >/dev/null 2>&1; then echo swaync; fi
}
# hyprctl from a game launched by Steam: find the instance if the env lacks it
hypr() {
    if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        local s; s="$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null | head -1)"
        [[ -n "$s" ]] && export HYPRLAND_INSTANCE_SIGNATURE="$s"
    fi
    hyprctl "$@"
}
hypr_ok() { have hyprctl && hypr version >/dev/null 2>&1; }
LITE_OPTIONS=(animations:enabled decoration:blur:enabled decoration:shadow:enabled)
quiet_begin() {   # pause notifications (they wait and show when the game ends)
    local n; n="$(notifier)"
    case "$n" in
        dunst)  [[ "$(dunstctl is-paused)" == false ]] && dunstctl set-paused true && echo dunst > "$1" ;;
        swaync) [[ "$(swaync-client -D)" == false ]] && swaync-client -dn >/dev/null && echo swaync > "$1" ;;
    esac
}
quiet_end() {
    case "$(cat "$1")" in
        dunst)  dunstctl set-paused false ;;
        swaync) swaync-client -df >/dev/null ;;
    esac
}
# set a Hyprland option: Lua config (0.55+, `eval`), else the legacy `keyword`
hypr_set() {   # a:b:c true|false
    local o lua="$2" k; IFS=: read -ra o <<<"$1"
    for (( k = ${#o[@]} - 1; k >= 1; k-- )); do lua="{ ${o[k]} = $lua }"; done
    [[ "$(hypr eval "hl.config({ ${o[0]} = $lua })" 2>/dev/null)" == ok ]] && return 0
    [[ "$(hypr keyword "$1" "$([[ "$2" == true ]] && echo 1 || echo 0)" 2>/dev/null)" == ok ]]
}
lite_begin() {   # animations, blur and shadows off; the ones we turned off are kept to restore
    hypr_ok || return 0
    local o v off=()
    for o in "${LITE_OPTIONS[@]}"; do
        v="$(hypr getoption -j "$o" 2>/dev/null | jq -r 'if has("bool") then .bool elif has("int") then (.int != 0) else empty end' 2>/dev/null)"
        [[ "$v" == true ]] && hypr_set "$o" false && off+=("$o")
    done
    (( ${#off[@]} )) && printf '%s\n' "${off[@]}" > "$1"
    return 0
}
lite_end() {
    local o
    while IFS= read -r o; do [[ -n "$o" ]] && hypr_set "$o" true; done < "$1"
}

# --- game session: things that start with a game and end with it ---------------
# The first game starts them, the last one to end undoes them (a marker per game
# pid; markers of dead pids are dropped). The scheduler only if none runs yet:
# we stop what we started.
session_begin() {   # key pid
    local d="$STATE_DIR/sessions" want f
    mkdir -p "$d"
    for f in "$d"/[0-9]*; do [[ -e "$f" && ! -d "${PROC_ROOT:-/proc}/${f##*/}" ]] && rm -f "$f"; done
    if ! compgen -G "$d/[0-9]*" >/dev/null; then
        want="$(sched_setting whilePlaying)"
        if [[ -n "$want" ]] && have scxctl && ! sched_running; then
            scxctl start --sched "${want%%:*}" --mode "${want#*:}" >/dev/null 2>&1 && touch "$d/sched-owner"
        fi
        playing_on quiet && [[ ! -f "$d/quiet-owner" ]] && quiet_begin "$d/quiet-owner"
        playing_on lite && [[ ! -f "$d/lite-owner" ]] && lite_begin "$d/lite-owner"
    fi
    echo "$1" > "$d/$2"
}
session_end() {   # pid
    local d="$STATE_DIR/sessions" f
    rm -f "$d/$1"
    for f in "$d"/[0-9]*; do [[ -e "$f" && ! -d "${PROC_ROOT:-/proc}/${f##*/}" ]] && rm -f "$f"; done
    compgen -G "$d/[0-9]*" >/dev/null && return 0     # another game still running
    if [[ -f "$d/sched-owner" ]]; then rm -f "$d/sched-owner"; scxctl stop >/dev/null 2>&1 || true; fi
    if [[ -f "$d/quiet-owner" ]]; then quiet_end "$d/quiet-owner"; rm -f "$d/quiet-owner"; fi
    if [[ -f "$d/lite-owner" ]]; then lite_end "$d/lite-owner"; rm -f "$d/lite-owner"; fi
    return 0
}

# playing — status · playing quiet|lite on|off
cmd_playing() {
    case "${1:-}" in
        "")
            jq -nc --argjson q "$(playing_on quiet && echo true || echo false)" --argjson l "$(playing_on lite && echo true || echo false)" \
                --arg n "$(notifier)" --argjson h "$(hypr_ok && echo true || echo false)" \
                '{quiet:$q, lite:$l, notifier:$n, hyprland:$h}' ;;
        quiet|lite)
            [[ "${2:-}" == on || "${2:-}" == off ]] || { err "use: playing quiet|lite on|off"; return 2; }
            mkdir -p "$GAMING_DIR"
            local cur; cur="$(jq -c 'objects' "$PLAYING_SETTINGS" 2>/dev/null)"; [[ -n "$cur" ]] || cur='{}'
            jq -n --argjson c "$cur" --arg k "$1" --argjson v "$([[ "$2" == on ]] && echo true || echo false)" \
                '$c + {($k): $v}' > "$PLAYING_SETTINGS" || { err "couldn't save $PLAYING_SETTINGS"; return 4; }
            case "$1:$2" in
                quiet:on)  log "✔ While playing: notifications wait until the game ends." ;;
                quiet:off) log "✔ While playing: notifications show as usual." ;;
                lite:on)   log "✔ While playing: Hyprland animations, blur and shadows off." ;;
                lite:off)  log "✔ While playing: Hyprland left as it is." ;;
            esac ;;
        *) err "use: playing [quiet|lite on|off]"; return 2 ;;
    esac
}

# session <pid> <key> — for launchers that start the game themselves (Umbral):
# overlay if the profile asks, scheduler while playing, cleaned up at exit
cmd_session() {
    local pid="$1" key="$2"
    [[ "$pid" =~ ^[0-9]+$ ]] && valid_game_key "$key" || { err "use: session <pid> <key>"; return 2; }
    [[ "$(profile_get "$key" | jq -r .overlay)" == true ]] && cmd_overlay "$pid"
    session_begin "$key" "$pid"
    panel_autostart
    local rec t0; t0="$(date +%s)"; rec="$(session_record_start "$key" "$pid")"
    ( while [[ -d "${PROC_ROOT:-/proc}/$pid" ]]; do sleep 5; done
      session_end "$pid"; session_record_end "$key" "$rec" "$t0" ) </dev/null >/dev/null 2>&1 &
    disown
}

# a game that ended with an error: notify, with its Proton log when there is one
game_crashed() {   # key rc started(epoch)
    local key="$1" rc="$2" t0="$3" name log="" id="${1#steam:}"
    name="$(steam_games | awk -v i="$id" 'NR % 5 == 1 { x = $0 } NR % 5 == 2 && x == i { print; exit }')"
    [[ -f "$HOME/steam-$id.log" && "$(stat -c %Y "$HOME/steam-$id.log")" -ge "$t0" ]] && log="$HOME/steam-$id.log"
    notify "${name:-$key} closed with an error ✗" \
        "Exit code $rc. $([[ -n "$log" ]] && echo "Proton log: ${log/#$HOME/\~}" || echo "For a log next time, add PROTON_LOG=1 to its ENV (LIBRARY).")"
    history_add "game crashed" gaming "${name:-$key} (code $rc)" "$rc"
}

# --- profile check for this PC (after moving profiles between PCs) ---------------
# Vendor-only variables (same classes as the ProtonDB suggestions) that do
# nothing on this GPU, and shaders that aren't set up on this PC yet.
env_vendor() {   # VAR → nvidia|amd|mesa|""
    case "$1" in
        __GL_*|__NV*|PROTON_ENABLE_NVAPI|DXVK_ENABLE_NVAPI|PROTON_ENABLE_NGX*|DXVK_NVAPI*|PROTON_DLSS_*) echo nvidia ;;
        RADV_*|AMD_*|ACO_*|RADEONSI*|PROTON_FSR4_*|PROTON_USE_OPTISCALER|PROTON_OPTISCALER_*) echo amd ;;
        MESA_*|ENABLE_LAYER_MESA*) echo mesa ;;
        *) echo "" ;;
    esac
}

cmd_gaudit() {
    local v; v="$(gpu_vendor)"
    local k var issues=()
    while IFS= read -r k; do
        [[ -n "$k" && "$k" != default ]] || continue
        local p; p="$(profile_get "$k")"
        while IFS= read -r var; do
            [[ -n "$var" ]] || continue
            local ven; ven="$(env_vendor "$var")"
            [[ -z "$ven" ]] && continue
            if [[ "$ven" == nvidia && "$v" != nvidia ]] || [[ "$ven" == amd && "$v" != amd ]] || [[ "$ven" == mesa && "$v" == nvidia ]]; then
                issues+=("$(jq -nc --arg k "$k" --arg var "$var" --arg ven "$ven" --arg val "$(jq -r --arg x "$var" '.env[$x]' <<<"$p")" \
                    '{key:$k, kind:"env", var:$var, value:$val, vendor:$ven, fix:"remove"}')")
            fi
        done < <(jq -r '.env | keys[]' <<<"$p")
        if [[ "$(jq -r .fx <<<"$p")" == true ]]; then
            if [[ "$(jq -r '.fxMode // "vkbasalt"' <<<"$p")" == reshade ]]; then
                local st ok=false; st="$(reshade_state "$k")"
                if [[ -n "$st" ]]; then
                    local l; l="$(jq -r '.dir + "/" + .api + ".dll"' <<<"$st")"
                    [[ -L "$l" && -e "$l" ]] && ok=true
                fi
                [[ $ok == true ]] || issues+=("$(jq -nc --arg k "$k" '{key:$k, kind:"reshade", fix:"setup"}')")
            elif [[ -z "$(pkg_ver vkbasalt)" ]]; then
                issues+=("$(jq -nc --arg k "$k" '{key:$k, kind:"vkbasalt", fix:"install"}')")
            fi
        fi
    done < <(profiles_json | jq -r 'keys[]')
    # Umbral games: the variables set on the game (Battle.net: on its prefix, which --set edits)
    local val
    while IFS=$'\x1f' read -r k var val; do
        [[ -n "$var" ]] || continue
        local ven; ven="$(env_vendor "$var")"
        [[ -z "$ven" ]] && continue
        if [[ "$ven" == nvidia && "$v" != nvidia ]] || [[ "$ven" == amd && "$v" != amd ]] || [[ "$ven" == mesa && "$v" == nvidia ]]; then
            issues+=("$(jq -nc --arg k "$k" --arg var "$var" --arg ven "$ven" --arg val "$val" \
                '{key:$k, kind:"env", var:$var, value:$val, vendor:$ven, fix:"remove", umbral:true}')")
        fi
    done < <(umbral_json | jq -r '(.prefixes // []) as $px | .games[]? | select(.hidden != true) | . as $g
        | (if .kind == "battlenet" then (($px | map(select(.id == $g.prefix_id)) | first // {}).options.env // {}) else (.options.env // {}) end)
        | to_entries[] | ["umbral:" + $g.id, .key, (.value | tostring)] | join("\u001f")' 2>/dev/null)
    # shader files a game's look needs that this PC doesn't have (looks travel in BACKUP, shaders don't)
    local rf pk pkgs=""
    for rf in "$FX_PROFILES"/*/report.json; do
        [[ -f "$rf" ]] || continue
        k="$(basename "$(dirname "$rf")")"; k="${k/_/:}"
        while IFS= read -r var; do
            [[ "$var" == *.fx && -z "$(fx_find "$var")" ]] || continue
            [[ -n "$pkgs" ]] || pkgs="$(fx_packages 2>/dev/null)"
            pk="$(jq -c --arg f "$var" '[.[] | select(.files | index($f))] | first // null | if . then {idx, name} else null end' <<<"${pkgs:-[]}")"
            issues+=("$(jq -nc --arg k "$k" --arg f "$var" --argjson p "${pk:-null}" \
                '{key:$k, kind:"shader", file:$f, pack:$p, fix:(if $p then "install" else "none" end)}')")
        done < <(jq -r '.effects[]?' "$rf")
    done
    # GameMode on in a profile but not installed here: the wrapper just skips it
    if ! gamemode_installed; then
        while IFS= read -r k; do
            [[ -n "$k" ]] && issues+=("$(jq -nc --arg k "$k" '{key:$k, kind:"gamemode", fix:"install"}')")
        done < <(profiles_json | jq -r 'to_entries[] | select(.key != "default" and .value.gamemode == true) | .key')
    fi
    printf '%s\n' "${issues[@]}" | jq -sc --arg v "$v" '{vendor:$v, issues:map(select(. != null))}'
}

# gaudit fix <key|all> — drop the other vendor's variables, set ReShade up here again
cmd_gaudit_fix() {
    local which="$1" a keys k n=0
    a="$(cmd_gaudit)"
    if [[ "$which" == all ]]; then keys="$(jq -r '[.issues[].key] | unique[]' <<<"$a")"
    else valid_game_key "$which" || { err "not a game key: $which"; return 2; }; keys="$which"; fi
    while IFS= read -r k; do
        [[ -n "$k" ]] || continue
        local drop; drop="$(jq -c --arg k "$k" '[.issues[] | select(.key == $k and .kind == "env") | .var]' <<<"$a")"
        if [[ "$drop" != "[]" && "$k" == umbral:* ]]; then
            local -a unset_args=(); mapfile -t unset_args < <(jq -r '.[] | "env." + . + "="' <<<"$drop")
            if cmd_uset "$k" "${unset_args[@]}" >/dev/null; then
                log "→ $(game_label "$k"): removed $(jq -r 'join(", ")' <<<"$drop") in Umbral (no effect on this $(jq -r .vendor <<<"$a") GPU)"; n=$((n + 1))
            else log "✗ $(game_label "$k"): Umbral couldn't remove $(jq -r 'join(", ")' <<<"$drop") (Umbral 0.12+ needed)"; fi
        elif [[ "$drop" != "[]" ]]; then
            local tmp; tmp="$(mktemp)"
            profiles_json | jq --arg k "$k" --argjson d "$drop" '.[$k].env |= (. // {} | with_entries(select(.key as $x | $d | index($x) | not)))' > "$tmp" \
                && mv "$tmp" "$PROFILES"
            log "→ $(game_label "$k"): removed $(jq -r 'join(", ")' <<<"$drop") (no effect on this $(jq -r .vendor <<<"$a") GPU)"; n=$((n + 1))
        fi
        if jq -e --arg k "$k" 'any(.issues[]; .key == $k and .kind == "reshade")' <<<"$a" >/dev/null; then
            cmd_fx_mode "$k" reshade >/dev/null 2>&1 && log "→ $(game_label "$k"): ReShade set up on this PC" || log "✗ $(game_label "$k"): ReShade couldn't be set up here (see FX)"
            n=$((n + 1))
        fi
        local pk
        while IFS= read -r pk; do
            [[ -n "$pk" ]] || continue
            fx_install_pkg "$pk" >/dev/null 2>&1 && log "→ $(game_label "$k"): shaders installed ($pk)" || log "✗ $(game_label "$k"): couldn't install shader pack $pk"
            n=$((n + 1))
        done < <(jq -r --arg k "$k" '[.issues[] | select(.key == $k and .kind == "shader" and .pack != null) | .pack.idx] | unique[]' <<<"$a")
        jq -r --arg k "$k" '.issues[] | select(.key == $k and .kind == "shader" and .pack == null) | .file' <<<"$a" \
            | while IFS= read -r f; do log "  $(game_label "$k"): $f isn't in any known pack — import the preset's own archive again"; done
        jq -e --arg k "$k" 'any(.issues[]; .key == $k and .kind == "vkbasalt")' <<<"$a" >/dev/null \
            && log "  $(game_label "$k"): vkBasalt isn't installed here — FX → INSTALL"
    done <<<"$keys"
    if jq -e --arg w "$which" 'any(.issues[]; .kind == "gamemode" and ($w == "all" or .key == $w))' <<<"$a" >/dev/null; then
        log "→ pkexec: installing GameMode (gamemode, lib32-gamemode)"
        if pk_pacman -S --needed --noconfirm -- gamemode lib32-gamemode; then log "✔ GameMode installed"; n=$((n + 1))
        else log "✗ GameMode couldn't be installed (cancelled?)"; fi
    fi
    log "✔ $n change(s)."
}

# --- upscaler upgrades (GE-Proton / Proton-CachyOS) -----------------------------
# Their `proton` reads PROTON_FSR4_UPGRADE (amdxcffx64.dll 4.x: a game's FSR 3.1
# DX12 runs as FSR 4 — RDNA4; GE also has PROTON_FSR4_RDNA3_UPGRADE),
# PROTON_DLSS_UPGRADE (newest nvngx_dlss*) and PROTON_XESS_UPGRADE (newest
# libxess*), downloading the DLLs from the proton-upscalers manifest. Only DLLs a
# game ships can be swapped: FSR 2/3.0 built into the .exe can't.
compat_tool_dir() {   # internal tool name → folder with its `proton`
    local r f
    for r in "$(steam_root)/compatibilitytools.d" "$HOME/.steam/root/compatibilitytools.d" /usr/share/steam/compatibilitytools.d; do
        for f in "$r"/*/compatibilitytool.vdf; do
            [[ -f "$f" ]] || continue
            [[ "$(compat_tool_name "$f")" == "$1" ]] && { dirname "$f"; return 0; }
        done
    done
    return 1
}

# upscale <steam:id> → what the game ships, what this GPU/Proton allow, what's on
cmd_upscale() {
    local key="$1" id dir cfg tool tdir="" vars="" gen name p
    [[ "$key" == steam:* ]] || { err "use: upscale steam:<appid>"; return 2; }
    id="${key#steam:}"; dir="$(steam_game_dir "$id")"
    cfg="$(steam_root)/config/config.vdf"
    tool="$( [[ -f "$cfg" ]] && vdf_get "$cfg" "$COMPAT_MAPPING/$id" name)"
    [[ -z "$tool" && -f "$cfg" ]] && tool="$(vdf_get "$cfg" "$COMPAT_MAPPING/0" name)"
    [[ -n "$tool" ]] && tdir="$(compat_tool_dir "$tool")"
    [[ -n "$tdir" && -f "$tdir/proton" ]] && vars="$(grep -oE 'PROTON_(FSR4_UPGRADE|FSR4_RDNA3_UPGRADE|DLSS_UPGRADE|XESS_UPGRADE|FSR4_INDICATOR|DLSS_INDICATOR|USE_OPTISCALER)' "$tdir/proton" | sort -u | paste -sd ' ')"
    name="$(gpu_name)"; gen="$(jq -rn --arg g "$name" "$JQ_GPU_GEN"' $g | gpu_gen')"
    p="$(profile_get "$key")"
    jq -nc --arg tool "$tool" --arg vars "$vars" --arg gpu "$name" --arg gen "$gen" --arg vendor "$(gpu_vendor)" \
        --argjson env "$(jq -c '.env // {}' <<<"$p")" --argjson online "$(fx_online "$id" 2>/dev/null || echo null)" \
        --argjson ships "$(
            # any of the names given (FidelityFX SDK 1: amd_fidelityfx_dx12.dll; SDK 2, FSR 3.1.4+:
            # amd_fidelityfx_upscaler_dx12.dll + amd_fidelityfx_loader_dx12.dll — KCD2 ships these)
            f() { [[ -d "$dir" ]] || { echo false; return; }
                  local n a=(); for n in "$@"; do a+=(-o -iname "$n"); done
                  find "$dir" -maxdepth 6 -type f \( "${a[@]:1}" \) 2>/dev/null | head -1 | grep -q . && echo true || echo false; }
            jq -nc --argjson fsrdx "$(f amd_fidelityfx_dx12.dll amd_fidelityfx_upscaler_dx12.dll amd_fidelityfx_loader_dx12.dll)" \
                   --argjson fsrvk "$(f amd_fidelityfx_vk.dll amd_fidelityfx_upscaler_vk.dll amd_fidelityfx_loader_vk.dll)" \
                   --argjson dlss "$(f 'nvngx_dlss*.dll')" --argjson xess "$(f 'libxess*.dll')" --argjson fsr2 "$(f 'ffx_fsr2_api*.dll')" \
                   '{fsr31dx12:$fsrdx, fsr31vk:$fsrvk, dlss:$dlss, xess:$xess, fsr2:$fsr2}')" '
        ($vars | split(" ")) as $v
        | ($gpu | ascii_downcase | test("rtx")) as $rtx
        | {proton:{tool:(if $tool == "" then null else $tool end),
                   supports:($v | map(select(endswith("_UPGRADE")) | sub("^PROTON_"; "") | sub("_UPGRADE$"; "") | ascii_downcase))},
           gpu:{name:$gpu, vendor:$vendor, gen:$gen}, ships:$ships}
        | .options = [
            {id:"fsr4", var:"PROTON_FSR4_UPGRADE", label:"FSR 4",
             why:(if (.ships.fsr31dx12 | not) and .ships.fsr31vk then "The game ships FSR 3.1 for Vulkan; the FSR 4 upgrade is DirectX 12 only."
                  elif (.ships.fsr31dx12 | not) then "The game doesn'"'"'t ship FSR 3.1 as a DLL (FSR 2/3.0 inside the .exe can'"'"'t be swapped)."
                  elif $vendor != "amd" then "FSR 4 runs on AMD Radeon RX 9000 (RDNA4) — not on this GPU."
                  elif ($gen == "amd:4") and ($v | index("PROTON_FSR4_RDNA3_UPGRADE") | not) then "RX 7000 (RDNA3) needs GE-Proton'"'"'s RDNA3 variant."
                  elif ($gen != "amd:5" and $gen != "amd:4") then "FSR 4 needs a Radeon RX 9000 (RDNA4) or RX 7000 with GE-Proton."
                  elif ($v | index("PROTON_FSR4_UPGRADE") | not) then "This game'"'"'s Proton can'"'"'t do it: pick GE-Proton or Proton-CachyOS in PROTON."
                  else null end)},
            {id:"optifsr4", var:"PROTON_USE_OPTISCALER", label:"FSR 4 via OptiScaler",
             why:(if (.ships | (.dlss or .xess or .fsr31dx12 or .fsr31vk or .fsr2) | not) then "OptiScaler needs the game to offer DLSS, XeSS or FSR 2/3.1 to take over — none found."
                  elif $vendor != "amd" or $gen != "amd:5" then "FSR 4 through OptiScaler is offered on Radeon RX 9000 (RDNA4)."
                  elif (($online // {}).level // "none") == "anticheat" then "Online game with anti-cheat: OptiScaler hooks the game, not worth a ban."
                  elif ($v | index("PROTON_USE_OPTISCALER") | not) or ($v | index("PROTON_FSR4_UPGRADE") | not) then "This game'"'"'s Proton can'"'"'t do it: pick GE-Proton or Proton-CachyOS in PROTON."
                  else null end)},
            {id:"dlss", var:"PROTON_DLSS_UPGRADE", label:"DLSS (newest)",
             why:(if (.ships.dlss | not) then "The game doesn'"'"'t ship DLSS."
                  elif ($rtx | not) then "DLSS needs an NVIDIA RTX card."
                  elif ($v | index("PROTON_DLSS_UPGRADE") | not) then "This game'"'"'s Proton can'"'"'t do it: pick GE-Proton or Proton-CachyOS in PROTON."
                  else null end)},
            {id:"xess", var:"PROTON_XESS_UPGRADE", label:"XeSS (newest)",
             why:(if (.ships.xess | not) then "The game doesn'"'"'t ship XeSS."
                  elif ($v | index("PROTON_XESS_UPGRADE") | not) then "This game'"'"'s Proton can'"'"'t do it: pick GE-Proton or Proton-CachyOS in PROTON."
                  else null end)}]
        | .options |= map(. + {available:(.why == null),
                               var:(if .id == "fsr4" and $gen == "amd:4" then "PROTON_FSR4_RDNA3_UPGRADE" else .var end)}
                          # what the chip writes to the profile ENV
                          | . + {set:(if .id == "optifsr4" then
                                        {PROTON_USE_OPTISCALER:"1", PROTON_FSR4_UPGRADE:"1",
                                         PROTON_OPTISCALER_CONFIG:"Upscalers.Dx12Upscaler=fsr31;Upscalers.Dx11Upscaler=fsr31_12;Upscalers.VulkanUpscaler=fsr31_12"}
                                      else {(.var):"1"} end)}
                          | . + {on:($env[.var] == "1")})
        | .preferDirect = ((.options[] | select(.id == "fsr4") | .available) and (.options[] | select(.id == "optifsr4") | .available))
        | .indicators = {fsr4:($v | index("PROTON_FSR4_INDICATOR") != null), dlss:($v | index("PROTON_DLSS_INDICATOR") != null)}'
}

# --- session recording + summary ------------------------------------------------
# While a game runs, one line every 5 s: epoch cpu°C gpu°C gpu-load% gpu-W
# vram-MiB ram-MiB. At the end: a summary (notification + STATUS history).
SESSIONS_DB="$GAMING_DIR/sessions.json"
SESSION_SETTINGS="$GAMING_DIR/session.json"
session_summary_on() { [[ "$(jq -r 'if .summary == false then "off" else "on" end' "$SESSION_SETTINGS" 2>/dev/null)" != off ]]; }

session_sample() {
    local cpu gpu="" load="" pw="" vram="" ram
    cpu="$(hwmon_temp coretemp 'Package id 0' || hwmon_temp 'k10temp|zenpower' 'Tctl|Tdie' || echo "")"
    ram="$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { printf "%d", (t - a) / 1024 }' "${PROCFS}/meminfo" 2>/dev/null)"
    case "$(gpu_vendor)" in
        nvidia)
            IFS=',' read -r gpu load pw vram < <(nvidia-smi --query-gpu=temperature.gpu,utilization.gpu,power.draw,memory.used \
                --format=csv,noheader,nounits 2>/dev/null | head -1) ;;
        amd)
            local dev h
            dev="$(amd_gpu_dev)"
            h="$(ls -d "$dev"/hwmon/hwmon* 2>/dev/null | head -1)"
            gpu="$(amd_gpu_temp || true)"; load="$(cat "$dev/gpu_busy_percent" 2>/dev/null)"
            pw="$(cat "$h/power1_average" 2>/dev/null || cat "$h/power1_input" 2>/dev/null)"; [[ -n "$pw" ]] && pw=$(( pw / 1000000 ))
            vram="$(cat "$dev/mem_info_vram_used" 2>/dev/null)"; [[ -n "$vram" ]] && vram=$(( vram / 1048576 )) ;;
    esac
    gpu="${gpu// /}"; load="${load// /}"; pw="${pw// /}"; vram="${vram// /}"
    printf '%s %s %s %s %s %s %s\n' "$(date +%s)" "${cpu:--}" "${gpu:--}" "${load:--}" "${pw:--}" "${vram:--}" "${ram:--}"
}

# start recording next to <pid>; prints the recording file
session_record_start() {   # key pid
    session_summary_on || return 0
    local d="$STATE_DIR/sessions/rec" f; mkdir -p "$d"
    f="$d/$(date +%s)-${1//[:\/]/_}.tsv"
    ( while [[ -d "${PROC_ROOT:-/proc}/$2" ]]; do session_sample >> "$f"; sleep "${GAMING_DECK_SESSION_EVERY:-5}"; done ) </dev/null >/dev/null 2>&1 &
    disown
    echo "$f"
}

# summarise a recording, keep it in the history, notify
session_record_end() {   # key file started-epoch [name]
    local key="$1" f="$2" t0="$3" name="${4:-}" now dur sum
    [[ -n "$f" && -f "$f" ]] || return 0
    now="$(date +%s)"; dur=$(( now - t0 ))
    if (( dur < ${GAMING_DECK_SESSION_MIN:-60} )); then rm -f "$f"; return 0; fi
    if [[ -z "$name" ]]; then
        case "$key" in
            steam:*)  name="$(steam_games | awk -v i="${key#steam:}" 'NR % 5 == 1 { x = $0 } NR % 5 == 2 && x == i { print; exit }')" ;;
            umbral:*) name="$(umbral_game_name "$key")" ;;
        esac
    fi
    # numbers from awk, JSON from jq (names may hold quotes)
    sum="$(awk '
        function upd(i, v) { if (v == "-" || v == "") return; v += 0; s[i] += v; c[i]++; if (!(i in mx) || v > mx[i]) mx[i] = v }
        { upd(2, $2); upd(3, $3); upd(4, $4); upd(5, $5); upd(6, $6); upd(7, $7)
          if (NR % 6 == 1) g = g (g == "" ? "" : ",") ($3 == "-" ? "null" : $3) }
        END {
          split("cpuTemp gpuTemp gpuLoad gpuPower vram ram", nm, " ")
          printf "{\"samples\":%d", NR
          for (i = 2; i <= 7; i++)
              printf ",\"%sMax\":%s,\"%sAvg\":%s", nm[i-1], (c[i] ? mx[i] : "null"), nm[i-1], (c[i] ? sprintf("%.1f", s[i] / c[i]) : "null")
          printf ",\"gpuTempLine\":[%s]}\n", g
        }' "$f" | jq -c --arg k "$key" --arg n "${name:-$key}" --argjson t0 "$t0" --argjson d "$dur" '. + {key:$k, name:$n, start:$t0, duration:$d}')"
    jq -e . <<<"$sum" >/dev/null 2>&1 || { rm -f "$f"; return 0; }
    mkdir -p "$GAMING_DIR"
    local db; db="$( [[ -s "$SESSIONS_DB" ]] && cat "$SESSIONS_DB" || echo '[]')"
    jq --argjson s "$sum" '([$s] + .) | .[0:50]' <<<"$db" > "$SESSIONS_DB.tmp" && mv "$SESSIONS_DB.tmp" "$SESSIONS_DB"
    rm -f "$f"
    notify "$(jq -r '.name' <<<"$sum") · $(jq -r '.duration | (. / 3600 | floor) as $h | ((. % 3600) / 60 | floor) as $m | if $h > 0 then "\($h) h \($m) min" else "\($m) min" end' <<<"$sum")" \
        "$(jq -r '[(if .gpuTempMax then "GPU \(.gpuTempMax) °C max" else empty end), (if .cpuTempMax then "CPU \(.cpuTempMax) °C max" else empty end),
                    (if .gpuLoadAvg then "GPU load \(.gpuLoadAvg | floor) % avg" else empty end), (if .gpuPowerMax then "\(.gpuPowerMax | floor) W peak" else empty end)]
                   | join(" · ")' <<<"$sum")$(jq -r 'if (.gpuTempMax // 0) >= 85 or (.cpuTempMax // 0) >= 90 then " — ran hot" else "" end' <<<"$sum")"
}

# sessions [N] → last sessions (JSON) · session-summary on|off
cmd_sessions() {
    case "${1:-}" in
        on|off) mkdir -p "$GAMING_DIR"; jq -n --argjson v "$([[ "$1" == on ]] && echo true || echo false)" '{summary:$v}' > "$SESSION_SETTINGS"
                log "✔ Session summary $1." ;;
        *) if [[ -s "$SESSIONS_DB" ]]; then jq -c --argjson n "${1:-10}" '.[0:$n]' "$SESSIONS_DB"; else echo '[]'; fi ;;
    esac
}

# uilang [en|es] — the GUI's language (ESP/ENG in the header); first time: the system's
UI_SETTINGS="$STATE_DIR/ui.json"
cmd_uilang() {
    case "${1:-}" in
        en|es) mkdir -p "$STATE_DIR"; jq -n --arg l "$1" '{lang:$l}' > "$UI_SETTINGS"; echo "$1" ;;
        "") local l; l="$(jq -r '.lang // empty' "$UI_SETTINGS" 2>/dev/null)"
            # the first locale that names a language: games' wrappers often set LC_ALL=C
            if [[ -z "$l" ]]; then
                local v; l=en
                for v in "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
                    case "$v" in ""|C|C.*|POSIX) continue ;; es*) l=es ;; esac; break
                done
            fi
            echo "$l" ;;
        *) err "use: uilang [en|es]"; return 2 ;;
    esac
}

main() {
    local sub="$1"; shift 2>/dev/null
    case "$sub" in
        pickfile)    cmd_pickfile "$1" "${2:-}" "${3:-}" ;;
        proton)      case "${1:-}" in
                         status)  cmd_proton_status ;;
                         install) with_notify "GE-Proton installed ✓" "GE-Proton install failed ✗" "${2:-latest}" cmd_proton_install "${2:-}" ;;
                         *) err "use: proton status | install [tag]"; exit 2 ;;
                     esac ;;
        cleanscan)   cmd_cleanscan ;;
        clean)       need "$1" "missing clean-up id"
                     with_notify "Cleaned ✓" "Clean-up failed ✗" "$1" cmd_clean "$1" ;;
        export)      cmd_export "$1" ;;
        history)     cmd_history ;;
        version)     cmd_version ;;
        selfcheck)   cmd_selfcheck ;;
        migrate)     cmd_migrate ;;
        games)       cmd_games ;;
        gstatus)     cmd_gstatus ;;
        gprofile)    cmd_gprofile "$@" ;;
        run)         cmd_run "$@" ;;
        steamwrap)   cmd_steamwrap "$1" "$2" ;;
        compattools) cmd_compattools ;;
        steamcompat) cmd_steamcompat "$1" "$2" ;;
        protondb)    cmd_protondb "$@" ;;
        gamejoin)    cmd_gamejoin ;;
        pdbindex)    cmd_pdbindex "$@" ;;
        gsuggest)    cmd_gsuggest "$1" ;;
        gtips)       cmd_gtips "$@" ;;
        gseen)       cmd_gseen "$1" ;;
        gplay)       cmd_gplay "$1" ;;
        shadercache) cmd_shadercache ;;
        bench)       cmd_bench "$@" ;;
        prefixes)    cmd_prefixes ;;
        prefix)      cmd_prefix "$@" ;;
        health)      cmd_health ;;
        temps)       cmd_temps "$1" ;;
        hook)        need "$1" "missing game key"; cmd_hook "$1" ;;
        session)     cmd_session "$1" "$2" ;;
        sched)       cmd_sched "$@" ;;
        uilang)      cmd_uilang "${1:-}" ;;
        playing)     cmd_playing "$@" ;;
        gstop)       cmd_gstop "${1:-}" ;;
        mods)        cmd_mods "${1:-}" ;;
        mopen)       cmd_mopen "${1:-}" ;;
        mplay)       cmd_mplay "${1:-}" ;;
        uopts)       cmd_uopts "${1:-}" ;;
        uset)        cmd_uset "$@" ;;
        iosched)     cmd_iosched "${1:-}" ;;
        sessions)    cmd_sessions "${1:-}" ;;
        upscale)     need "$1" "missing game key"; cmd_upscale "$1" ;;
        gaming-import) need "$1" "missing backup file"; cmd_gaming_import "$1" ;;
        gaudit)      if [[ "${1:-}" == fix ]]; then cmd_gaudit_fix "${2:-all}"; else cmd_gaudit; fi ;;
        fx)          cmd_fx "$@" ;;
        overlay)     cmd_overlay "$1" ;;
        ingame)      cmd_ingame ;;
        ach)         cmd_ach "${1:-}" ;;
        wiki)        cmd_wiki "$@" ;;
        guides)      cmd_guides "${1:-}" ;;
        gopen)       cmd_gopen "${1:-}" ;;
        web)         cmd_web "$@" ;;
        notes)       cmd_notes "$@" ;;
        panel)       cmd_panel "$@" ;;
        ovgames)     cmd_ovgames ;;
        shaderclean) with_notify "Shader cache cleaned ✓" "Shader cache clean failed ✗" "$1" cmd_shaderclean "$1" "$2" ;;
        selfupdate)  with_notify "Gaming Deck updated ✓" "Gaming Deck update failed ✗" "gaming-deck" cmd_selfupdate ;;
        ""|-h|--help|help) usage ;;
        *) err "unknown command: $sub"; exit 2 ;;
    esac
}

# run only when executed, not when sourced (tests source it)
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
