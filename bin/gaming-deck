# ===========================================================================
# Self-update — the deck checks GitHub for a newer version of itself.
# install.sh records where it was installed from (repo, branch, commit).
# ===========================================================================
install_info() { [[ -f "$INSTALL_INFO" ]] && sed -n "s/^$1=//p" "$INSTALL_INFO" | head -1; }

cmd_version() {
    local c; c="$(install_info COMMIT)"
    printf 'COMMIT=%s\nSHORT=%s\nREPO=%s\nSRC=%s\nDATE=%s\n' "$c" "${c:0:7}" \
        "$(install_info REPO)" "$(install_info SRC)" "$(install_info DATE)"
}

# pending self-update as an update record (same 5-line format as upd_*)

# selfcheck — a newer Gaming Deck on GitHub: {current, new} ({} when up to date or unknown)
# migrate — bring the game data over from Control Deck (where gaming lived until
# 2026-10): profiles, looks, ReShade, sessions; then fix what pointed at the old
# folder: ReShade.ini paths and DLL links in game folders, vkBasalt configs, and
# Steam's launch options ("…/control-deck run %command%"; Steam must be closed).
# Safe to run again: each step only does what's still left.
cmd_migrate() {
    local old="${GAMING_DECK_OLD_DATA:-$DATA_HOME/control-deck}" new="$STATE_DIR" sub f d l n=0 pending=0
    local oldbin="${GAMING_DECK_OLD_BIN:-$HOME/.local/bin/control-deck}" newbin; newbin="$(gaming_deck_bin)"
    mkdir -p "$new"
    # 1) data (same filesystem: a rename, instant)
    for sub in gaming reshade sessions; do
        [[ -d "$old/$sub" ]] || continue
        if [[ ! -e "$new/$sub" ]]; then
            mv -- "$old/$sub" "$new/$sub" && { log "→ moved $sub/"; n=$((n + 1)); }
            continue
        fi
        # Gaming Deck already ran before migrating: merge, keeping what is newer here
        local merged=0
        for f in "$old/$sub"/* "$old/$sub"/.[!.]*; do
            [[ -e "$f" || -L "$f" ]] || continue
            if [[ ! -e "$new/$sub/${f##*/}" ]]; then
                mv -- "$f" "$new/$sub/" && merged=1
            elif [[ "${f##*/}" == known-games.txt ]]; then
                sort -u -- "$f" "$new/$sub/known-games.txt" > "$new/$sub/.known.tmp" &&
                    mv -- "$new/$sub/.known.tmp" "$new/$sub/known-games.txt" && rm -f -- "$f" && merged=1
            fi
        done
        rmdir -- "$old/$sub" 2>/dev/null
        ((merged)) && { log "→ merged $sub/"; n=$((n + 1)); }
    done
    if [[ -d "$old/logs" ]]; then
        mkdir -p "$new/logs"
        for f in "$old/logs"/run.log "$old/logs"/overlay.log "$old/logs"/vkbasalt-*.log; do
            [[ -f "$f" && ! -e "$new/logs/${f##*/}" ]] && mv -- "$f" "$new/logs/"
        done
    fi
    [[ -f "$old/ui.json" && ! -f "$new/ui.json" ]] && cp -- "$old/ui.json" "$new/ui.json"
    # the game part of the history
    if [[ -f "$old/history.tsv" && ! -f "$HISTORY_FILE" ]]; then
        awk -F'\t' '$3 ~ /^(gaming|steam|umbral|crisol)$/' "$old/history.tsv" > "$HISTORY_FILE"
    fi
    local oldbk="$HOME/control-deck-backups/prefixes"
    if [[ -d "$oldbk" && ! -e "$PREFIX_BACKUPS" ]]; then mkdir -p "${PREFIX_BACKUPS%/*}"; mv -- "$oldbk" "$PREFIX_BACKUPS" && log "→ moved prefix backups"; fi
    # 2) what pointed at the old folder
    local ow nw; ow="$(winpath "$old")"; nw="$(winpath "$new")"
    for f in "$FX_PROFILES"/*/reshade.json; do
        [[ -f "$f" ]] || continue
        d="$(jq -r '.dir // empty' "$f")"; [[ -d "$d" ]] || continue
        if [[ -f "$d/ReShade.ini" ]] && grep -qF "$ow" "$d/ReShade.ini"; then
            cp -p -- "$d/ReShade.ini" "$d/ReShade.ini.gaming-deck.bak"
            O="$ow" N="$nw" awk '{ i = index($0, ENVIRON["O"]); while (i) { $0 = substr($0, 1, i - 1) ENVIRON["N"] substr($0, i + length(ENVIRON["O"])); i = index($0, ENVIRON["O"]) } print }' \
                "$d/ReShade.ini.gaming-deck.bak" > "$d/ReShade.ini"
            log "→ ReShade.ini paths: $(game_label "$(jq -r '.key // empty' "$f")")"; n=$((n + 1))
        fi
        for l in "$d"/*; do
            [[ -L "$l" ]] || continue
            local tgt; tgt="$(readlink "$l")"
            [[ "$tgt" == "$old/"* ]] && ln -sfn -- "$new/${tgt#"$old/"}" "$l" && n=$((n + 1))
        done
    done
    for f in "$FX_PROFILES"/*/vkBasalt.conf; do
        [[ -f "$f" ]] && grep -qF "$old/" "$f" && sed -i "s|$old/|$new/|g" "$f" && n=$((n + 1))
    done
    # 3) Steam launch options
    local lc; lc="$(steam_localconfig)"
    if [[ -f "$lc" ]] && grep -qF "$oldbin run" "$lc"; then
        if steam_running; then
            pending=1; log "⚠ Close Steam and run: gaming-deck migrate — the launch options of your games still call Control Deck"
        else
            cp -p -- "$lc" "$lc.gaming-deck.bak"
            O="$oldbin run" N="$newbin run" awk '{ i = index($0, ENVIRON["O"]); while (i) { $0 = substr($0, 1, i - 1) ENVIRON["N"] substr($0, i + length(ENVIRON["O"])); i = index($0, ENVIRON["O"]) } print }' \
                "$lc.gaming-deck.bak" > "$lc"
            log "→ Steam launch options now call Gaming Deck (backup: ${lc/#$HOME/\~}.gaming-deck.bak)"; n=$((n + 1))
        fi
    fi
    (( n )) && log "✔ Migrated from Control Deck ($n change(s))." || { (( pending )) || log "✔ Nothing to migrate."; }
    (( pending )) && return 3
    return 0
}
cmd_selfcheck() {
    local repo commit branch cmp
    repo="$(install_info REPO)"; commit="$(install_info COMMIT)"; branch="$(install_info BRANCH)"
    [[ -n "$repo" && -n "$commit" ]] || { echo '{}'; return 0; }
    cmp="$(gh_api "repos/$repo/compare/$commit...${branch:-main}" 2>/dev/null)" || { echo '{}'; return 0; }
    # "ahead": GitHub has commits the installed version doesn't
    jq -c --arg c "${commit:0:7}" 'if .status == "ahead" or .status == "diverged"
        then {current:$c, new:"\(.commits | last | .sha[0:7]) (+\(.ahead_by))"} else {} end' <<<"$cmp" 2>/dev/null || echo '{}'
}
cmd_selfupdate() {
    local src repo branch tmp sha
    src="$(install_info SRC)"; repo="$(install_info REPO)"; branch="$(install_info BRANCH)"
    repo="${repo:-madkyp/gaming-deck}"; branch="${branch:-main}"
    if [[ -n "$src" ]] && git -C "$src" rev-parse --git-dir >/dev/null 2>&1; then
        log "→ git pull in $src"
        git -C "$src" pull --ff-only || { err "git pull failed (local changes?): update $src by hand"; return 4; }
        log "→ reinstalling"
        "$src/install.sh" --no-deps || return 4
    else
        # installed from a copy that isn't a git clone: fetch the branch tarball
        sha="$(gh_api "repos/$repo/commits/$branch" | jq -r '.sha // empty')"
        tmp="$(mktemp -d)"
        log "→ downloading $repo@$branch"
        curl -fsSL --max-time 60 "https://codeload.github.com/$repo/tar.gz/refs/heads/$branch" \
            | tar xz -C "$tmp" --strip-components=1 || { err "download failed"; rm -rf "$tmp"; return 4; }
        GAMING_DECK_COMMIT="$sha" GAMING_DECK_REPO="$repo" "$tmp/install.sh" --no-deps || { rm -rf "$tmp"; return 4; }
        rm -rf "$tmp"
    fi
    history_add update deck "gaming-deck $(install_info COMMIT | cut -c1-7)" 0
    log "✔ Gaming Deck updated to $(install_info COMMIT | cut -c1-7). The window reloads by itself."
}

