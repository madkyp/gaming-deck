# --- detectmany / installmany: batch queue ---------------------------------

# --- fetch: download a URL into the cache, prints FILE=<path> ---------------
urldecode() { local s="${1//+/ }"; printf '%b' "${s//%/\\x}"; }

download() {
    local url="$1" name
    name="${url%%[?#]*}"; name="$(urldecode "${name##*/}")"
    [[ -z "$name" ]] && name="download"
    mkdir -p "$DL_DIR"
    log "→ Downloading $name…" >&2
    if curl -fL --retry 2 -sS -o "$DL_DIR/$name.part" "$url"; then
        mv -f "$DL_DIR/$name.part" "$DL_DIR/$name"
        log "→ Downloaded ($(human "$(stat -c %s "$DL_DIR/$name")"))" >&2
        echo "$DL_DIR/$name"
    else
        rm -f "$DL_DIR/$name.part"; err "could not download $url"; return 4
    fi
}

